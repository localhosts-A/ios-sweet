+    if (!ml_get_interrupts_enabled() || ml_at_interrupt_context() || get_preemption_level() != 0)
+        return;
+    if (!os_atomic_cmpxchg(&dali_fastboot_ready, 1u, 0u, acq_rel))
+        return;
+    (void)dali_fb_ufs_probe_return(&dali_fastboot_state, &dali_fastboot_ops);
+#endif
+}
+#endif
diff --git a/bsd/dev/SweetUFSHSG1.h b/bsd/dev/SweetUFSHSG1.h
new file mode 100644
index 0000000000000000000000000000000000000000..f1e2ebb0759e72eba30f8363a4010a848aa1f238
--- /dev/null
+++ b/bsd/dev/SweetUFSHSG1.h
@@ -0,0 +1,70 @@
+/* Private functional integration. Platform helper must adopt an actual retained
+ * AP floor and prove the already-running clock; neither argument nor ADT cap
+ * can substitute for that implementation. No PLL/PMIC/DVFS INIT is done here.
+ */
+static int ufs_dali_hs_platform_adopt(void);
+static int ufs_dali_hs_platform_validate(void);
+
+static int
+ufs_dali_prepare_hsg1(bool requested)
+{
+    if (!requested || !su.dali) return 0;
+    int error = ufs_dali_hs_platform_adopt();
+    if (error) return error;
+    uint64_t span = 0, now = mach_absolute_time();
+    nanoseconds_to_absolutetime(30ull * NSEC_PER_SEC, &span);
+    if (span == 0 || now > UINT64_MAX - span) return ufs_pwm_latch(ETIMEDOUT, false);
+    uint64_t until = now + span;
+    struct sweet_pwm_snapshot before = {0}, after = {0};
+    uint32_t local_max = 0, peer_max = 0, series = 0;
+    error = ufs_pwm_snapshot(&before, until);
+    if (error) return ufs_pwm_failure(error);
+    if ((before.mode != 0x55 && before.mode != 0x22) ||
+        before.rx_gear != 1 || before.tx_gear != 1 ||
+        before.rx_active != 1 || before.tx_active != 1 ||
+        before.rx_term != 0 || before.tx_term != 0) return ENOTSUP;
+    error = ufs_pwm_get(false, 0x1587, &local_max, until); /* PA_MAXRXHSGEAR */
+    if (!error) error = ufs_pwm_get(true, 0x1587, &peer_max, until);
+    if (error) return ufs_pwm_failure(error);
+    printf("SWEET UFS HSG1: before mode=0x%x gear=%u/%u lanes=%u/%u hsmax=%u/%u\n",
+        before.mode, before.rx_gear, before.tx_gear, before.rx_active, before.tx_active,
+        local_max, peer_max);
+    if (local_max == 0 || peer_max == 0) return ENOTSUP;
+    if (local_max > 5 || peer_max > 5) return ufs_pwm_latch(EIO, false);
+    error = ufs_dali_hs_platform_validate();
+    if (error) return error; /* No SET has been submitted. */
+    /* Fixed vendor/core low-gear contract: single lane, HS-G1, rate B,
+     * FASTAUTO (not FAST/G4+, so the optional intermediate PMC is inapplicable),
+     * termination enabled and NO_ADAPT=3. Keep original UniPro timeouts.
+     */
+    const uint32_t attributes[] = {
+        0x15d4, 0x1583, 0x1580, 0x1584, 0x1568, 0x1560, 0x1569, 0x156a,
+        0x15b0, 0x15b1, 0x15b2, 0x15b3, 0x15b4, 0x15b5,
+        0xd041, 0xd042, 0xd043
+    };
+    const uint32_t values[] = {
+        3, 1, 1, 1, 1, 1, 1, 2,
+        8191, 65535, 32767, 8191, 65535, 32767, 8191, 65535, 32767
+    };
+    _Static_assert(sizeof(attributes) == sizeof(values), "HS attribute/value mismatch");
+    for (unsigned int i = 0; i < sizeof(attributes) / sizeof(attributes[0]); ++i) {
+        error = ufs_dali_hs_platform_validate();
+        if (error) return ufs_pwm_failure(error); /* Staged configuration: no fallback. */
+        error = ufs_pwm_set(attributes[i], values[i], until);
+        if (error) return ufs_pwm_failure(error);
+    }
+    error = ufs_dali_hs_platform_validate();
+    if (!error) error = ufs_pwm_pmc(0x44, until); /* Separate async UCCS + UPMS. */
+    if (!error) error = ufs_pwm_snapshot(&after, until);
+    if (!error) error = ufs_pwm_get(false, 0x156a, &series, until);
+    if (error) return ufs_pwm_failure(error);
+    if (after.mode != 0x44 || after.rx_gear != 1 || after.tx_gear != 1 ||
+        after.rx_active != 1 || after.tx_active != 1 || series != 2 ||
+        after.rx_term != 1 || after.tx_term != 1 ||
+        after.rx_connected != before.rx_connected || after.tx_connected != before.tx_connected)
+        return ufs_pwm_latch(EIO, false);
+    error = ufs_dali_hs_platform_validate();
+    if (error) return ufs_pwm_failure(error);
+    printf("SWEET UFS HSG1: verified mode=0x44 gear=1/1 lanes=1/1 series=B readback=1\n");
+    return 0;
+}
diff --git a/bsd/dev/SweetUFSSpeedRead.h b/bsd/dev/SweetUFSSpeedRead.h
new file mode 100644
index 0000000000000000000000000000000000000000..f0499a2555fcf8a2298bfe330cc57d81094861e5
--- /dev/null
+++ b/bsd/dev/SweetUFSSpeedRead.h
@@ -0,0 +1,67 @@
+/* Private integration source. Called with sweet_ufs_lock held, before ready,
+ * device nodes, root mount or any logger/sampler thread. No root WRITE opcode.
+ * Four 1MiB READs per pass; exact byte comparison, not a checksum-only claim.
+ * Command completion/cache/slot/poison semantics remain in ufs_read_blocks.
+ */
+#define DALI_SPEED_BYTES (4u << 20)
+#define DALI_SPEED_BLOCKS (DALI_SPEED_BYTES / UFS_BLOCK)
+
+struct dali_speed_sample {
+    uint64_t bytes, begin, end;
+    unsigned int commands;
+    int error;
+};
+
+static int
+ufs_dali_speed_read_pass(void *reference, size_t reference_bytes, bool compare,
+    uint64_t until, struct dali_speed_sample *sample)
+{
+    if (sample == NULL) return EINVAL;
+    bzero(sample, sizeof(*sample));
+    if (!su.dali || su.ready || su.command_poisoned || !su.capacity_valid ||
+        reference == NULL || reference_bytes != DALI_SPEED_BYTES ||
+        su.nblocks < DALI_SPEED_BLOCKS || su.nblocks > DALI_ROOT_MAX_BLOCKS ||
+        su.first_block > UINT32_MAX ||
+        DALI_SPEED_BLOCKS - 1 > UINT32_MAX - su.first_block ||
+        su.first_block >= su.capacity_blocks ||
+        DALI_SPEED_BLOCKS > su.capacity_blocks - su.first_block) {
+        sample->error = EINVAL;
+        return sample->error;
+    }
+    sample->begin = mach_absolute_time();
+    if (sample->begin >= until) {
+        sample->end = sample->begin;
+        sample->error = ETIMEDOUT;
+        return sample->error;
+    }
+    for (unsigned int offset = 0; offset < DALI_SPEED_BYTES; offset += BOUNCE_SIZE) {
+        uint64_t now = mach_absolute_time();
+        if (now < sample->begin || now >= until) {
+            sample->error = ETIMEDOUT;
+            break;
+        }
+        int error = ufs_read_blocks(su.first_block + offset / UFS_BLOCK,
+            BOUNCE_SIZE / UFS_BLOCK);
+        sample->commands++;
+        if (error) {
+            sample->error = error;
+            break;
+        }
+        const void *bounce = (const void *)(su.dma + DMA_BOUNCE);
+        uint8_t *saved = (uint8_t *)reference + offset;
+        if (compare) {
+            if (memcmp(saved, bounce, BOUNCE_SIZE) != 0) {
+                sample->error = EIO;
+                break;
+            }
+        } else {
+            memcpy(saved, bounce, BOUNCE_SIZE);
+        }
+        sample->bytes += BOUNCE_SIZE;
+    }
+    sample->end = mach_absolute_time();
+    if (sample->end < sample->begin || sample->end >= until) {
+        if (!sample->error) sample->error = ETIMEDOUT;
+    }
+    return sample->error;
+}
diff --git a/bsd/dev/SweetUFSSpeedLog.h b/bsd/dev/SweetUFSSpeedLog.h
new file mode 100644
index 0000000000000000000000000000000000000000..b25b6a92f9f26abec039854b2ac8fa04f36c7011
--- /dev/null
+++ b/bsd/dev/SweetUFSSpeedLog.h
@@ -0,0 +1,36 @@
+/* Only the separate existing log area may be written. No logger thread exists
+ * at this point, and the caller holds its original UFS mutex. A completed and
+ * byte-verified read pass plus an unpoisoned, idle host are prerequisites.
+ * Preserve the production payload -> CACHE SYNC -> header -> CACHE SYNC order.
+ * Only <=256KiB of early console is supported: never silently drop a prefix or
+ * misrepresent a wrapped ring. Unknown/error link must not call this helper.
+ */
+static int
+ufs_dali_speed_save_log(bool verified)
+{
+    if (!verified || !su.dali || su.ready || su.command_poisoned || !su.hsg1_active ||
+        !su.log_partition_configured || !su.log_partition_ready ||
+        su.log_nblocks < SWEET_LOG_BLOCKS) return EPERM;
+    int error = ufs_dali_hs_platform_validate();
+    if (error) return ufs_pwm_failure(error);
+    error = ufs_pwm_idle();
+    if (error || ufs_rd(REG_IS) != 0) return error ? error : EIO;
+    uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+    if (total == 0 || total > (256u << 10)) return EOVERFLOW;
+    uint32_t blocks = (uint32_t)((total + UFS_BLOCK - 1) / UFS_BLOCK);
+    void *bounce = (void *)(su.dma + DMA_BOUNCE);
+    memcpy(bounce, sweet_log_ring, blocks * UFS_BLOCK);
+    error = ufs_write_log_blocks(su.log_first_block + 1, blocks);
+    if (error) return error;
+    error = ufs_sync_cache();
+    if (error) return error;
+    struct sweet_log_header header = {
+        .magic = { 'S', 'W', 'E', 'E', 'T', 'L', 'O', 'G' },
+        .version = 1, .size = SWEET_LOG_SIZE, .total = total, .seq = 1,
+    };
+    bzero(bounce, UFS_BLOCK);
+    memcpy(bounce, &header, sizeof(header));
+    error = ufs_write_log_blocks(su.log_first_block, 1);
+    if (error) return error;
+    return ufs_sync_cache();
+}
diff --git a/bsd/dev/SweetUFSHSFloor.h b/bsd/dev/SweetUFSHSFloor.h
new file mode 100644
index 0000000000000000000000000000000000000000..ba404fa67b6aa817e418495aa992223d288b3cb5
--- /dev/null
+++ b/bsd/dev/SweetUFSHSFloor.h
@@ -0,0 +1,198 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * MT6991 AP minimum VCORE request, not a physical voltage measurement.
+ * The AP SW_REQ field is a retained minimum request, as used by the fixed
+ * vendor DVFSRC regulator. This driver owns its only XNU writer until reboot:
+ * no lowering, DVFS INIT, suspend, force-OPP, PMIC or shared-PLL operation.
+ * Hardware/firmware reset or a changed request/clock is a terminal I/O fault,
+ * not a supported transition. Callers serialize all calls with the UFS mutex.
+ */
+#ifndef SWEET_UFS_HS_FLOOR_H
+#define SWEET_UFS_HS_FLOOR_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+
+#define HSF_REQUEST 0x18u
+#define HSF_TARGET 0x5f0u
+#define HSF_GEAR 0x6acu
+#define HSF_COUNT 0xfcu
+#define HSF_FORCE_REQUEST 0x604u
+#define HSF_HALT 0xc4u
+#define HSF_REQUEST_MASK 0x70u
+#define HSF_OPPS 6u
+#define HSF_MIN_UV 650000u
+#define HSF_WAIT_US 1000u
+
+enum hsf_error {
+    HSF_OK, HSF_ARGUMENT, HSF_STATE, HSF_CLOCK, HSF_READ, HSF_FORCE,
+    HSF_COUNT_ERROR, HSF_TABLE, HSF_REQUEST_ERROR, HSF_RESOURCE,
+    HSF_WRITE, HSF_TIME, HSF_TIMEOUT, HSF_RELEASE, HSF_LOST_FLOOR
+};
+enum hsf_stage {
+    HSF_OFF, HSF_BEGIN, HSF_CAPABILITY, HSF_ACQUIRE, HSF_REQUESTING,
+    HSF_WAITING, HSF_RELEASING, HSF_ACTIVE, HSF_VALIDATING, HSF_FAILED
+};
+struct hsf_ops {
+    int (*read)(void *, uint32_t, uint32_t *);
+    int (*write_request)(void *, uint32_t);
+    int (*smc)(void *, uint32_t command, uint32_t index, uint64_t *a0, uint64_t *a1);
+    int (*clock_ok)(void *);
+    uint64_t (*now_us)(void *);
+    void (*delay_us)(void *, uint32_t);
+};
+struct hsf_state {
+    struct hsf_ops ops;
+    void *context;
+    uint32_t phase, failed_stage, failure;
+    uint32_t request, completed, nominal_uv, calibrated_uv;
+    uint32_t calibrated[HSF_OPPS];
+    uint64_t resource_request_result, resource_release_result;
+    bool resource_requested, wrote_request;
+};
+
+static inline int
+hsf_fail(struct hsf_state *s, unsigned int error)
+{
+    if (s->phase != HSF_FAILED) {
+        s->failed_stage = s->phase;
+        s->failure = error;
+        s->phase = HSF_FAILED;
+    }
+    return (int)s->failure;
+}
+
+static inline int
+hsf_read_health(struct hsf_state *s, uint32_t *request, uint32_t *gear, bool *idle)
+{
+    uint32_t force, halt, target, req, completed;
+    if (s->ops.clock_ok(s->context)) return HSF_CLOCK;
+    if (s->ops.read(s->context, HSF_FORCE_REQUEST, &force) ||
+        s->ops.read(s->context, HSF_HALT, &halt) ||
+        s->ops.read(s->context, HSF_TARGET, &target) ||
+        s->ops.read(s->context, HSF_REQUEST, &req) ||
+        s->ops.read(s->context, HSF_GEAR, &completed)) return HSF_READ;
+    if (force != 0 || (halt & 2u)) return HSF_FORCE;
+    *request = (req >> 4) & 7u;
+    *gear = (completed >> 8) & 7u;
+    *idle = (target & (1u << 16)) == 0;
+    if (*request >= HSF_OPPS || *gear >= HSF_OPPS) return HSF_REQUEST_ERROR;
+    if (s->ops.clock_ok(s->context)) return HSF_CLOCK;
+    return HSF_OK;
+}
+
+static inline int
+hsf_validate(struct hsf_state *s)
+{
+    if (s == NULL) return HSF_ARGUMENT;
+    if (s->phase == HSF_FAILED) return (int)s->failure;
+    if (s->phase != HSF_ACTIVE) return HSF_STATE;
+    s->phase = HSF_VALIDATING;
+    uint32_t request = 0, completed = 0;
+    bool idle = false;
+    int error = hsf_read_health(s, &request, &completed, &idle);
+    if (!error && (!idle || request < s->request || completed < request ||
+        s->calibrated[request] < HSF_MIN_UV)) error = HSF_LOST_FLOOR;
+    if (error) return hsf_fail(s, (unsigned int)error);
+    s->completed = completed;
+    s->phase = HSF_ACTIVE;
+    return HSF_OK;
+}
+
+static inline int
+hsf_acquire(struct hsf_state *s, bool enabled, const struct hsf_ops *ops, void *context)
+{
+    static const uint32_t nominal[HSF_OPPS] = {575000,600000,650000,725000,825000,875000};
+    if (s == NULL) return HSF_ARGUMENT;
+    if (s->phase != HSF_OFF) return s->phase == HSF_FAILED ? (int)s->failure : HSF_STATE;
+    if (!enabled) return HSF_OK; /* No callback, map, SMC or write. */
+    if (ops == NULL || !ops->read || !ops->write_request || !ops->smc ||
+        !ops->clock_ok || !ops->now_us || !ops->delay_us) return hsf_fail(s, HSF_ARGUMENT);
+    s->ops = *ops;
+    s->context = context;
+    s->phase = HSF_BEGIN;
+    int error = s->ops.clock_ok(context);
+    if (error) return hsf_fail(s, HSF_CLOCK);
+    uint32_t count = 0;
+    s->phase = HSF_CAPABILITY;
+    if (s->ops.read(context, HSF_COUNT, &count)) return hsf_fail(s, HSF_READ);
+    if (((count & 7u) + 1u) != HSF_OPPS) return hsf_fail(s, HSF_COUNT_ERROR);
+    for (unsigned int i = 0; i < HSF_OPPS; ++i) {
+        uint64_t a0 = UINT64_MAX, a1 = UINT64_MAX;
+        if (s->ops.smc(context, 4, HSF_OPPS - i - 1u, &a0, &a1) || a0 != 0 ||
+            a1 < 500000 || a1 > 1000000 || (i && a1 < s->calibrated[i-1]))
+            return hsf_fail(s, HSF_TABLE);
+        s->calibrated[i] = (uint32_t)a1;
+    }
+    uint32_t minimum = HSF_OPPS;
+    for (unsigned int i = 0; i < HSF_OPPS; ++i) {
+        if (nominal[i] >= HSF_MIN_UV && s->calibrated[i] >= HSF_MIN_UV) {
+            minimum = i;
+            break;
+        }
+    }
+    if (minimum == HSF_OPPS) return hsf_fail(s, HSF_TABLE);
+    uint32_t request = 0, completed = 0;
+    bool idle = false;
+    error = hsf_read_health(s, &request, &completed, &idle);
+    if (error || !idle) return hsf_fail(s, error ? (unsigned int)error : HSF_LOST_FLOOR);
+    s->request = request > minimum ? request : minimum; /* Never lower an inherited request. */
+    s->nominal_uv = nominal[s->request];
+    s->calibrated_uv = s->calibrated[s->request];
+    s->phase = HSF_ACQUIRE;
+    uint64_t a0 = UINT64_MAX, a1 = UINT64_MAX;
+    int resource_error = s->ops.smc(context, 0x40, 0, &a0, &a1);
+    s->resource_request_result = a0;
+    /* The vendor ignores this command's a0; it is not GET4's status ABI.
+     * Retain the raw result, reject standard SMCCC NOT_SUPPORTED, and pair
+     * every otherwise returned request with one release. Completion is still
+     * proved by the actual AP request/target/gear, never by an opaque a0.
+     */
+    if (resource_error || a0 == UINT64_MAX) return hsf_fail(s, HSF_RESOURCE);
+    s->resource_requested = true;
+    s->phase = HSF_REQUESTING;
+    uint32_t raw = 0;
+    if (s->ops.read(context, HSF_REQUEST, &raw)) error = HSF_READ;
+    if (!error && ((raw >> 4) & 7u) != request) error = HSF_REQUEST_ERROR;
+    if (!error && request < s->request) {
+        uint32_t value = (raw & ~HSF_REQUEST_MASK) | (s->request << 4);
+        s->wrote_request = true; /* Attempt is not a confirmed write. No retry. */
+        if (s->ops.write_request(context, value)) error = HSF_WRITE;
+    }
+    if (!error) {
+        s->phase = HSF_WAITING;
+        s->ops.delay_us(context, 1); /* Fixed vendor request handling. */
+    }
+    uint64_t begin = error ? 0 : s->ops.now_us(context);
+    bool idle_separated = false;
+    for (unsigned int poll = 0; !error && poll <= HSF_WAIT_US; ++poll) {
+        uint64_t now = s->ops.now_us(context);
+        if (now < begin || now - begin > HSF_WAIT_US) { error = HSF_TIME; break; }
+        error = hsf_read_health(s, &request, &completed, &idle);
+        if (error) break;
+        if (request != s->request) { error = HSF_REQUEST_ERROR; break; }
+        if (idle_separated && idle && completed >= s->request) break;
+        if (poll == HSF_WAIT_US) { error = HSF_TIMEOUT; break; }
+        /* Like the vendor, observe idle, then wait 1us before accepting a
+         * completed gear; a later busy observation restarts this separation.
+         */
+        idle_separated = idle;
+        s->ops.delay_us(context, 1);
+    }
+    /* The AP minimum vote stays in SW_REQ. Release only the vendor temporary
+     * memory resource request, exactly as mtk_dvfsrc_send_request does. */
+    uint32_t failed_stage = s->phase;
+    s->phase = HSF_RELEASING;
+    a0 = a1 = UINT64_MAX;
+    int release_error = s->ops.smc(context, 0x41, 0, &a0, &a1);
+    s->resource_release_result = a0;
+    if (!release_error && a0 != UINT64_MAX) s->resource_requested = false;
+    if (!error && (release_error || a0 == UINT64_MAX)) { error = HSF_RELEASE; failed_stage = HSF_RELEASING; }
+    if (error) {
+        s->phase = failed_stage;
+        return hsf_fail(s, (unsigned int)error);
+    }
+    s->completed = completed;
+    s->phase = HSF_ACTIVE;
+    return hsf_validate(s);
+}
+#endif
diff --git a/bsd/dev/SweetUFSHSPlatform.h b/bsd/dev/SweetUFSHSPlatform.h
new file mode 100644
index 0000000000000000000000000000000000000000..0499a71901149989b90a893a9a3c12cf07b0ab88
--- /dev/null
+++ b/bsd/dev/SweetUFSHSPlatform.h
@@ -0,0 +1,175 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * Dali MT6991 standard AP minimum-VCORE request with the existing UFS clock.
+ * Include after su, ufs_rd/ufs_ao_rd and ordinary UIC helpers. No new PLL,
+ * PMIF, PMIC, DVFSRC INIT, clock switch, suspend or downward-voltage operation.
+ */
+#ifndef SWEET_UFS_HS_PLATFORM_H
+#define SWEET_UFS_HS_PLATFORM_H
+#include "SweetUFSHSFloor.h"
+#include "SweetUFSPWMClock.h"
+
+struct dali_hs_clock {
+    struct sweet_pwm_clock_snapshot pll;
+    uint32_t gate0, gate1, refclk;
+};
+static struct {
+    vm_offset_t dvfsrc, top, apmixed;
+    struct dali_hs_clock reference;
+    struct hsf_state floor;
+    bool started;
+    int failure;
+} dali_hs_platform;
+
+static int
+ufs_hs_smc(void *context, uint32_t command, uint32_t index, uint64_t *a0, uint64_t *a1)
+{
+    (void)context;
+    if (a0 == NULL || a1 == NULL ||
+        (command != 4 && command != 0x40 && command != 0x41) ||
+        (command == 4 ? index >= HSF_OPPS : index != 0)) return EINVAL;
+    register uint64_t x0 __asm__("x0") = 0xc2000506u;
+    register uint64_t x1 __asm__("x1") = command;
+    register uint64_t x2 __asm__("x2") = index;
+    register uint64_t x3 __asm__("x3") = 0;
+    register uint64_t x4 __asm__("x4") = 0;
+    register uint64_t x5 __asm__("x5") = 0;
+    register uint64_t x6 __asm__("x6") = 0;
+    register uint64_t x7 __asm__("x7") = 0;
+    __asm__ volatile("dsb sy\n\tsmc #0"
+        : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+        : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory", "cc");
+    *a0 = x0;
+    *a1 = x1;
+    return 0;
+}
+
+static uint32_t
+ufs_hs_reg(vm_offset_t base, uint32_t offset)
+{
+    uint32_t value = *(volatile uint32_t *)(base + offset);
+    __builtin_arm_dsb(0xf);
+    return value;
+}
+
+static int
+ufs_hs_floor_read(void *context, uint32_t offset, uint32_t *out)
+{
+    (void)context;
+    if (!dali_hs_platform.dvfsrc || out == NULL ||
+        (offset != HSF_REQUEST && offset != HSF_TARGET && offset != HSF_GEAR &&
+         offset != HSF_COUNT && offset != HSF_FORCE_REQUEST && offset != HSF_HALT)) return EINVAL;
+    *out = ufs_hs_reg(dali_hs_platform.dvfsrc, offset);
+    return *out == UINT32_MAX ? EIO : 0;
+}
+
+static int
+ufs_hs_floor_write(void *context, uint32_t value)
+{
+    (void)context;
+    /* Only this driver writes the AP request in XNU, under sweet_ufs_lock.
+     * Check a fresh value, preserve every unrelated field, and never lower it.
+     */
+    uint32_t old = 0;
+    int error = ufs_hs_floor_read(NULL, HSF_REQUEST, &old);
+    if (error) return error;
+    if ((old & ~HSF_REQUEST_MASK) != (value & ~HSF_REQUEST_MASK) ||
+        (old & HSF_REQUEST_MASK) > (value & HSF_REQUEST_MASK)) return EIO;
+    *(volatile uint32_t *)(dali_hs_platform.dvfsrc + HSF_REQUEST) = value;
+    __builtin_arm_dsb(0xf);
+    return 0; /* Actual request/level completion is checked by hsf_acquire. */
+}
+
+static int
+ufs_hs_clock_read(struct dali_hs_clock *out)
+{
+    if (!out || !su.dali || !dali_hs_platform.top || !dali_hs_platform.apmixed ||
+        !su.regs || !su.ao_regs) return EIO;
+    out->pll.mux = ufs_hs_reg(dali_hs_platform.top, 0xd0);
+    out->pll.pll_status = ufs_hs_reg(dali_hs_platform.apmixed, 0x3c);
+    out->pll.main_con1 = ufs_hs_reg(dali_hs_platform.apmixed, 0x254);
+    out->pll.univ_con1 = ufs_hs_reg(dali_hs_platform.apmixed, 0x268);
+    out->gate0 = ufs_ao_rd(DALI_UFS_AO_GATE0);
+    out->gate1 = ufs_ao_rd(DALI_UFS_AO_GATE1);
+    out->refclk = ufs_rd(REG_MTK_REF_CLOCK);
+    if (out->gate0 == UINT32_MAX || out->gate1 == UINT32_MAX || out->refclk == UINT32_MAX ||
+        (out->gate0 & 3u) || (out->gate1 & 0x11fu) || (out->refclk & 3u) != 3u ||
+        sweet_pwm_clock_hz(&out->pll, &out->pll) == 0) return EIO;
+    return 0;
+}
+
+static bool
+ufs_hs_clock_equal(const struct dali_hs_clock *a, const struct dali_hs_clock *b)
+{
+    return sweet_pwm_clock_equal(&a->pll, &b->pll) &&
+        (a->gate0 & 3u) == (b->gate0 & 3u) && (a->gate1 & 0x11fu) == (b->gate1 & 0x11fu) &&
+        (a->refclk & 3u) == (b->refclk & 3u);
+}
+
+static int
+ufs_hs_clock_ok(void *context)
+{
+    (void)context;
+    struct dali_hs_clock live;
+    return ufs_hs_clock_read(&live) || !ufs_hs_clock_equal(&live, &dali_hs_platform.reference) ? EIO : 0;
+}
+
+static uint64_t
+ufs_hs_now_us(void *context)
+{
+    (void)context;
+    uint64_t ns = 0;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    return ns / NSEC_PER_USEC;
+}
+
+static void
+ufs_hs_delay_us(void *context, uint32_t microseconds)
+{
+    (void)context;
+    delay(microseconds);
+}
+
+static int
+ufs_dali_hs_platform_adopt(void)
+{
+    if (dali_hs_platform.failure) return dali_hs_platform.failure;
+    if (dali_hs_platform.started) return EBUSY;
+    dali_hs_platform.started = true;
+    if (!su.dali || su.ready || su.command_poisoned) return (dali_hs_platform.failure = EIO);
+    dali_hs_platform.dvfsrc = ml_io_map(0x1c013000ull, 0x1000);
+    dali_hs_platform.top = ml_io_map(0x10000000ull, 0x800);
+    dali_hs_platform.apmixed = ml_io_map(0x10000800ull, 0x1000);
+    if (!dali_hs_platform.dvfsrc || !dali_hs_platform.top || !dali_hs_platform.apmixed)
+        return (dali_hs_platform.failure = ENOMEM);
+    struct dali_hs_clock first, second;
+    if (ufs_hs_clock_read(&first) || ufs_hs_clock_read(&second) || !ufs_hs_clock_equal(&first, &second))
+        return (dali_hs_platform.failure = EIO);
+    dali_hs_platform.reference = second;
+    const struct hsf_ops ops = {ufs_hs_floor_read, ufs_hs_floor_write, ufs_hs_smc,
+        ufs_hs_clock_ok, ufs_hs_now_us, ufs_hs_delay_us};
+    int error = hsf_acquire(&dali_hs_platform.floor, true, &ops, NULL);
+    struct hsf_state *s = &dali_hs_platform.floor;
+    printf("SWEET UFS HSFLOOR: result=%d stage=%u request=%u completed=%u nominal=%u calibrated=%u "
+        "write-attempted=%u clock=%llu resource-raw=0x%llx/0x%llx scope=ap-min-request-not-adc\n", error,
+        error ? s->failed_stage : s->phase, s->request, s->completed, s->nominal_uv,
+        s->calibrated_uv, s->wrote_request ? 1u : 0u,
+        (unsigned long long)sweet_pwm_clock_hz(&second.pll, &second.pll),
+        (unsigned long long)s->resource_request_result, (unsigned long long)s->resource_release_result);
+    if (error) dali_hs_platform.failure = EIO;
+    return dali_hs_platform.failure;
+}
+
+static int
+ufs_dali_hs_platform_validate(void)
+{
+    if (dali_hs_platform.failure) return dali_hs_platform.failure;
+    if (!dali_hs_platform.started) return EIO;
+    int error = hsf_validate(&dali_hs_platform.floor);
+    if (error) {
+        dali_hs_platform.failure = EIO;
+        printf("SWEET UFS HSFLOOR: lost result=%d stage=%u new-io=stopped\n", error,
+            dali_hs_platform.floor.failed_stage);
+    }
+    return dali_hs_platform.failure;
+}
+#endif
diff --git a/pexpert/arm/DaliUFSSpeedReturn.h b/pexpert/arm/DaliUFSSpeedReturn.h
new file mode 100644
index 0000000000000000000000000000000000000000..24a340ed8327d00d2a5916d72b1c3bdd52b6b3ff
--- /dev/null
+++ b/pexpert/arm/DaliUFSSpeedReturn.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * Short, pre-root UFS functional trial. Existing return policy remains intact.
+ */
+#ifndef DALI_UFS_SPEED_RETURN_H
+#define DALI_UFS_SPEED_RETURN_H
+#include "DaliFastbootReturnPolicy.h"
+
+/* Caller completed its bounded log before releasing the UFS mutex. No mounted
+ * root, logger or sampler exists. Do not call VFS_SYNC or drain an unknown link.
+ */
+static inline bool
+dali_fb_ufs_probe_return(struct dali_fb_state *state, const struct dali_fb_ops *ops)
+{
+    if (state->phase != 1) return false;
+    state->phase = 2;
+    uint64_t now = ops->now(ops->context);
+    if (!dali_fb_parameters_valid(state->frequency, state->after, state->lease) ||
+        state->started > UINT64_MAX - state->frequency * state->lease ||
+        now < state->started || now - state->started >= state->frequency * (state->lease - 10)) {
+        state->phase = 5;
+        ops->record(ops->context, "ufs-probe-deadline-unconfirmed", state->original, state->mode);
+        return false;
+    }
+    uint32_t marker = (state->original & ~DALI_FB_MASK) | DALI_FB_BOOTLOADER;
+    if (ops->read(ops->context, DALI_FB_MARKER_OFFSET) != marker ||
+        ops->read(ops->context, 0) != state->mode ||
+        ops->read(ops->context, 4) != state->length) {
+        state->phase = 5;
+        ops->record(ops->context, "ufs-probe-state-unconfirmed", marker, state->mode);
+        return false;
+    }
+    ops->record(ops->context, "ufs-probe-prepared", marker, state->mode);
+    ops->fence(ops->context);
+    now = ops->now(ops->context);
+    if (now < state->started || now - state->started >= state->frequency * (state->lease - 10) ||
+        ops->read(ops->context, DALI_FB_MARKER_OFFSET) != marker ||
+        ops->read(ops->context, 0) != state->mode ||
+        ops->read(ops->context, 4) != state->length) {
+        state->phase = 5;
+        ops->record(ops->context, "ufs-probe-state-unconfirmed", marker, state->mode);
+        return false;
+    }
+    uint32_t result = ops->reset(ops->context);
+    state->phase = 3;
+    ops->record(ops->context, "ufs-probe-reset-returned", result, state->mode);
+    if (!dali_fb_rollback(ops, state->original)) {
+        state->phase = 4;
+        ops->record(ops->context, "ufs-probe-rollback-failed", marker, state->mode);
+    }
+    return false;
+}
+#endif

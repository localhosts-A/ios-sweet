diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -218,12 +218,30 @@
 
 TUNABLE(startup_debug_t, startup_debug, "startup_debug", 0);
 
+#if DEVELOPMENT && defined(ARM64_BOARD_CONFIG_SWEET)
+/* Same physical counter as the shim; independent of calendar/RTC setup. */
+uint64_t sweet_boot_counter_ms(void);
+uint64_t
+sweet_boot_counter_ms(void)
+{
+	uint64_t ticks, frequency;
+	__asm__ volatile("isb\n\tmrs %0, cntpct_el0" : "=r"(ticks));
+	__asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+	return frequency ? (ticks / frequency) * 1000 +
+	       ((ticks % frequency) * 1000) / frequency : 0;
+}
+#endif
+
 static inline void
 kernel_bootstrap_log(const char *message)
 {
 	if ((startup_debug & STARTUP_DEBUG_VERBOSE) &&
 	    startup_phase >= STARTUP_SUB_KPRINTF) {
+#if DEVELOPMENT && defined(ARM64_BOARD_CONFIG_SWEET)
+		kprintf("T%llums kernel_bootstrap: %s\n", sweet_boot_counter_ms(), message);
+#else
 		kprintf("kernel_bootstrap: %s\n", message);
+#endif
 	}
 	kernel_debug_string_early(message);
 }
@@ -233,7 +251,11 @@
 {
 	if ((startup_debug & STARTUP_DEBUG_VERBOSE) &&
 	    startup_phase >= STARTUP_SUB_KPRINTF) {
+#if DEVELOPMENT && defined(ARM64_BOARD_CONFIG_SWEET)
+		kprintf("T%llums kernel_bootstrap_thread: %s\n", sweet_boot_counter_ms(), message);
+#else
 		kprintf("kernel_bootstrap_thread: %s\n", message);
+#endif
 	}
 	kernel_debug_string_early(message);
 }

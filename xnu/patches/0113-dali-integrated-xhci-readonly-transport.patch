+/* Dali polling xHCI + USB2 enumeration + read-only BOT/SCSI transport.
+ * Register/TRB definitions: xHCI1.22 chapters4/5/6, USB2 ch9, USB MSC BOT1.0.
+ * Default-unreachable until the platform validates its DMA ownership policy.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+#include "DaliXHCI.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <kern/task.h>
+#include <libkern/libkern.h>
+
+namespace {
+constexpr unsigned arenaBytes = 0x40000, dataOffset = 0x10000, dataBytes = 0x10000;
+constexpr uint32_t cycle = 1, ioc = 1U << 5;
+uint64_t milliseconds() {
+    uint64_t count, hz;
+    __asm__ volatile("isb; mrs %0, cntpct_el0; mrs %1, cntfrq_el0" : "=r"(count), "=r"(hz));
+    return hz ? count / (hz / 1000) : 0;
+}
+void publish() { __asm__ volatile("dsb oshst" ::: "memory"); }
+void consume() { __asm__ volatile("dmb oshld" ::: "memory"); }
+uint16_t le16(const uint8_t *p) { return p[0] | (uint16_t(p[1]) << 8); }
+uint32_t le32(const uint8_t *p) { return le16(p) | (uint32_t(le16(p + 2)) << 16); }
+uint64_t le64(const uint8_t *p) { return le32(p) | (uint64_t(le32(p + 4)) << 32); }
+uint32_t be32(const uint8_t *p) {
+    return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+}
+void put32(uint8_t *p, uint32_t v) {
+    for (unsigned i = 0; i < 4; ++i) { p[i] = uint8_t(v >> (8 * i)); }
+}
+void putBE32(uint8_t *p, uint32_t v) {
+    for (unsigned i = 0; i < 4; ++i) { p[i] = uint8_t(v >> (24 - 8 * i)); }
+}
+}
+
+uint32_t DaliXHCI::rd(unsigned n) const {
+    return n <= 0xffc && !(n & 3) ? ops.read(ops.cookie, n) : ~0U;
+}
+void DaliXHCI::wr(unsigned n, uint32_t v) const {
+    if (n <= 0xffc && !(n & 3)) { ops.write(ops.cookie, n, v); }
+}
+void DaliXHCI::wr64(unsigned n, uint64_t v) const {
+    wr(n, uint32_t(v)); wr(n + 4, uint32_t(v >> 32));
+}
+bool DaliXHCI::live() {
+    if (__atomic_load_n(&faulted, __ATOMIC_ACQUIRE) || !ops.alive(ops.cookie) ||
+        milliseconds() - startedMs > operationBudgetMs) { fail(); return false; }
+    return true;
+}
+bool DaliXHCI::wait(unsigned reg, uint32_t mask, uint32_t expected, unsigned ms) {
+    uint64_t start = milliseconds();
+    do {
+        if (!live()) { return false; }
+        uint32_t value = rd(reg);
+        if (value == ~0U) { fail(); return false; }
+        if ((value & mask) == expected) { return true; }
+        IOSleep(1);
+    } while (milliseconds() - start < ms);
+    return false;
+}
+bool DaliXHCI::allocate() {
+    /* One uncached mapping avoids cache-line sharing with device-written TRBs.
+     * No synthetic IOVA: physical address is permitted only by platform policy.
+     */
+    memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+        kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMemoryMapperNone |
+        kIOMapInhibitCache, arenaBytes, 0x10000);
+    if (!memory || memory->prepare(kIODirectionInOut) != kIOReturnSuccess) { return false; }
+    prepared = true;
+    IOByteCount length = 0;
+    physical = memory->getPhysicalSegment(0, &length, kIOMemoryMapperNone);
+    arenaMap = memory->map(kIOMapAnywhere | kIOMapInhibitCache);
+    bytes = arenaMap ? reinterpret_cast<uint8_t *>(arenaMap->getVirtualAddress()) : nullptr;
+    if (!physical || (physical & 0xffff) || length < arenaBytes || !bytes ||
+        physical > ((1ULL << 48) - arenaBytes)) { return false; }
+    bzero(bytes, arenaBytes);
+    Ring *rings[] = {&commandRing, &controlRing, &inRing, &outRing};
+    for (Ring *r : rings) {
+        auto *link = reinterpret_cast<TRB *>(bytes + r->offset) + 255;
+        uint64_t target = physical + r->offset;
+        link->lo = uint32_t(target); link->hi = uint32_t(target >> 32);
+        link->control = (6U << 10) | 2U; /* Link TRB, toggle cycle; C set at wrap. */
+    }
+    publish();
+    return true;
+}
+uint64_t DaliXHCI::submitTRB(Ring &r, uint64_t parameter, uint32_t status,
+    uint32_t control, bool give) {
+    if (r.index >= 255 || !live()) { return 0; }
+    unsigned offset = r.offset + r.index * sizeof(TRB);
+    auto *trb = reinterpret_cast<volatile TRB *>(bytes + offset);
+    trb->lo = uint32_t(parameter); trb->hi = uint32_t(parameter >> 32); trb->status = status;
+    publish(); trb->control = control | (give ? r.cycle : (r.cycle ^ 1U)); publish();
+    if (++r.index == 255) {
+        auto *link = reinterpret_cast<volatile TRB *>(bytes + r.offset) + 255;
+        publish(); link->control = (6U << 10) | 2U | r.cycle; publish();
+        r.index = 0; r.cycle ^= 1;
+    }
+    return physical + offset;
+}
+bool DaliXHCI::nextEvent(TRB *out, unsigned ms) {
+    uint64_t start = milliseconds();
+    do {
+        if (!live()) { return false; }
+        uint32_t status = rd(op + 4);
+        if (status == ~0U || (status & ((1U << 2) | (1U << 12)))) { fail(); return false; }
+        auto *t = reinterpret_cast<volatile TRB *>(bytes + 0x2000) + eventIndex;
+        uint32_t control = t->control;
+        if ((control & cycle) == eventCycle) {
+            consume();
+            out->lo = t->lo; out->hi = t->hi; out->status = t->status; out->control = control;
+            if (++eventIndex == 256) { eventIndex = 0; eventCycle ^= 1; }
+            wr64(runtime + 0x38, (physical + 0x2000 + eventIndex * 16) | 8U);
+            return true;
+        }
+        IOSleep(1);
+    } while (milliseconds() - start < ms);
+    return false;
+}
+bool DaliXHCI::command(unsigned type, uint64_t parameter, uint32_t status,
+    uint32_t flags, unsigned *resultSlot) {
+    uint64_t trb = submitTRB(commandRing, parameter, status, (type << 10) | flags);
+    if (!trb) { return false; }
+    publish(); wr(doors, 0);
+    uint64_t start = milliseconds();
+    while (milliseconds() - start < 1000) {
+        TRB event{};
+        if (!nextEvent(&event, 1000)) { break; }
+        unsigned kind = (event.control >> 10) & 63;
+        if (kind == 34) { continue; } /* PORTSC is polled; no port change ACK here. */
+        uint64_t pointer = event.lo | (uint64_t(event.hi) << 32);
+        if (kind != 33 || pointer != trb || (event.status >> 24) != 1) { break; }
+        if (resultSlot) { *resultSlot = event.control >> 24; }
+        return true;
+    }
+    fail(); ops.log("DALI XHCI: command failed type=%u\n", type); return false;
+}
+bool DaliXHCI::completion(uint64_t pointer, unsigned endpoint, bool shortAllowed,
+    unsigned *residual, unsigned ms, uint64_t shortPointer) {
+    uint64_t start = milliseconds();
+    unsigned shortResidual = 0;
+    while (milliseconds() - start < ms) {
+        TRB event{};
+        if (!nextEvent(&event, ms)) { break; }
+        unsigned kind = (event.control >> 10) & 63;
+        if (kind == 34) { continue; }
+        uint64_t address = event.lo | (uint64_t(event.hi) << 32);
+        unsigned code = event.status >> 24;
+        if (shortPointer && kind == 32 && (event.control >> 24) == slot &&
+            ((event.control >> 16) & 31) == endpoint && address == shortPointer && code == 13) {
+            shortResidual = event.status & 0xffffff; continue;
+        }
+        if (kind != 32 || (event.control >> 24) != slot ||
+            ((event.control >> 16) & 31) != endpoint || address != pointer ||
+            (code != 1 && !(shortAllowed && code == 13))) { break; }
+        if (residual) { *residual = shortResidual ? shortResidual : (event.status & 0xffffff); }
+        return true;
+    }
+    fail(); ops.log("DALI XHCI: transfer failed endpoint=%u\n", endpoint); return false;
+}
+bool DaliXHCI::usb2Port(unsigned *selected) {
+    unsigned ports = rd(4) >> 24, ext = (rd(0x10) >> 16) * 4, found = 0;
+    for (unsigned count = 0; ext && count < 16; ++count) {
+        if ((ext & 3) || ext < 0x20 || ext > 0xff0) { return false; }
+        uint32_t cap = rd(ext), range = rd(ext + 8);
+        if ((cap & 255) == 1) { return false; } /* Unimplemented legacy ownership. */
+        if ((cap & 255) == 2 && rd(ext + 4) == 0x20425355 && (cap >> 24) == 2) {
+            if (found || ((range >> 8) & 255) != 1 || !(range & 255) || (range & 255) > ports) { return false; }
+            found = range & 255;
+        }
+        unsigned next = ((cap >> 8) & 255) * 4;
+        if (!next) { ext = 0; break; }
+        if (ext + next <= ext || ext + next > 0xff0) { return false; }
+        ext += next;
+    }
+    if (ext || !found) { return false; }
+    *selected = found; return true;
+}
+bool DaliXHCI::initialize(unsigned usbPort) {
+    uint32_t cap = rd(0), hcc = rd(0x10), hcs = rd(4);
+    op = cap & 255; contextBytes = (hcc & 4) ? 64 : 32;
+    doors = rd(0x14); runtime = rd(0x18);
+    if (op < 0x20 || op > 0x80 || (op & 3) || (cap >> 16) < 0x100 ||
+        (cap >> 16) > 0x120 || !(hcc & 1) || !(hcc & 8) ||
+        !usbPort || usbPort > (hcs >> 24) || (hcs & 255) < 1 ||
+        doors < 0x20 || doors > 0xfc0 || (doors & 3) ||
+        runtime < 0x20 || runtime > 0xfa0 || (runtime & 31) ||
+        op + 0x400 + (hcs >> 24) * 16 > 0x1000 || rd(op) != 0 ||
+        (rd(op + 4) & 0x801) != 1) { return false; }
+    port = usbPort;
+    wr(op, 2); /* Host controller reset only after halt, no DMA published. */
+    if (!wait(op, 2, 0, 1000) || !wait(op + 4, 0x800, 0, 1000) || !(rd(op + 8) & 1)) { return false; }
+    unsigned scratch = ((rd(8) >> 27) & 31) | (((rd(8) >> 21) & 31) << 5);
+    if (scratch > 32 || !allocate()) { return false; }
+    auto *dcbaa = reinterpret_cast<uint64_t *>(bytes);
+    if (scratch) {
+        dcbaa[0] = physical + 0x8000;
+        auto *array = reinterpret_cast<uint64_t *>(bytes + 0x8000);
+        for (unsigned n = 0; n < scratch; ++n) { array[n] = physical + 0x20000 + n * 0x1000; }
+    }
+    auto *erst = reinterpret_cast<uint64_t *>(bytes + 0x3000);
+    erst[0] = physical + 0x2000; erst[1] = 256;
+    publish(); dmaPublished = true;
+    wr64(op + 0x30, physical); wr64(op + 0x18, (physical + 0x1000) | 1);
+    wr(runtime + 0x20, 0); /* IRQ disabled: event ring is polled. */
+    wr(runtime + 0x28, 1); wr64(runtime + 0x30, physical + 0x3000);
+    wr64(runtime + 0x38, physical + 0x2000); wr(op + 0x38, 1);
+    wr(op, 1); running = true;
+    if (!wait(op + 4, 1, 0, 1000) || !command(23, 0, 0, 0)) { return false; }
+    ops.log("DALI XHCI: running AC64=1 context=%u arena=%llx bytes=%u\n", contextBytes, physical, arenaBytes);
+    unsigned reg = op + 0x400 + (port - 1) * 16;
+    constexpr uint32_t neutral = 0x4e00ffe9U; /* RO/RWS, no RW1C/reset/strobe. */
+    uint32_t value = rd(reg);
+    if (value == ~0U || (value & 8)) { return false; }
+    wr(reg, (value & neutral) | 0x200);
+    IOSleep(20);
+    if (!wait(reg, 1, 1, 2000)) { ops.log("DALI XHCI: no USB2 attachment\n"); return false; }
+    for (unsigned n = 0; n < 10; ++n) {
+        if (!live() || (rd(reg) & 9) != 1) { return false; }
+        IOSleep(10); /* USB2 connection debounce, independent of Type-C debounce. */
+    }
+    value = rd(reg); wr(reg, (value & neutral) | 0x200 | 16); /* USB2 reset. */
+    if (!wait(reg, 16, 0, 1000) || !(rd(reg) & 2)) { return false; }
+    unsigned speed = (rd(reg) >> 10) & 15;
+    if (speed != 1 && speed != 3) { return false; } /* FS or HS; no LS MSC. */
+    return true;
+}
+
+bool DaliXHCI::control(uint8_t requestType, uint8_t request, uint16_t value,
+    uint16_t index, void *buffer, unsigned length, unsigned *actual) {
+    if (length > dataBytes || (length && !buffer) || !slot || !live()) { return false; }
+    bool input = requestType & 0x80;
+    /* Keep each control TD in one segment. First TRB stays unavailable until
+     * data/status are complete, even if a running controller prefetches it.
+     */
+    while (controlRing.index > 252) {
+        if (!submitTRB(controlRing, 0, 0, 8U << 10)) { return false; }
+    }
+    uint64_t setup = requestType | (uint64_t(request) << 8) | (uint64_t(value) << 16) |
+        (uint64_t(index) << 32) | (uint64_t(length) << 48);
+    if (length && !input) { memcpy(bytes + dataOffset, buffer, length); }
+    uint32_t trt = length ? (input ? 3U : 2U) : 0;
+    uint64_t setupTRB = submitTRB(controlRing, setup, 8,
+        (2U << 10) | (1U << 6) | (trt << 16), false);
+    if (!setupTRB) { return false; }
+    uint64_t dataTRB = 0;
+    if (length) {
+        dataTRB = submitTRB(controlRing, physical + dataOffset, length,
+            (3U << 10) | (input ? (1U << 16) | 4U : 0));
+        if (!dataTRB) { return false; }
+    }
+    uint64_t statusTRB = submitTRB(controlRing, 0, 0,
+        (4U << 10) | ioc | ((!length || !input) ? 1U << 16 : 0));
+    if (!statusTRB) { return false; }
+    publish();
+    auto *first = reinterpret_cast<volatile TRB *>(bytes + setupTRB - physical);
+    first->control ^= 1U;
+    publish(); wr(doors + slot * 4, 1);
+    unsigned residual = 0;
+    if (!completion(statusTRB, 1, false, &residual, 1000, dataTRB) || residual > length) { return false; }
+    unsigned received = length - residual;
+    consume();
+    if (input && received) { memcpy(buffer, bytes + dataOffset, received); }
+    if (actual) { *actual = received; }
+    return true;
+}
+bool DaliXHCI::bulk(bool input, void *buffer, unsigned length, unsigned *actual) {
+    unsigned endpoint = input ? epIn : epOut;
+    Ring &ring = input ? inRing : outRing;
+    if (!endpoint || !buffer || !length || length > dataBytes || !live()) { return false; }
+    if (!input) { memcpy(bytes + dataOffset, buffer, length); }
+    uint64_t trb = submitTRB(ring, physical + dataOffset, length,
+        (1U << 10) | ioc | (input ? 4U : 0));
+    if (!trb) { return false; }
+    publish(); wr(doors + slot * 4, endpoint);
+    unsigned residual = 0;
+    if (!completion(trb, endpoint, input, &residual, 1500) || residual > length) { return false; }
+    unsigned transferred = length - residual;
+    consume(); if (input && transferred) { memcpy(buffer, bytes + dataOffset, transferred); }
+    if (actual) { *actual = transferred; }
+    return true;
+}
+bool DaliXHCI::configureEndpoints(unsigned configValue) {
+    auto *input = reinterpret_cast<uint32_t *>(bytes + 0x4000);
+    bzero(input, 0x1000);
+    input[1] = 1U | (1U << epIn) | (1U << epOut);
+    unsigned highest = epIn > epOut ? epIn : epOut;
+    /* Keep the addressed Slot Context; update only Context Entries. */
+    auto *output = reinterpret_cast<uint32_t *>(bytes + 0x9000);
+    consume(); memcpy(bytes + 0x4000 + contextBytes, output, contextBytes);
+    auto *slotCtx = reinterpret_cast<uint32_t *>(bytes + 0x4000 + contextBytes);
+    slotCtx[0] = (slotCtx[0] & ~(31U << 27)) | (highest << 27);
+    unsigned endpoints[] = {epIn, epOut};
+    for (unsigned ep : endpoints) {
+        auto *ctx = reinterpret_cast<uint32_t *>(bytes + 0x4000 + contextBytes * (ep + 1));
+        unsigned packet = ep == epIn ? inPacket : outPacket;
+        uint64_t dequeue = physical + (ep == epIn ? inRing.offset : outRing.offset);
+        ctx[1] = (3U << 1) | ((ep == epIn ? 6U : 2U) << 3) | (packet << 16);
+        ctx[2] = uint32_t(dequeue) | 1; ctx[3] = uint32_t(dequeue >> 32);
+        ctx[4] = packet; /* Average TRB Length. */
+    }
+    publish();
+    if (!command(12, physical + 0x4000, 0, slot << 24)) { return false; }
+    return control(0, 9, uint16_t(configValue), 0, nullptr, 0);
+}
+bool DaliXHCI::enumerate() {
+    unsigned speed = (rd(op + 0x400 + (port - 1) * 16) >> 10) & 15;
+    if (!command(9, 0, 0, 0, &slot) || slot != 1) { return false; }
+    auto *dcbaa = reinterpret_cast<uint64_t *>(bytes);
+    dcbaa[slot] = physical + 0x9000;
+    auto *input = reinterpret_cast<uint32_t *>(bytes + 0x4000);
+    input[1] = 3;
+    auto *slotCtx = reinterpret_cast<uint32_t *>(bytes + 0x4000 + contextBytes);
+    slotCtx[0] = (speed << 20) | (1U << 27); slotCtx[1] = port << 16;
+    auto *ep0 = reinterpret_cast<uint32_t *>(bytes + 0x4000 + contextBytes * 2);
+    unsigned packet = speed == 3 ? 64 : 8;
+    ep0[1] = (3U << 1) | (4U << 3) | (packet << 16);
+    ep0[2] = uint32_t(physical + controlRing.offset) | 1;
+    ep0[3] = uint32_t((physical + controlRing.offset) >> 32); ep0[4] = 8;
+    publish();
+    if (!command(11, physical + 0x4000, 0, slot << 24)) { return false; }
+    uint8_t device[18] = {}; unsigned got = 0;
+    if (!control(0x80, 6, 0x100, 0, device, 8, &got) || got != 8 ||
+        device[0] != 18 || device[1] != 1 || device[4] == 9) { return false; }
+    unsigned maxPacket = device[7];
+    if (maxPacket != 8 && maxPacket != 16 && maxPacket != 32 && maxPacket != 64) { return false; }
+    if (speed == 3 && maxPacket != 64) { return false; }
+    if (maxPacket != packet) {
+        bzero(input, 0x1000); input[1] = 2;
+        consume(); memcpy(ep0, bytes + 0x9000 + contextBytes, contextBytes);
+        ep0[1] = (ep0[1] & 0xffff) | (maxPacket << 16);
+        publish();
+        if (!command(13, physical + 0x4000, 0, slot << 24)) { return false; }
+    }
+    if (!control(0x80, 6, 0x100, 0, device, sizeof(device), &got) || got != sizeof(device)) { return false; }
+    uint8_t config[1024] = {};
+    if (!device[17] || !control(0x80, 6, 0x200, 0, config, 9, &got) || got != 9 || config[1] != 2) { return false; }
+    unsigned total = le16(config + 2);
+    if (total < 9 || total > sizeof(config) || !config[5] ||
+        !control(0x80, 6, 0x200, 0, config, total, &got) || got != total) { return false; }
+    bool candidate = false, found = false;
+    unsigned bulkCount = 0;
+    for (unsigned offset = 0; offset < total;) {
+        unsigned length = config[offset];
+        if (length < 2 || length > total - offset) { return false; }
+        const uint8_t *d = config + offset;
+        if (d[1] == 4) {
+            if (candidate && bulkCount == 2 && epIn && epOut) { found = true; break; }
+            if (length < 9) { return false; }
+            candidate = d[3] == 0 && d[4] == 2 && d[5] == 8 && d[6] == 6 && d[7] == 0x50;
+            bulkCount = 0; epIn = epOut = 0;
+            if (candidate) { interface = d[2]; }
+        } else if (d[1] == 5 && candidate) {
+            if (length < 7 || (d[3] & 3) != 2 || (d[2] & 0x70) || !(d[2] & 15)) { return false; }
+            unsigned mps = le16(d + 4);
+            if (!mps || (mps & (mps - 1)) || (speed == 3 ? mps != 512 : mps > 64)) { return false; }
+            unsigned dci = (d[2] & 15) * 2 + ((d[2] & 0x80) ? 1 : 0);
+            if (d[2] & 0x80) { if (epIn) { return false; } epIn = dci; inPacket = mps; }
+            else { if (epOut) { return false; } epOut = dci; outPacket = mps; }
+            ++bulkCount;
+        }
+        offset += length;
+    }
+    found = found || (candidate && bulkCount == 2 && epIn && epOut);
+    if (!found || !configureEndpoints(config[5])) { return false; }
+    ops.log("DALI USB: device=%04x:%04x speed=%u BOT interface=%u ep=%u/%u\n",
+        le16(device + 8), le16(device + 10), speed, interface, epIn, epOut);
+    uint8_t inquiry[36] = {}, cdb[16] = {0x12, 0, 0, 0, 36};
+    if (!scsi(cdb, 6, inquiry, sizeof(inquiry)) || (inquiry[0] & 31) != 0) { return false; }
+    bool ready = false;
+    for (unsigned attempt = 0; attempt < 3; ++attempt) {
+        bzero(cdb, sizeof(cdb)); bool checkCondition = false;
+        if (scsi(cdb, 6, nullptr, 0, &checkCondition)) { ready = true; break; }
+        if (!checkCondition || __atomic_load_n(&faulted, __ATOMIC_ACQUIRE)) { return false; }
+        uint8_t sense[18] = {}; cdb[0] = 3; cdb[4] = sizeof(sense);
+        if (!scsi(cdb, 6, sense, sizeof(sense)) || ((sense[2] & 15) != 2 && (sense[2] & 15) != 6)) { return false; }
+        IOSleep(100);
+    }
+    if (!ready) { return false; }
+    uint8_t capacity[8] = {}; bzero(cdb, sizeof(cdb)); cdb[0] = 0x25;
+    if (!scsi(cdb, 10, capacity, sizeof(capacity))) { return false; }
+    uint32_t last = be32(capacity); blockBytes = be32(capacity + 4);
+    if (last == ~0U || blockBytes < 512 || blockBytes > 4096 || (blockBytes & (blockBytes - 1))) { return false; }
+    blockCount = uint64_t(last) + 1; configured = true;
+    ops.log("DALI MSC: ready blocks=%llu sector=%u; SCSI writes disabled\n", blockCount, blockBytes);
+    return true;
+}
+bool DaliXHCI::scsi(const uint8_t *cdb, unsigned cdbBytes, void *buffer,
+    unsigned length, bool *checkCondition) {
+    if (checkCondition) { *checkCondition = false; }
+    if (!cdb || !cdbBytes || cdbBytes > 16 || length > dataBytes) { return false; }
+    /* Strict read-only command set; no arbitrary CDB passthrough. */
+    if (cdb[0] != 0 && cdb[0] != 3 && cdb[0] != 0x12 && cdb[0] != 0x25 && cdb[0] != 0x28) { return false; }
+    uint8_t cbw[31] = {}, csw[13] = {};
+    put32(cbw, 0x43425355); if (!++tag) { ++tag; } put32(cbw + 4, tag);
+    put32(cbw + 8, length); cbw[12] = length ? 0x80 : 0;
+    cbw[14] = uint8_t(cdbBytes); memcpy(cbw + 15, cdb, cdbBytes);
+    unsigned actual = 0, dataActual = 0;
+    if (!bulk(false, cbw, sizeof(cbw), &actual) || actual != sizeof(cbw)) { return false; }
+    if (length && !bulk(true, buffer, length, &dataActual)) { return false; }
+    if (!bulk(true, csw, sizeof(csw), &actual) || actual != sizeof(csw) ||
+        le32(csw) != 0x53425355 || le32(csw + 4) != tag || le32(csw + 8) > length ||
+        dataActual + le32(csw + 8) != length || csw[12] > 1) { fail(); return false; }
+    if (csw[12] == 1) { if (checkCondition) { *checkCondition = true; } return false; }
+    return true;
+}
+bool DaliXHCI::readBlocks(uint64_t lba, unsigned count, void *destination) {
+    if (!ready() || !count || count > 65535 || count > dataBytes / blockBytes ||
+        lba >= blockCount || count > blockCount - lba || lba > 0xffffffffULL) { return false; }
+    uint8_t cdb[10] = {0x28}; putBE32(cdb + 2, uint32_t(lba));
+    cdb[7] = uint8_t(count >> 8); cdb[8] = uint8_t(count);
+    if (scsi(cdb, sizeof(cdb), destination, count * blockBytes)) { return true; }
+    fail(); return false;
+}
+bool DaliXHCI::read(uint64_t offset, size_t length, void *destination) {
+    if (!ready() || !destination || !length || offset > capacity() || length > capacity() - offset ||
+        !blockBytes) { return false; }
+    startedMs = milliseconds(); operationBudgetMs = 3000;
+    auto *target = static_cast<uint8_t *>(destination);
+    while (length) {
+        if (offset % blockBytes || length < blockBytes) {
+            uint8_t sector[4096] = {};
+            unsigned within = unsigned(offset % blockBytes), amount = blockBytes - within;
+            if (amount > length) { amount = unsigned(length); }
+            if (!readBlocks(offset / blockBytes, 1, sector)) { return false; }
+            memcpy(target, sector + within, amount);
+            offset += amount; target += amount; length -= amount; continue;
+        }
+        unsigned amount = length > dataBytes ? dataBytes : unsigned(length);
+        amount -= amount % blockBytes;
+        if (!readBlocks(offset / blockBytes, amount / blockBytes, target)) { return false; }
+        offset += amount; target += amount; length -= amount;
+    }
+    return true;
+}
+bool DaliXHCI::findHFS(uint64_t *first, uint64_t *length) {
+    if (!first || !length || !ready()) { return false; }
+    uint8_t sector[4096] = {};
+    if (!read(0, blockBytes, sector)) { return false; }
+    uint64_t candidates[5] = {0}, sizes[5] = {capacity()}; unsigned count = 1;
+    if (sector[510] == 0x55 && sector[511] == 0xaa) {
+        for (unsigned i = 0; i < 4; ++i) {
+            const uint8_t *entry = sector + 446 + 16 * i;
+            uint64_t lba = le32(entry + 8), blocks = le32(entry + 12);
+            /* The existing stick's MBR type was retained when HFSX was written
+             * into sdc1. Validate filesystem contents, not the stale FAT type.
+             */
+            if (entry[4] && entry[4] != 0xee && entry[4] != 5 && entry[4] != 0x0f &&
+                blocks && lba < blockCount && blocks <= blockCount - lba) {
+                candidates[count] = lba * blockBytes; sizes[count++] = blocks * blockBytes;
+            }
+        }
+    }
+    for (unsigned i = 0; i < count; ++i) {
+        uint64_t offset = candidates[i] + 1024;
+        if (sizes[i] < 2048 || offset < candidates[i]) { continue; }
+        uint64_t aligned = offset & ~(uint64_t(blockBytes) - 1);
+        if (!read(aligned, blockBytes, sector)) { return false; }
+        const uint8_t *header = sector + offset - aligned;
+        uint16_t signature = (uint16_t(header[0]) << 8) | header[1];
+        uint16_t version = (uint16_t(header[2]) << 8) | header[3];
+        uint32_t allocation = be32(header + 40), total = be32(header + 44);
+        if ((signature != 0x482b || version != 4) && (signature != 0x4858 || version != 5)) { continue; }
+        if (!(be32(header + 4) & 0x100)) { continue; } /* Require clean unmount; no replay writes. */
+        if (allocation < 512 || (allocation & (allocation - 1)) || !total ||
+            uint64_t(allocation) * total > sizes[i]) { continue; }
+        *first = candidates[i]; *length = uint64_t(allocation) * total;
+        ops.log("DALI ROOT: HFS volume signature=%04x offset=%llu bytes=%llu\n", signature, *first, *length);
+        return true;
+    }
+    return false;
+}
+bool DaliXHCI::start(const DaliXHCIOps &callbacks, unsigned maxMilliseconds) {
+    if (memory || !callbacks.read || !callbacks.write || !callbacks.alive || !callbacks.log ||
+        maxMilliseconds < 1000 || maxMilliseconds > 12000) { return false; }
+    ops = callbacks; operationBudgetMs = maxMilliseconds; startedMs = milliseconds();
+    unsigned selected = 0;
+    if (!usb2Port(&selected) || !initialize(selected) || !enumerate()) {
+        fail(); ops.log("DALI XHCI: start failed; shutdown required\n"); return false;
+    }
+    return true;
+}
+bool DaliXHCI::stop() {
+    configured = false;
+    if (!dmaPublished && !running) { return true; }
+    /* Cleanup must run after live()/budget failure. Never free device-visible
+     * allocations until halt AND reset prove the controller cannot use them.
+     */
+    uint32_t cmd = rd(op);
+    if (cmd == ~0U) { return false; }
+    wr(op, cmd & ~1U);
+    bool halted = false;
+    for (unsigned i = 0; i < 1000; ++i) {
+        uint32_t status = rd(op + 4);
+        if (status != ~0U && (status & 1)) { halted = true; break; }
+        IOSleep(1);
+    }
+    if (!halted) { ops.log("DALI XHCI: halt failed; DMA memory pinned\n"); return false; }
+    running = false; wr(op, 2);
+    for (unsigned i = 0; i < 1000; ++i) {
+        uint32_t command = rd(op), status = rd(op + 4);
+        if (command != ~0U && status != ~0U && !(command & 2) && !(status & 0x800)) {
+            dmaPublished = false;
+            ops.log("DALI XHCI: stopped/reset; DMA ownership returned\n"); return true;
+        }
+        IOSleep(1);
+    }
+    ops.log("DALI XHCI: reset failed; DMA memory pinned\n"); return false;
+}
+DaliXHCI::~DaliXHCI() {
+    if (memory && !dmaPublished && !running) {
+        if (arenaMap) { arenaMap->release(); }
+        if (prepared) { memory->complete(kIODirectionInOut); }
+        memory->release();
+    } /* Else intentionally pin; caller must retain platform resources too. */
+}

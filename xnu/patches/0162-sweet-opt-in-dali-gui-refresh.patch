 void
+AppleCLCD::flushPanel(void)
+{
+	if (!fDaliGui || !fRefreshPending)
+		return;
+	/* Only this workloop submits GUI refresh; console uses the same try-guard. */
+	int result = sweet_early_gui_refresh();
+	if (result == 2)
+		return; /* Coalesce and retry next vsync; never spin on console/panic. */
+	fRefreshPending = false;
+	if (result == 1) {
+		if (fGuiFrames)
+			(void)OSCompareAndSwap(0, 1, &sweet_dali_gui_frame_ready);
+		if (++fRefreshes <= 4)
+			IOLog("DALI GUI: refresh complete n=%u frames=%u\n", fRefreshes, fGuiFrames);
+	} else {
+		(void)OSCompareAndSwap(1, 0, &sweet_dali_gui_frame_ready);
+		if (fRefreshFailures++ < 4)
+			IOLog("DALI GUI: refresh unavailable result=%d; retained timeout policy preserved\n", result);
+	}
+}

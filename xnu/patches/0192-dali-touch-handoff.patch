@@ -0,0 +1,50 @@
+/* One-shot Dali SPI6 handoff observation. No peripheral transaction. */
+#ifndef DALI_TOUCH_HANDOFF_H
+#define DALI_TOUCH_HANDOFF_H
+struct DaliTouchSnapshot {
+    unsigned int gpio, mux, fence, parentVote, parentDone, gateVote, gateDone, gateStatus;
+};
+struct DaliTouchIO {
+    void *context;
+    bool (*open)(void *, unsigned int, unsigned long long);
+    bool (*read)(void *, unsigned int, unsigned int, unsigned int *);
+    void (*close)(void *, unsigned int);
+};
+/* Inputs are raw ADT property bytes, callbacks map and read fixed regions. */
+static inline int dali_touch_handoff(const void *compatible, unsigned int compatibleLen,
+    const void *enabled, unsigned int enabledLen, const DaliTouchIO *io,
+    DaliTouchSnapshot *result)
+{
+    static const char target[] = "xiaomi,dali";
+    const unsigned char *c = static_cast<const unsigned char *>(compatible);
+    const unsigned char *e = static_cast<const unsigned char *>(enabled);
+    bool match = false;
+    if (!c || !e || enabledLen != 4 || e[0] != 1 || e[1] || e[2] || e[3]) return 0;
+    for (unsigned int i = 0; i < compatibleLen;) {
+        unsigned int start = i;
+        while (i < compatibleLen && c[i]) ++i;
+        if (i == compatibleLen) return 0;
+        if (i - start == sizeof(target)-1) {
+            unsigned int k = 0;
+            while (k < sizeof(target)-1 && c[start+k] == (unsigned char)target[k]) ++k;
+            if (k == sizeof(target)-1) match = true;
+        }
+        ++i;
+    }
+    if (!match || !io || !io->open || !io->read || !io->close || !result) return 0;
+    static const unsigned long long addresses[] = {0x1002d000ULL,0x10000000ULL,0x14500000ULL,0x16640000ULL};
+    static const unsigned int regions[] = {0,1,1,2,2,2,2,3};
+    static const unsigned int offsets[] = {0x3a0,0x90,0x274,0x28,0x2c14,0x08,0x2c04,0x14};
+    unsigned int values[8] = {}, opened = 0;
+    int rc = -1;
+    for (; opened < 4; ++opened) if (!io->open(io->context, opened, addresses[opened])) goto done;
+    for (unsigned int i=0;i<8;++i) if (!io->read(io->context,regions[i],offsets[i],&values[i])) goto done;
+    result->gpio=values[0]; result->mux=values[1]; result->fence=values[2];
+    result->parentVote=values[3]; result->parentDone=values[4];
+    result->gateVote=values[5]; result->gateDone=values[6]; result->gateStatus=values[7];
+    rc = 1;
+done:
+    while (opened) io->close(io->context, --opened);
+    return rc;
+}
+#endif

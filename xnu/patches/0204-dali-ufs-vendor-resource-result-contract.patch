 static inline int
 hsf_fail(struct hsf_state *s, unsigned int error)
 {
     if (s->phase != HSF_FAILED) {
         s->failed_stage = s->phase;
         s->failure = error;
@@ -180,19 +181,22 @@
     if (error) return hsf_fail(s, (unsigned int)error);
     /* Exact vendor ordering: AP vote, temporary memory resource, bounded idle
      * wait, 1us separation, completed gear, then temporary resource release.
      * No rollback lowers this boot's requested minimum, even on later failure. */
     s->phase = HSF_ACQUIRE;
     uint64_t a0 = UINT64_MAX, a1 = UINT64_MAX;
     int resource_error = s->ops.smc(context, 0x40, 0, &a0, &a1);
     s->resource_request_result = a0;
-    /* Resource a0 is opaque, unlike GET4 status. Pair every otherwise returned
-     * request with one release; actual AP/idle/gear, not a0, prove completion. */
-    if (resource_error || a0 == UINT64_MAX) return hsf_fail(s, HSF_RESOURCE);
+    s->resource_request_valid = resource_error == 0;
+    /* The exact MT6991 caller ignores both resource a0 results, including -1;
+     * they are not GET4/INIT status or proof of a resource grant. Keep the calls
+     * paired like that caller and require actual AP/idle/gear/clock completion.
+     * A local transport error is different: no returned firmware result. */
+    if (resource_error) return hsf_fail(s, HSF_RESOURCE);
     s->resource_requested = true;
     s->phase = HSF_WAITING;
     s->ops.delay_us(context, 1);
     uint64_t begin = error ? 0 : s->ops.now_us(context);
     bool idle_separated = false;
     for (unsigned int poll = 0; !error && poll <= HSF_WAIT_US; ++poll) {
         uint64_t now = s->ops.now_us(context);
         if (now < begin || now - begin > HSF_WAIT_US) { error = HSF_TIME; break; }
@@ -209,18 +213,19 @@
     }
     /* The AP minimum vote stays in SW_REQ. Release only the vendor temporary
      * memory resource request, exactly as mtk_dvfsrc_send_request does. */
     uint32_t failed_stage = s->phase;
     s->phase = HSF_RELEASING;
     a0 = a1 = UINT64_MAX;
     int release_error = s->ops.smc(context, 0x41, 0, &a0, &a1);
     s->resource_release_result = a0;
-    if (!release_error && a0 != UINT64_MAX) s->resource_requested = false;
-    if (!error && (release_error || a0 == UINT64_MAX)) { error = HSF_RELEASE; failed_stage = HSF_RELEASING; }
+    s->resource_release_valid = release_error == 0;
+    if (!release_error) s->resource_requested = false;
+    if (!error && release_error) { error = HSF_RELEASE; failed_stage = HSF_RELEASING; }
     if (error) {
         s->phase = failed_stage;
         return hsf_fail(s, (unsigned int)error);
     }
     s->completed = completed;
     s->phase = HSF_ACTIVE;
     return hsf_validate(s);
 }

--- /dev/null
+++ b/osfmk/kern/SweetIPCSendTrace.h
@@ -0,0 +1,88 @@
+#ifndef _KERN_SWEET_IPC_SEND_TRACE_H_
+#define _KERN_SWEET_IPC_SEND_TRACE_H_
+#include <sys/types.h>
+#include <stdint.h>
+#include <string.h>
+
+/* One bounded lifetime capture across all 40 load samples. */
+#define SWEET_IPCSEND_CAPACITY 128u
+#define SWEET_IPCSEND_ENTRY 1u
+#define SWEET_IPCSEND_EXIT 2u
+
+struct sweet_ipcsend_record {
+    uint64_t token, tid;
+    uint32_t target, phase, msgcount, qlimit, fullwaiters;
+    int32_t receiver_pid, wait_result;
+};
+struct sweet_ipcsend_snapshot {
+    struct sweet_ipcsend_record records[SWEET_IPCSEND_CAPACITY];
+    uint32_t count, used, lost;
+};
+struct sweet_ipcsend_ring {
+    volatile uint32_t guard, closed;
+    struct sweet_ipcsend_record records[SWEET_IPCSEND_CAPACITY];
+    uint32_t count, used, lost;
+};
+
+#ifndef SWEET_IPCSEND_CAS
+#define SWEET_IPCSEND_CAS(expected, desired, ptr) OSCompareAndSwap((expected), (desired), (ptr))
+#define SWEET_IPCSEND_INC(ptr) os_atomic_inc((ptr), relaxed)
+#define SWEET_IPCSEND_LOAD(ptr) os_atomic_load((ptr), relaxed)
+#define SWEET_IPCSEND_CLOSED(ptr) os_atomic_load((ptr), acquire)
+#define SWEET_IPCSEND_CLOSE(ptr) os_atomic_store((ptr), 1u, release)
+#endif
+
+/* Nonblocking one-shot producer guard; all 128 records cover the full run. */
+static inline void
+sweet_ipcsend_ring_close(struct sweet_ipcsend_ring *ring)
+{
+    if (ring) SWEET_IPCSEND_CLOSE(&ring->closed);
+}
+
+static inline int
+sweet_ipcsend_ring_append(struct sweet_ipcsend_ring *ring,
+    const struct sweet_ipcsend_record *record)
+{
+    if (!ring || !record || record->target == 0 ||
+        SWEET_IPCSEND_CLOSED(&ring->closed)) return 1;
+    if (!SWEET_IPCSEND_CAS(0, 1, &ring->guard)) {
+        SWEET_IPCSEND_INC(&ring->lost);
+        return -1;
+    }
+    int result = 0;
+    if (SWEET_IPCSEND_CLOSED(&ring->closed)) {
+        result = 1;
+    } else if (ring->used == SWEET_IPCSEND_CAPACITY) {
+        SWEET_IPCSEND_INC(&ring->lost);
+        result = -1;
+    } else {
+        ring->records[ring->count++] = *record;
+        ++ring->used;
+    }
+    (void)SWEET_IPCSEND_CAS(1, 0, &ring->guard);
+    return result;
+}
+
+/* Sample snapshot retries a fixed number of one-shot guard attempts only. */
+static inline int
+sweet_ipcsend_ring_drain(struct sweet_ipcsend_ring *ring,
+    struct sweet_ipcsend_snapshot *snapshot)
+{
+    if (!ring || !snapshot) return -1;
+    unsigned int tries;
+    for (tries = 0; tries < 128; ++tries) {
+        if (SWEET_IPCSEND_CAS(0, 1, &ring->guard)) break;
+    }
+    if (tries == 128) return -1;
+    snapshot->count = ring->count;
+    snapshot->used = ring->used;
+    for (uint32_t i = 0; i < ring->count; ++i) snapshot->records[i] = ring->records[i];
+    ring->count = 0;
+    snapshot->lost = SWEET_IPCSEND_LOAD(&ring->lost);
+    (void)SWEET_IPCSEND_CAS(1, 0, &ring->guard);
+    return 0;
+}
+
+void sweet_ipcsend_close(void);
+void sweet_ipcsend_dump(unsigned int sample);
+#endif

diff --git a/bsd/dev/SweetBackboardIPCPolicy.h b/bsd/dev/SweetBackboardIPCPolicy.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/SweetBackboardIPCPolicy.h
@@ -0,0 +1,72 @@
+/* Incoming Machmsg2 scalars, tagged by accepted SVC sequence; not IPC objects. */
+#ifndef SWEET_BACKBOARD_IPC_POLICY_H
+#define SWEET_BACKBOARD_IPC_POLICY_H
+#define SWEET_BBIPC_RECORDS 64u
+#define SWEET_BBIPC_SELECTED 4u
+#define SWEET_BBIPC_LINE_BYTES 256u
+struct sweet_bbipc_event {
+    uint32_t seq;
+    int32_t pid;
+    uint64_t tid, abstime, words[7];
+};
+struct sweet_bbipc_buffer {
+    struct sweet_bbipc_event events[SWEET_BBIPC_RECORDS];
+};
+struct sweet_bbipc_coverage {
+    uint32_t eligible, matched, selected, missing, limited;
+};
+/* Caller holds the original SVC guard, after successful old-ring admission. */
+static inline void
+sweet_bbipc_record(struct sweet_bbipc_buffer *buffer, const struct sweet_bbipc_event *event)
+{
+    if (event->seq == 0 || event->seq > SWEET_FF_EVENT_LIMIT)
+        return;
+    buffer->events[(event->seq - 1) % SWEET_BBIPC_RECORDS] = *event;
+}
+/* Only the current ordered SVC snapshot is eligible; never scan a second history. */
+static inline struct sweet_bbipc_coverage
+sweet_bbipc_select(const struct sweet_bbipc_buffer *buffer,
+    const struct sweet_ff_event *events, uint32_t count, struct sweet_bbipc_event *out)
+{
+    struct sweet_bbipc_coverage coverage = {0};
+    for (uint32_t i = 0; i < count; ++i) {
+        const struct sweet_ff_event *svc = &events[i];
+        if (svc->phase != 0 || svc->call != -47)
+            continue;
+        ++coverage.eligible;
+        if (svc->seq == 0 || svc->seq > SWEET_FF_EVENT_LIMIT) {
+            ++coverage.missing;
+            continue;
+        }
+        const struct sweet_bbipc_event *event = &buffer->events[(svc->seq - 1) % SWEET_BBIPC_RECORDS];
+        if (event->seq != svc->seq || event->pid != svc->pid || event->tid != svc->tid) {
+            ++coverage.missing;
+            continue;
+        }
+        ++coverage.matched;
+        if (coverage.selected == SWEET_BBIPC_SELECTED) {
+            for (uint32_t j = 1; j < SWEET_BBIPC_SELECTED; ++j)
+                out[j - 1] = out[j];
+            ++coverage.limited;
+        } else {
+            ++coverage.selected;
+        }
+        out[coverage.selected - 1] = *event;
+    }
+    return coverage;
+}
+static inline int
+sweet_bbipc_format(char *line, unsigned int bytes, unsigned int sample,
+    const struct sweet_bbipc_event *e)
+{
+    int size = snprintf(line, bytes,
+        "SWEET BBIPC: v=1 s=%u n=%u p=%d th=0x%llx at=0x%llx o=0x%llx b=0x%llx "
+        "p2=0x%llx vi=0x%llx d=0x%llx r=0x%llx t=0x%llx\n",
+        sample, e->seq, e->pid, (unsigned long long)e->tid, (unsigned long long)e->abstime,
+        (unsigned long long)e->words[0], (unsigned long long)e->words[1],
+        (unsigned long long)e->words[2], (unsigned long long)e->words[3],
+        (unsigned long long)e->words[4], (unsigned long long)e->words[5],
+        (unsigned long long)e->words[6]);
+    return size > 0 && size <= 255 && (unsigned int)size < bytes ? size : 0;
+}
+#endif

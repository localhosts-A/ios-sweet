new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/DaliUSBPower.h
@@ -0,0 +1,30 @@
+#ifndef DALI_USB_POWER_H
+#define DALI_USB_POWER_H
+#include <IOKit/IOLib.h>
+/* Single built-in Dali client. Tick/finish serialize through an owned lock.
+ * Diagnostic 5V/default-current source only, no PD/VCONN/PHY/xHCI/DMA.
+ */
+class DaliUSBPower {
+    IOLock *lock = nullptr;
+    enum State { Initial, Waiting, Rising, Powered, Finished } state = Initial;
+    unsigned ticks = 0, stateTicks = 0, stable = 0, attachedCC = 0;
+    uint8_t savedRole = 0, savedPolarity = 0, savedPowerCtrl = 0;
+    uint8_t savedCVHi = 0, savedCVLo = 0, savedCurrent = 0;
+    uint32_t status = 0;
+    uint64_t startedMs = 0, stateStartedMs = 0;
+    bool roleTouched = false, chargerTouched = false, cpAttempted = false;
+    bool read8(uint16_t reg, uint8_t *value);
+    bool write8(uint16_t reg, uint8_t value);
+    bool update(uint16_t reg, uint8_t mask, uint8_t value);
+    bool snapshot(uint8_t *cc, uint8_t *power, uint8_t *otg, unsigned *mv);
+    bool protectedIdle(bool idle);
+    bool sourceOn();
+    void finishLocked(const char *reason);
+    bool tickLocked();
+public:
+    bool init();
+    bool tick();
+    void finish(const char *reason);
+    void release();
+};
+#endif

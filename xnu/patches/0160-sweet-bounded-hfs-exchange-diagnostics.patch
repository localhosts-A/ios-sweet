+static bool
+sweet_hfs_diag_cnode(struct cnode *cp)
+{
+	if (!sweet_hfs_diag_enabled())
+		return false;
+	const char *name = (const char *)cp->c_desc.cd_nameptr;
+	static const char *const names[] = {"persona.kb", "usersession.kb", "usersessions.kb"};
+	for (unsigned int i = 0; name && i < sizeof(names) / sizeof(names[0]); ++i) {
+		size_t length = strlen(names[i]);
+		if (cp->c_desc.cd_namelen >= length && memcmp(name, names[i], length) == 0)
+			return true;
+	}
+	struct filefork *forks[] = {cp->c_datafork, cp->c_rsrcfork};
+	for (unsigned int i = 0; i < 2; ++i) {
+		if (forks[i] == NULL)
+			continue;
+		for (unsigned int j = 0; j < kHFSPlusExtentDensity; ++j)
+			if (sweet_hfs_diag_range(forks[i]->ff_extents[j].startBlock, forks[i]->ff_extents[j].blockCount))
+				return true;
+	}
+	return false;
+}
+
+static void
+sweet_hfs_diag_forks(const char *phase, struct cnode *cp, int error)
+{
+	struct filefork *forks[] = {cp->c_datafork, cp->c_rsrcfork};
+	for (unsigned int i = 0; i < 2; ++i) {
+		struct filefork *ff = forks[i];
+		if (ff == NULL)
+			continue;
+		uint32_t event = sweet_hfs_diag_take(error != 0);
+		if (!event)
+			return;
+		printf("SWEET HFSDIAG: %s n=%u fileid=%u cnid=%u fork=%u size=%llu blocks=%u unalloc=%u flags=0x%x error=%d\n",
+		    phase, event, (unsigned int)cp->c_fileid, (unsigned int)cp->c_desc.cd_cnid,
+		    i ? 255u : 0u, (unsigned long long)ff->ff_size, ff->ff_blocks,
+		    ff->ff_unallocblocks, (unsigned int)cp->c_flag, error);
+		for (unsigned int j = 0; j < kHFSPlusExtentDensity; ++j) {
+			if (ff->ff_extents[j].blockCount)
+				printf("SWEET HFSDIAG: fork-extent n=%u fileid=%u fork=%u index=%u first=%u count=%u\n",
+				    event, (unsigned int)cp->c_fileid, i ? 255u : 0u, j,
+				    ff->ff_extents[j].startBlock, ff->ff_extents[j].blockCount);
+		}
+	}
+}
+#endif
 

@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * Dali marker protocol adapted from HackIOS UEFI-Dali PlatformLib.c
+ * 47e6a77614de29d44969b26d04455d48cdd3e9f1 and UniXNU-Dali
+ * d5120d8305c00ff8fccffb6990c1435d9974e95a DaliRecovery.h.
+ * A prepared record is intent, never proof of the reset cause or Fastboot.
+ */
+#ifndef DALI_FASTBOOT_RETURN_POLICY_H
+#define DALI_FASTBOOT_RETURN_POLICY_H
+#include <stdbool.h>
+#include <stdint.h>
+
+#define DALI_FB_FREQUENCY 13000000ULL
+#define DALI_FB_MARKER_OFFSET 0x24u
+#define DALI_FB_MASK 0x0fu
+#define DALI_FB_BOOTLOADER 3u
+#define DALI_FB_MAX_AFTER 1080u
+#define DALI_FB_MAX_LEASE 1140u
+#define DALI_FB_DRAIN_SECONDS 20u
+
+struct dali_fb_ops {
+    void *context;
+    uint32_t (*read)(void *, uint32_t);
+    void (*write)(void *, uint32_t, uint32_t);
+    void (*fence)(void *);
+    void (*record)(void *, const char *, uint32_t, uint32_t);
+    uint64_t (*now)(void *);
+    bool (*drain)(void *, uint64_t);
+    uint32_t (*reset)(void *);
+};
+
+struct dali_fb_state {
+    uint32_t phase, original, mode, length, after, lease;
+    uint64_t started, frequency;
+};
+/* phase: 0=off/unarmed, 1=armed, 2=claimed, 3=reset-returned,
+ * 4=readback/rollback failure, 5=drain/deadline unconfirmed (inherited WDT only).
+ */
+
+static inline bool
+dali_fb_contract_valid(uint64_t base, uint64_t size, uint32_t offset,
+    uint32_t mask, uint32_t value)
+{
+    return base == 0x1c010000ULL && size == 0x1000ULL &&
+           offset == DALI_FB_MARKER_OFFSET && mask == DALI_FB_MASK &&
+           value == DALI_FB_BOOTLOADER;
+}
+
+static inline bool
+dali_fb_parameters_valid(uint64_t frequency, unsigned int after, unsigned int lease)
+{
+    return frequency == DALI_FB_FREQUENCY && after >= 120 &&
+           after <= DALI_FB_MAX_AFTER && lease >= after + 60 &&
+           lease <= DALI_FB_MAX_LEASE;
+}
+
+static inline bool
+dali_fb_rollback(const struct dali_fb_ops *ops, uint32_t original)
+{
+    uint32_t current = ops->read(ops->context, DALI_FB_MARKER_OFFSET);
+    if (current == UINT32_MAX)
+        return false;
+    ops->write(ops->context, DALI_FB_MARKER_OFFSET,
+        (current & ~DALI_FB_MASK) | (original & DALI_FB_MASK));
+    ops->fence(ops->context);
+    current = ops->read(ops->context, DALI_FB_MARKER_OFFSET);
+    return current != UINT32_MAX && (current & DALI_FB_MASK) == (original & DALI_FB_MASK);
+}
+
+static inline bool
+dali_fb_arm(struct dali_fb_state *state, const struct dali_fb_ops *ops,
+    bool enabled, bool contract, uint64_t started, uint64_t frequency,
+    unsigned int after, unsigned int lease)
+{
+    if (!enabled || !contract || state->phase != 0 ||
+        !dali_fb_parameters_valid(frequency, after, lease) ||
+        started > UINT64_MAX - frequency * lease)
+        return false;
+    /* No MODE/LENGTH writes: the current 0x17d IRQ/dual state is preserved. */
+    uint32_t original = ops->read(ops->context, DALI_FB_MARKER_OFFSET);
+    uint32_t mode = ops->read(ops->context, 0);
+    uint32_t length = ops->read(ops->context, 4);
+    if (original == UINT32_MAX || mode == UINT32_MAX || length == UINT32_MAX ||
+        !(mode & 1u) || (original & DALI_FB_MASK) == DALI_FB_BOOTLOADER)
+        return false;
+    state->phase = 4; /* An attempted arm is never repeated in this boot. */
+    state->original = original;
+    uint32_t marker = (original & ~DALI_FB_MASK) | DALI_FB_BOOTLOADER;
+    ops->write(ops->context, DALI_FB_MARKER_OFFSET, marker);
+    ops->fence(ops->context);
+    if (ops->read(ops->context, DALI_FB_MARKER_OFFSET) != marker) {
+        bool restored = dali_fb_rollback(ops, original);
+        ops->record(ops->context, restored ? "arm-rollback" : "arm-rollback-failed", marker, mode);
+        return false;
+    }
+    state->mode = mode;
+    state->length = length;
+    state->started = started;
+    state->frequency = frequency;
+    state->after = after;
+    state->lease = lease;
+    state->phase = 1;
+    ops->record(ops->context, "armed", marker, mode);
+    return true;
+}
+
+static inline bool
+dali_fb_step(struct dali_fb_state *state, const struct dali_fb_ops *ops)
+{
+    if (state->phase != 1)
+        return false;
+    uint64_t now = ops->now(ops->context);
+    if (now < state->started || now - state->started < state->frequency * state->after)
+        return false;
+    state->phase = 2; /* The ordinary sampler is the sole caller; claim before callbacks. */
+    uint64_t latest = state->started + state->frequency * (state->lease - 10);
+    if (now >= latest || now > UINT64_MAX - state->frequency * DALI_FB_DRAIN_SECONDS) {
+        state->phase = 5;
+        ops->record(ops->context, "deadline-unconfirmed", state->original, state->mode);
+        return false;
+    }
+    uint64_t deadline = now + state->frequency * DALI_FB_DRAIN_SECONDS;
+    if (deadline > latest)
+        deadline = latest;
+    uint32_t marker = (state->original & ~DALI_FB_MASK) | DALI_FB_BOOTLOADER;
+    /* This intent must be included in the logger's subsequently published target. */
+    ops->record(ops->context, "prepared", marker, state->mode);
+    if (!ops->drain(ops->context, deadline)) {
+        state->phase = 5;
+        ops->record(ops->context, "drain-unconfirmed", marker, state->mode);
+        return false; /* Keep the marker for the unchanged, finite inherited WDT. */
+    }
+    now = ops->now(ops->context);
+    if (now < state->started || now >= deadline ||
+        ops->read(ops->context, DALI_FB_MARKER_OFFSET) != marker ||
+        ops->read(ops->context, 0) != state->mode ||
+        ops->read(ops->context, 4) != state->length) {
+        state->phase = 5;
+        ops->record(ops->context, "state-unconfirmed", marker, state->mode);
+        return false;
+    }
+    ops->fence(ops->context);
+    uint32_t result = ops->reset(ops->context); /* Success does not return. */
+    state->phase = 3;
+    ops->record(ops->context, "reset-returned", result, state->mode);
+    if (!dali_fb_rollback(ops, state->original)) {
+        state->phase = 4;
+        ops->record(ops->context, "return-rollback-failed", marker, state->mode);
+    }
+    return false; /* No returned call is reported as successful Fastboot. */
+}
+#endif

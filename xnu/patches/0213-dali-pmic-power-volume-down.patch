 void
+SweetHIDButtons::startDaliPMIC()
+{
+	int optIn = 0;
+	if (!PE_parse_boot_argn("dalipmickey", &optIn, sizeof(optIn)) || optIn != 1 ||
+	    gDaliPMICTimer) return;
+	auto root = IORegistryEntry::fromPath("IODeviceTree:/");
+	OSData *compatible = root ? OSDynamicCast(OSData, root->getProperty("compatible")) : NULL;
+	if (!compatible || !dali_volume_board_enabled(optIn, compatible->getBytesNoCopy(),
+	    compatible->getLength())) {
+		IOLog("DALI PMIC KEYS: board identity unavailable; input disabled\n");
+		return;
+	}
+	uint32_t pmifStatus = 0;
+	if (!dali_pmif_init(0x1c01a000ULL, 0x900)) {
+		IOLog("DALI PMIC KEYS: shared PMIF unavailable\n");
+		return;
+	}
+	gDaliPMICTimer = IOTimerEventSource::timerEventSource(this,
+	    &SweetHIDButtons::daliPMICFired);
+	if (!gDaliPMICTimer || !_hidWorkLoop ||
+	    _hidWorkLoop->addEventSource(gDaliPMICTimer) != kIOReturnSuccess) {
+		OSSafeReleaseNULL(gDaliPMICTimer);
+		IOLog("DALI PMIC KEYS: timer unavailable\n");
+		return;
+	}
+	gDaliPMICTimerAdded = true;
+	if (!dali_pmif_pmic_keys_enable(&pmifStatus)) {
+		_hidWorkLoop->removeEventSource(gDaliPMICTimer);
+		gDaliPMICTimerAdded = false;
+		OSSafeReleaseNULL(gDaliPMICTimer);
+		IOLog("DALI PMIC KEYS: key IRQ enable failed PMIF=0x%x\n", pmifStatus);
+		return;
+	}
+	gDaliPMICEnabled = true;
+	gDaliPMICKeyState[0] = gDaliPMICKeyState[1] = -1;
+	gDaliPMICRunning = true;
+	IOLog("DALI PMIC KEYS: press/release polling enabled; shared foreign IRQ bits preserved\n");
+	gDaliPMICTimer->setTimeoutMS(16);
+}
+
+void
+SweetHIDButtons::daliPMICFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDButtons *self = OSDynamicCast(SweetHIDButtons, owner);
+	if (!self || !gDaliPMICRunning) return;
+	if (!self->daliVolumeHasClient()) {
+		sender->setTimeoutMS(16);
+		return;
+	}
+
+	uint8_t pending = 0;
+	uint32_t pmifStatus = 0;
+	bool ok = dali_pmif_pmic_keys_poll(&pending, &pmifStatus);
+	if (pending) {
+		DaliPmicKeyEvent events[4];
+		unsigned char ambiguous = 0;
+		unsigned count = dali_pmic_key_decode(pending, events, &ambiguous);
+		if (ambiguous) {
+			IOLog("DALI PMIC KEYS: coalesced press/release; final physical state unknown mask=0x%x\n",
+			    ambiguous);
+			for (unsigned key = 0; key < 2; ++key) {
+				if (!(ambiguous & (1U << key))) continue;
+				if (gDaliPMICKeyState[key] == 1) {
+					UInt32 usage = key == 0 ? kHIDUsage_Csmr_Power :
+					    kHIDUsage_Csmr_VolumeDecrement;
+					if (!self->key(usage, false)) continue;
+				}
+				gDaliPMICKeyState[key] = -1;
+			}
+		}
+		for (unsigned i = 0; i < count; ++i) {
+			unsigned key = events[i].sweetKey == 0 ? 0 : 1;
+			UInt32 usage = key == 0 ? kHIDUsage_Csmr_Power :
+			    kHIDUsage_Csmr_VolumeDecrement;
+			if (events[i].down) {
+				if (gDaliPMICKeyState[key] != 1 && self->key(usage, true))
+					gDaliPMICKeyState[key] = 1;
+			} else if (gDaliPMICKeyState[key] == 1) {
+				if (self->key(usage, false)) gDaliPMICKeyState[key] = 0;
+			} else {
+				gDaliPMICKeyState[key] = 0;
+			}
+		}
+	}
+	if (!ok) {
+		gDaliPMICRunning = false;
+		for (unsigned key = 0; key < 2; ++key) {
+			if (gDaliPMICKeyState[key] == 1) {
+				UInt32 usage = key == 0 ? kHIDUsage_Csmr_Power :
+				    kHIDUsage_Csmr_VolumeDecrement;
+				(void)self->key(usage, false);
+			}
+			gDaliPMICKeyState[key] = -1;
+		}
+		IOLog("DALI PMIC KEYS: PMIF poll/ack failed; polling stopped status=0x%x\n",
+		    pmifStatus);
+		return;
+	}
+	sender->setTimeoutMS(16);
+}
+
+IOReturn
+SweetHIDButtons::daliPMICStopAction(OSObject *owner, void *, void *, void *, void *)
+{
+	SweetHIDButtons *self = OSDynamicCast(SweetHIDButtons, owner);
+	if (!self) return kIOReturnBadArgument;
+	gDaliPMICRunning = false;
+	if (gDaliPMICTimer) {
+		gDaliPMICTimer->cancelTimeout();
+		gDaliPMICTimer->disable();
+	}
+	for (unsigned key = 0; key < 2; ++key) {
+		if (gDaliPMICKeyState[key] == 1) {
+			UInt32 usage = key == 0 ? kHIDUsage_Csmr_Power :
+			    kHIDUsage_Csmr_VolumeDecrement;
+			(void)self->key(usage, false);
+		}
+		gDaliPMICKeyState[key] = -1;
+	}
+	return kIOReturnSuccess;
+}
+
+void
+SweetHIDButtons::stopDaliPMIC()
+{
+	if (_hidWorkLoop && gDaliPMICTimerAdded) {
+		(void)_hidWorkLoop->runAction(&SweetHIDButtons::daliPMICStopAction, this);
+		_hidWorkLoop->removeEventSource(gDaliPMICTimer);
+		gDaliPMICTimerAdded = false;
+	}
+	OSSafeReleaseNULL(gDaliPMICTimer);
+	if (gDaliPMICEnabled) {
+		uint32_t pmifStatus = 0;
+		(void)dali_pmif_pmic_keys_disable(&pmifStatus);
+		gDaliPMICEnabled = false;
+	}
+	gDaliPMICRunning = false;
+}

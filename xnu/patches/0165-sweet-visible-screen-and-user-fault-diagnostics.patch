diff --git a/bsd/dev/SweetFeatureFault.h b/bsd/dev/SweetFeatureFault.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/SweetFeatureFault.h
@@ -0,0 +1,37 @@
+/* Fixed-size user-abort breadcrumbs; no user-memory access. */
+#ifndef SWEET_FEATURE_FAULT_H
+#define SWEET_FEATURE_FAULT_H
+
+#define SWEET_FF_FAULT_LIMIT 4096u
+struct sweet_ff_fault_event {
+    uint32_t seq, phase, esr;
+    int32_t pid, result;
+    uint64_t tid, pc, lr, sp, far;
+};
+
+/* Serialized by the nonblocking observer guard. */
+static inline bool
+sweet_ff_fault_record(struct sweet_ff_fault_event *last,
+    const struct sweet_ff_fault_event *event)
+{
+    if (last->seq >= SWEET_FF_FAULT_LIMIT)
+        return false;
+    uint32_t seq = last->seq + 1;
+    *last = *event;
+    last->seq = seq;
+    return true;
+}
+
+static inline int
+sweet_ff_fault_format(char *buffer, unsigned int bytes,
+    const struct sweet_ff_fault_event *event)
+{
+    int size = snprintf(buffer, bytes,
+        "SWEET FFFAULT: n=%u phase=%u pid=%d tid=%llu esr=0x%x "
+        "far=0x%llx pc=0x%llx lr=0x%llx sp=0x%llx result=%d\n",
+        event->seq, event->phase, event->pid, (unsigned long long)event->tid,
+        event->esr, (unsigned long long)event->far, (unsigned long long)event->pc,
+        (unsigned long long)event->lr, (unsigned long long)event->sp, event->result);
+    return size > 0 && (unsigned int)size < bytes ? size : 0;
+}
+#endif

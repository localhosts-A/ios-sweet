--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -6881,7 +6881,10 @@
 pmap_sync_page_attributes_phys(
 	ppnum_t pp)
 {
-	flush_dcache((vm_offset_t) (pp << PAGE_SHIFT), PAGE_SIZE, TRUE);
+	/* ppnum_t is 32-bit: widen before shifting so cache-attribute changes
+	 * preserve RAM addresses above 4 GiB (Dali's managed RAM starts at 8 GiB).
+	 */
+	flush_dcache((vm_offset_t) ptoa_64(pp), PAGE_SIZE, TRUE);
 }
 
 #if CONFIG_COREDUMP

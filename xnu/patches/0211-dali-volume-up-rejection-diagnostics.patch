+SweetHIDButtons::daliVolumeReadPinStatus(UInt32 *mode, UInt32 *dir, UInt32 *ies,
+    bool *gpioReadable, bool *iesReadable)
+{
+	*mode = *dir = *ies = 0;
+	*gpioReadable = fDaliGpioMap && fDaliGpioMap->getVirtualAddress();
+	*iesReadable = fDaliIesMap && fDaliIesMap->getVirtualAddress();
+	UInt32 rejects = 0;
+	if (!*gpioReadable) {
+		rejects |= kDaliVolumeRejectGpioMap;
+	} else {
+		*mode = daliVolumeRead(fDaliGpioMap, 0x370);
+		*dir = daliVolumeRead(fDaliGpioMap, 0x10);
+		if (((*mode >> 16) & 0xfU) != 0)
+			rejects |= DALI_VOLUME_PIN_MODE_INVALID;
+		if (*dir & (1U << 28))
+			rejects |= DALI_VOLUME_PIN_DIRECTION_OUTPUT;
+	}
+	if (!*iesReadable) {
+		rejects |= kDaliVolumeRejectIesMap;
+	} else {
+		*ies = daliVolumeRead(fDaliIesMap, 0x70);
+		if (!(*ies & (1U << 19)))
+			rejects |= DALI_VOLUME_PIN_IES_DISABLED;
+	}
+	return rejects;
+}

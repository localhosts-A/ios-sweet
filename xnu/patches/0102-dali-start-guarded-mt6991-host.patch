+bool setResources(WriteMapping &ip, uint32_t saved, bool on) {
+    constexpr uint32_t requestMask = 0x5f; /* MTU3 v2: SRC/INFRA/APSRC/VRF18/EMI */
+    uint32_t value = ip.read(0xe0);
+    if (value == ~0U) { return false; }
+    value = (value & ~requestMask) | (on ? requestMask : (saved & requestMask));
+    ip.write(0xe0, value);
+    uint32_t expected = on ? requestMask : (saved & requestMask);
+    return waitBits(ip, 0xe8, requestMask, expected, 200, 100);
+}

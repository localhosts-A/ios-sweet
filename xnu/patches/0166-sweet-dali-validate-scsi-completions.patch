diff --git a/bsd/dev/SweetUFSCompletion.h b/bsd/dev/SweetUFSCompletion.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/SweetUFSCompletion.h
@@ -0,0 +1,41 @@
+/* Completion checks for Dali's serialized, fixed-length block I/O. */
+#ifndef SWEET_UFS_COMPLETION_H
+#define SWEET_UFS_COMPLETION_H
+
+enum sweet_ufs_response_result {
+    SWEET_UFS_RESPONSE_OK = 0,
+    SWEET_UFS_RESPONSE_INVALID,
+    SWEET_UFS_RESPONSE_IDENTITY,
+    SWEET_UFS_RESPONSE_INCOMPLETE,
+};
+
+/* OCS is checked by the caller; non-GOOD SCSI status uses existing sense logic. */
+static inline enum sweet_ufs_response_result
+sweet_ufs_check_response(const uint8_t *response, uint32_t size,
+    uint8_t lun, uint8_t tag, uint8_t opcode)
+{
+    if (response == NULL || size < 16 || response[0] != 0x21)
+        return SWEET_UFS_RESPONSE_INVALID;
+    if (response[2] != lun || response[3] != tag)
+        return SWEET_UFS_RESPONSE_IDENTITY;
+    if (response[6] != 0 || response[7] != 0)
+        return SWEET_UFS_RESPONSE_OK;
+    /* INQUIRY and other variable-length commands retain their existing policy. */
+    if (opcode == 0x28 || opcode == 0x2a || opcode == 0x25) {
+        uint32_t residual = ((uint32_t)response[12] << 24) |
+            ((uint32_t)response[13] << 16) | ((uint32_t)response[14] << 8) |
+            (uint32_t)response[15];
+        /* Response flags: overflow=0x40, underflow=0x20. */
+        if ((response[1] & 0x60u) != 0 || residual != 0)
+            return SWEET_UFS_RESPONSE_INCOMPLETE;
+    }
+    return SWEET_UFS_RESPONSE_OK;
+}
+
+static inline bool
+sweet_ufs_response_desynchronized(enum sweet_ufs_response_result result)
+{
+    return result == SWEET_UFS_RESPONSE_INVALID ||
+           result == SWEET_UFS_RESPONSE_IDENTITY;
+}
+#endif

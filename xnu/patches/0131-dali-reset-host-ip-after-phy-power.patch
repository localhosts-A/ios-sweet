 bool hostStillHalted(const WriteMapping &ip, const ReadMapping &xhci, unsigned op) {
     uint32_t s1 = ip.read(0x10), s2 = ip.read(0x14), status = xhci.read(op + 4);
     return s1 != ~0U && s2 != ~0U && (s1 & 0xd01U) == 0xd01U && (s2 & 1U) &&
         xhci.read(op) == 0 && status != ~0U && (status & 0x801U) == 1U;
+}
+
+/* Native switch_port_to_on powers the PHY, applies host mode, then pulses
+ * ssusb_ip_sw_reset before enabling the host ports. Repeat that MAC-only IP
+ * reset here: earlier platform clock startup occurred before PHY power-on.
+ * No DMA may be published. Preserve the owned IPPC controls, source lease and
+ * PHY state; the existing shutdown path restores the full firmware handoff.
+ */
+bool resetHostAfterPhy(WriteMapping &ip, const ReadMapping &xhci, unsigned op,
+    uint32_t u2Host, uint32_t u3Host) {
+    uint32_t ctrl0 = ip.read(0), ctrl1 = ip.read(4), ctrl2 = ip.read(8);
+    if (!hostStillHalted(ip, xhci, op) || ctrl0 != 0x10411020U || ctrl1 != 0 ||
+        ctrl2 != 1 || ip.read(0x50) != u2Host || ip.read(0x30) != u3Host) {
+        u2Log("DALI MTU3: post-PHY reset entry rejected; no reset\n");
+        return false;
+    }
+    /* Match the native disabled-port -> IP reset -> host-enable order. */
+    ip.write(0x50, u2Host | 3U);
+    ip.write(0x30, u3Host | 3U);
+    bool disabled = ip.read(0x50) == (u2Host | 3U) &&
+        ip.read(0x30) == (u3Host | 3U);
+    if (!disabled) {
+        /* No reset happened; restore port controls before cleanup. */
+        ip.write(0x30, u3Host); ip.write(0x50, u2Host);
+        u2Log("DALI MTU3: post-PHY reset port-disable failed\n");
+        return false;
+    }
+    ip.write(0, ctrl0 | 1U);
+    IODelay(1); /* Native SSUSB_IP_SW_RST pulse. */
+    ip.write(0, ctrl0);
+    ip.write(8, ctrl2); /* Device IP stays powered down. */
+    ip.write(4, ctrl1); /* Host IP stays powered. */
+    ip.write(0x30, u3Host);
+    ip.write(0x50, u2Host);
+    bool controls = ip.read(0) == ctrl0 && ip.read(4) == ctrl1 &&
+        ip.read(8) == ctrl2 && ip.read(0x30) == u3Host && ip.read(0x50) == u2Host;
+    bool clocks = controls && waitBits(ip, 0x10, kMtu3U3ClockMask | 0xd01U,
+        kMtu3U3ClockMask | 0xd01U, 200, 100) && waitBits(ip, 0x14, 1U, 1U, 200, 100);
+    bool halted = false;
+    for (unsigned n = 0; clocks && n < 200; ++n) {
+        if (hostStillHalted(ip, xhci, op)) { halted = true; break; }
+        IODelay(100);
+    }
+    u2Log("DALI MTU3: post-PHY IP reset ready=%u controls=%u clocks=%u halted=%u\n",
+        controls && clocks && halted, controls, clocks, halted);
+    return controls && clocks && halted;
 }
 

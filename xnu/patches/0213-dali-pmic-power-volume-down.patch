--- /dev/null
+++ b/iokit/Kernel/arm/hid/DaliPmicKeyBackend.h
@@ -0,0 +1,101 @@
+/* MT6363 key status protocol shared by XNU and its host test. */
+#ifndef DALI_PMIC_KEY_BACKEND_H
+#define DALI_PMIC_KEY_BACKEND_H
+
+struct DaliPmicKeyEvent {
+    int sweetKey; /* sweet_hid_key: 0 power, 2 volume down */
+    bool down;
+};
+
+static constexpr unsigned DALI_PMIC_IRQ_POWER_PRESS = 48;
+static constexpr unsigned DALI_PMIC_IRQ_DOWN_PRESS = 49;
+static constexpr unsigned DALI_PMIC_IRQ_POWER_RELEASE = 51;
+static constexpr unsigned DALI_PMIC_IRQ_DOWN_RELEASE = 52;
+static constexpr unsigned short DALI_PMIC_TOP_IRQ_STATUS = 0x004e;
+static constexpr unsigned short DALI_PMIC_TOP_RCS_CLEAR = 0x041b;
+static constexpr unsigned short DALI_PMIC_IRQ_ENABLE0 = 0x090f;
+static constexpr unsigned short DALI_PMIC_IRQ_STATUS0 = 0x091b;
+static constexpr unsigned short DALI_PMIC_IRQ_STATUS1 = 0x091c;
+static constexpr unsigned char DALI_PMIC_KEY_MASK = 0x1b;
+static constexpr unsigned char DALI_PMIC_TOP_KEY_GROUP = 0x04; /* top_bit=2 */
+
+typedef bool (*DaliPmicReadByte)(void *context, unsigned short address,
+    unsigned char *value);
+typedef bool (*DaliPmicWriteByte)(void *context, unsigned short address,
+    unsigned char value);
+
+static inline bool dali_pmic_key_event(unsigned hwirq, DaliPmicKeyEvent *event)
+{
+    if (!event) return false;
+    switch (hwirq) {
+    case DALI_PMIC_IRQ_POWER_PRESS: *event = {0, true}; return true;
+    case DALI_PMIC_IRQ_DOWN_PRESS: *event = {2, true}; return true;
+    case DALI_PMIC_IRQ_POWER_RELEASE: *event = {0, false}; return true;
+    case DALI_PMIC_IRQ_DOWN_RELEASE: *event = {2, false}; return true;
+    default: return false;
+    }
+}
+
+static inline bool dali_pmic_keys_set_enabled(DaliPmicReadByte read,
+    DaliPmicWriteByte write, void *context, bool enabled)
+{
+    unsigned char value = 0;
+    if (!read || !write || !read(context, DALI_PMIC_IRQ_ENABLE0, &value)) return false;
+    unsigned char next = enabled ? value | DALI_PMIC_KEY_MASK :
+        value & (unsigned char)~DALI_PMIC_KEY_MASK;
+    return next == value || write(context, DALI_PMIC_IRQ_ENABLE0, next);
+}
+
+/* Keep one PMIF lock from top-status snapshot through key-only W1C/RCS clear.
+ * Foreign bits remain set; global RCS is cleared only when this is the sole
+ * pending top group and both PSC status banks contain no foreign events.
+ * If the final RCS write fails, pending still reports already-cleared keys.
+ */
+static inline bool dali_pmic_keys_poll(DaliPmicReadByte read,
+    DaliPmicWriteByte write, void *context, unsigned char *pending)
+{
+    if (!pending) return false;
+    *pending = 0;
+    if (!read || !write) return false;
+
+    unsigned char top = 0, status0 = 0, status1 = 0;
+    if (!read(context, DALI_PMIC_TOP_IRQ_STATUS, &top)) return false;
+    if (!(top & DALI_PMIC_TOP_KEY_GROUP)) return true;
+    if (!read(context, DALI_PMIC_IRQ_STATUS0, &status0) ||
+        !read(context, DALI_PMIC_IRQ_STATUS1, &status1)) return false;
+
+    unsigned char keys = status0 & DALI_PMIC_KEY_MASK;
+    if (!keys) return true;
+    if (!write(context, DALI_PMIC_IRQ_STATUS0, keys)) return false;
+    *pending = keys;
+
+    if (top == DALI_PMIC_TOP_KEY_GROUP &&
+        !(status0 & (unsigned char)~DALI_PMIC_KEY_MASK) && !status1) {
+        return write(context, DALI_PMIC_TOP_RCS_CLEAR, 1);
+    }
+    return true;
+}
+
+/* Same-key press+release latched together has no recoverable ordering/state. */
+static inline unsigned dali_pmic_key_decode(unsigned char status,
+    DaliPmicKeyEvent events[4], unsigned char *ambiguousKeys)
+{
+    unsigned char ambiguous = 0;
+    if ((status & 0x01) && (status & 0x08)) ambiguous |= 0x01;
+    if ((status & 0x02) && (status & 0x10)) ambiguous |= 0x02;
+    if (ambiguousKeys) *ambiguousKeys = ambiguous;
+    if (!events) return 0;
+
+    unsigned count = 0;
+    if (!(ambiguous & 0x01) && (status & 0x01))
+        (void)dali_pmic_key_event(DALI_PMIC_IRQ_POWER_PRESS, &events[count++]);
+    if (!(ambiguous & 0x02) && (status & 0x02))
+        (void)dali_pmic_key_event(DALI_PMIC_IRQ_DOWN_PRESS, &events[count++]);
+    if (!(ambiguous & 0x01) && (status & 0x08))
+        (void)dali_pmic_key_event(DALI_PMIC_IRQ_POWER_RELEASE, &events[count++]);
+    if (!(ambiguous & 0x02) && (status & 0x10))
+        (void)dali_pmic_key_event(DALI_PMIC_IRQ_DOWN_RELEASE, &events[count++]);
+    return count;
+}
+
+#endif

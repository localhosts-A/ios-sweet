diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -1,266 +1,385 @@
 /*
  * SWEET process sampler: where is a daemon stuck?
  *
  * The phone has no debugger and daemons log nowhere readable. Every
  * interval a kernel thread prints, for each process named in boot-arg
  * sweetsample (comma separated, default "SpringBoard,backboardd"; "-" = off)
  * and for each of its threads, the user pc/lr/sp and a frame-pointer
  * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
  * shared region slide and the main binary's mach header, to symbolicate
  * with tools/sweet-crash.py). A thread blocked in a syscall shows the
  * syscall stub in pc and its caller in lr/bt.
  *
  * Sampling delay and period are configurable in seconds (1..3600) for a bounded
  * user stack trace when a selected service stops making progress.
  */
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <sys/proc.h>
 #include <sys/proc_internal.h>
 #include <kern/task.h>
 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
 
 
 #if DEVELOPMENT && defined(ARM64_BOARD_CONFIG_SWEET)
 #include <arm64/proc_reg.h>
 #include <libkern/OSAtomic.h>
 #include "SweetFeatureTrace.h"
 
 static unsigned int sweet_ff_enabled;
 static volatile UInt32 sweet_ff_guard, sweet_ff_dropped;
 static struct sweet_ff_ring sweet_ff_events;
 
+#include <kern/clock.h>
+#include "SweetBackboardPCPolicy.h"
+
+static volatile UInt32 sweet_bbpc_configured, sweet_bbpc_active;
+static volatile UInt32 sweet_bbpc_guard, sweet_bbpc_dropped;
+static uint64_t sweet_bbpc_interval;
+static struct sweet_bbpc_buffer sweet_bbpc_events;
+
+void sweet_bbpc_trace(struct arm_saved_state *, struct arm_saved_state *, unsigned int);
+
+/* Single CAS loads use the public OSAtomic acquire/release contract, not volatile. */
+static bool
+sweet_bbpc_is_configured(void)
+{
+    return OSCompareAndSwap(1, 1, &sweet_bbpc_configured);
+}
+
+/* Called only in normal startup; IRQ admission remains off until the consumer starts. */
+static void
+sweet_bbpc_prepare(unsigned int requested)
+{
+    if (requested != 1 || sweet_ff_enabled != 3)
+        return;
+    uint64_t ticks = 0, ns = 0;
+    nanoseconds_to_absolutetime(SWEET_BBPC_INTERVAL_NS, &ticks);
+    absolutetime_to_nanoseconds(ticks, &ns);
+    ticks = sweet_bbpc_ceil_ticks(ticks, ns);
+    if (ticks == 0)
+        return;
+    absolutetime_to_nanoseconds(ticks, &ns);
+    if (ns < SWEET_BBPC_INTERVAL_NS)
+        return;
+    sweet_bbpc_interval = ticks;
+    (void)OSCompareAndSwap(0, 1, &sweet_bbpc_configured);
+}
+
+static void
+sweet_bbpc_begin(void)
+{
+    if (sweet_bbpc_is_configured()) {
+        (void)OSCompareAndSwap(0, 1, &sweet_bbpc_active);
+        printf("SWEET BBPC CONFIG: source=gic-vtimer-el0 interval=30s limit=40 interval_abs=0x%llx\n",
+            (unsigned long long)sweet_bbpc_interval);
+    }
+}
+
+/* Only the proven SWEET GIC timer branch supplies this IRQ's published frame. */
+void
+sweet_bbpc_trace(struct arm_saved_state *state, struct arm_saved_state *published,
+    unsigned int cpu)
+{
+    if (!OSCompareAndSwap(1, 1, &sweet_bbpc_active) || state == NULL ||
+        state != published || !is_saved_state64(state) ||
+        !PSR64_IS_USER64(get_saved_state_cpsr(state)))
+        return;
+    proc_t p = current_proc();
+    if (p == PROC_NULL || !sweet_ff_target(3, p->p_comm))
+        return;
+    if (!OSCompareAndSwap(0, 1, &sweet_bbpc_guard)) {
+        (void)OSCompareAndSwap(0, 1, &sweet_bbpc_dropped);
+        return;
+    }
+    if (OSCompareAndSwap(1, 1, &sweet_bbpc_active)) {
+        struct sweet_bbpc_event event = {
+            .cpu = cpu, .cpsr = get_saved_state_cpsr(state), .pid = proc_pid(p),
+            .tid = thread_tid(current_thread()), .pc = get_saved_state_pc(state),
+            .lr = get_saved_state_lr(state), .sp = get_saved_state_sp(state),
+            .abstime = mach_absolute_time(),
+        };
+        (void)sweet_bbpc_record(&sweet_bbpc_events, sweet_bbpc_interval, &event);
+        if (sweet_bbpc_events.clock_stopped || sweet_bbpc_events.total >= SWEET_BBPC_LIMIT)
+            (void)OSCompareAndSwap(1, 0, &sweet_bbpc_active);
+    }
+    (void)OSCompareAndSwap(1, 0, &sweet_bbpc_guard);
+}
+
+/* No IRQ output. The existing normal consumer owns this static snapshot. */
+static void
+sweet_bbpc_dump(unsigned int sample)
+{
+    static struct sweet_bbpc_event snapshot[SWEET_BBPC_LIMIT];
+    if (!sweet_bbpc_is_configured())
+        return;
+    if (sample == 39)
+        (void)OSCompareAndSwap(1, 0, &sweet_bbpc_active);
+    if (!OSCompareAndSwap(0, 1, &sweet_bbpc_guard)) {
+        printf("SWEET BBPC: sample=%u busy=1 final=%u; snapshot incomplete\n", sample, sample == 39);
+        return;
+    }
+    uint32_t count = sweet_bbpc_snapshot(&sweet_bbpc_events, snapshot);
+    uint32_t total = sweet_bbpc_events.total;
+    bool stopped = sweet_bbpc_events.clock_stopped;
+    bool dropped = OSCompareAndSwap(1, 0, &sweet_bbpc_dropped);
+    (void)OSCompareAndSwap(1, 0, &sweet_bbpc_guard);
+    printf("SWEET BBPC: sample=%u count=%u accepted=%u busy_drop=%u clock_stop=%u final=%u\n",
+        sample, count, total, dropped, stopped, sample == 39);
+    for (uint32_t i = 0; i < count; ++i) {
+        const struct sweet_bbpc_event *e = &snapshot[i];
+        printf("SWEET BBPC: n=%u source=gic-vtimer-el0 pid=%d tid=%llu cpu=%u "
+            "abs=0x%llx pc=0x%llx lr=0x%llx sp=0x%llx cpsr=0x%x\n",
+            e->seq, e->pid, (unsigned long long)e->tid, e->cpu,
+            (unsigned long long)e->abstime, (unsigned long long)e->pc,
+            (unsigned long long)e->lr, (unsigned long long)e->sp, e->cpsr);
+    }
+}
+
+
 void sweet_ff_trace(unsigned int, int, struct arm_saved_state *);
 
 /* Current-thread state only: no user-memory reads or process iteration. */
 void
 sweet_ff_trace(unsigned int phase, int call, struct arm_saved_state *state)
 {
     if (!sweet_ff_svc_mode(sweet_ff_enabled))
         return;
     proc_t p = current_proc();
     if (p == PROC_NULL || !sweet_ff_target(sweet_ff_enabled, p->p_comm) ||
         !is_saved_state64(state))
         return;
     if (!OSCompareAndSwap(0, 1, &sweet_ff_guard)) {
         (void)OSCompareAndSwap(0, 1, &sweet_ff_dropped);
         return;
     }
     struct sweet_ff_event event = {
         .phase = phase, .pid = proc_pid(p), .call = call,
         .tid = thread_tid(current_thread()),
         .pc = get_saved_state_pc(state), .lr = get_saved_state_lr(state),
         .sp = get_saved_state_sp(state), .x0 = get_saved_state_reg(state, 0),
         .cpsr = get_saved_state_cpsr(state),
     };
     (void)sweet_ff_record(&sweet_ff_events, &event);
     (void)OSCompareAndSwap(1, 0, &sweet_ff_guard);
 }
 
 
 #include "SweetFeatureFault.h"
 
 static unsigned int sweet_ff_screen_enabled, sweet_ff_fault_enabled;
 static volatile UInt32 sweet_ff_fault_dropped;
 static struct sweet_ff_fault_event sweet_ff_last_fault;
 extern int sweet_console_muted;
 extern void sweet_ramoops_append(const char *, int);
 void sweet_ff_fault_trace(unsigned int, struct arm_saved_state *, uint32_t, uint64_t, int);
 
 /* Pure retained-RAM breadcrumb: no printf, framebuffer, UFS or user copyin. */
 void
 sweet_ff_fault_trace(unsigned int phase, struct arm_saved_state *state,
     uint32_t esr, uint64_t far, int result)
 {
     if (!sweet_ff_mode(sweet_ff_fault_enabled))
         return;
     proc_t p = current_proc();
     if (p == PROC_NULL || !sweet_ff_target(sweet_ff_fault_enabled, p->p_comm) ||
         !is_saved_state64(state))
         return;
     if (!OSCompareAndSwap(0, 1, &sweet_ff_guard)) {
         (void)OSCompareAndSwap(0, 1, &sweet_ff_fault_dropped);
         return;
     }
     struct sweet_ff_fault_event event = {
         .phase = phase, .esr = esr, .pid = proc_pid(p), .result = result,
         .tid = thread_tid(current_thread()), .pc = get_saved_state_pc(state),
         .lr = get_saved_state_lr(state), .sp = get_saved_state_sp(state), .far = far,
     };
     bool accepted = sweet_ff_fault_record(&sweet_ff_last_fault, &event);
     event.seq = sweet_ff_last_fault.seq;
     (void)OSCompareAndSwap(1, 0, &sweet_ff_guard);
     if (!accepted)
         return;
     char line[256];
     int size = sweet_ff_fault_format(line, sizeof(line), &event);
     if (size != 0)
         sweet_ramoops_append(line, size);
 }
 
 /* Called only from the normal sampler thread, after releasing producer locks. */
 static void
 sweet_ff_screen_dump(unsigned int sample)
 {
     if (sweet_ff_screen_enabled != 1)
         return;
     sweet_console_muted = 0;
     if (!OSCompareAndSwap(0, 1, &sweet_ff_guard)) {
         printf("SWEET SCREEN: tick=%u observer-busy; diagnostic, not desktop\n", sample);
         return;
     }
     uint32_t calls = sweet_ff_events.total;
     struct sweet_ff_event last_svc = {0};
     if (calls != 0)
         last_svc = sweet_ff_events.events[(calls - 1) % SWEET_FF_RECORDS];
     struct sweet_ff_fault_event fault = sweet_ff_last_fault;
     bool dropped = OSCompareAndSwap(1, 0, &sweet_ff_fault_dropped);
     (void)OSCompareAndSwap(1, 0, &sweet_ff_guard);
     printf("SWEET SCREEN: tick=%u calls=%u faults=%u lost=%u full=%u\n",
         sample, calls, fault.seq, dropped ? 1u : 0u,
         fault.seq == SWEET_FF_FAULT_LIMIT ? 1u : 0u);
     printf("SWEET SCREEN: last-call=%d phase=%u pc=0x%llx\n",
         last_svc.call, last_svc.phase, (unsigned long long)last_svc.pc);
     printf("SWEET SCREEN: last-fault phase=%u pc=0x%llx esr=0x%x result=%d\n",
         fault.phase, (unsigned long long)fault.pc, fault.esr, fault.result);
 }
 

+/* Standard parent INIT only, not the separate enable-free-run START. Actual
+ * MT6991 DT has flag=0/vmode=0; these are x2/x3 and x4..x7 stay zero. The
+ * explicit property is consumed only by the already opt-in pre-root HS path.
+ * A usable configuration or nonzero known AP VCORE/DRAM/EMI request field is
+ * not reinitialized. Zero fields do not prove absent owners/global quiescence;
+ * this is an explicit managed bring-up attempt, not firmware-state detection.
+ */
+static int
+ufs_hs_firmware_prepare(bool enabled)
+{
+    if (dali_hs_platform.init_attempted) return EBUSY;
+    uint32_t basic = 0, count = 0, after_basic = 0, after_count = 0;
+    uint32_t request = 0, force = 0, halt = 0, target = 0;
+    bool before_valid = false, after_valid = false;
+    const char *action = "read-failed";
+    int error = ufs_hs_floor_read(NULL, HSF_BASIC_CONTROL, &basic);
+    if (!error) error = ufs_hs_floor_read(NULL, HSF_COUNT, &count);
+    if (error) goto out;
+    before_valid = true;
+    after_basic = basic;
+    after_count = count;
+    after_valid = true;
+    if (((basic >> 20) & 0x7fu) != 0 || !enabled) {
+        action = enabled ? "adopt-configured" : "init-disabled";
+        goto out;
+    }
+    action = "refuse-inconsistent-config";
+    if (count != 0) { error = EIO; goto out; }
+    action = "refuse-active-request";
+    if (ufs_hs_clock_ok(NULL) ||
+        ufs_hs_floor_read(NULL, HSF_REQUEST, &request) ||
+        ufs_hs_floor_read(NULL, HSF_FORCE_REQUEST, &force) ||
+        ufs_hs_floor_read(NULL, HSF_HALT, &halt) ||
+        ufs_hs_floor_read(NULL, HSF_TARGET, &target) ||
+        /* MT6991 SW_REQ: VCORE[6:4], DRAM[15:12], EMI[3:0]. */
+        (request & (HSF_REQUEST_MASK | 0xf000u | 0xfu)) ||
+        force || (halt & 2u) || (target & (1u << 16))) {
+        error = EIO;

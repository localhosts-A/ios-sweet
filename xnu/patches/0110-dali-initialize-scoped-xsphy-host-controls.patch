+/* SoC XSphy basic power/mode controls from the Dali vendor driver. Retain
+ * firmware efuse/eye trims and do not touch frequency-meter or repeater power.
+ * Every allowed field has a pre-write snapshot and exact masked rollback.
+ */
+class ScopedU2Phy {
+    struct Field { uint32_t offset, mask, saved; bool dirty; };
+    static constexpr uint32_t dtm0Mask = (1U << 26) | (1U << 23) | (0x1fU << 17) |
+        (0xfU << 10) | (3U << 6) | (3U << 4) | (1U << 3) | (1U << 2);
+    Field fields[9] = {
+        {0x000, 0xffffff00U, 0, false}, {0x004, 1U << 16, 0, false},
+        {0x300, (7U << 24) | (1U << 5), 0, false},
+        {0x310, 7U << 8, 0, false},
+        {0x318, (3U << 30) | (1U << 25) | (1U << 23) | (1U << 20), 0, false},
+        {0x344, 1U << 5, 0, false}, {0x364, 3U << 18, 0, false},
+        {0x368, dtm0Mask, 0, false},
+        {0x36c, (1U << 16) | (1U << 9) | (1U << 5) | (1U << 4) | 6U, 0, false}
+    };
+    WriteMapping phy;
+    bool saved = false;
+    bool change(uint32_t offset, uint32_t mask, uint32_t value) {
+        if (!saved) { return false; }
+        for (auto &field : fields) {
+            if (field.offset != offset) { continue; }
+            if (mask & ~field.mask) { return false; }
+            uint32_t before = phy.read(offset);
+            if (before == ~0U) { return false; }
+            field.dirty = true; /* Mark before a write that could partially succeed. */
+            phy.write(offset, (before & ~mask) | (value & mask));
+            uint32_t after = phy.read(offset);
+            bool ok = after != ~0U && (after & mask) == (value & mask);
+            if (!ok) { u2Log("DALI PHY: field write failed reg=%03x read=%08x\n", offset, after); }
+            return ok;
+        }
+        return false;
+    }
+public:
+    bool powerOn() {
+        if (!phy.open(0x16730000, 0x400)) { return false; }
+        for (auto &field : fields) {
+            field.saved = phy.read(field.offset);
+            if (field.saved == ~0U) { return false; }
+        }
+        if ((fields[7].saved & (1U << 26)) || (fields[8].saved & (1U << 16))) {
+            u2Log("DALI PHY: UART ownership rejected; untouched\n"); return false;
+        }
+        saved = true;
+        bool ok = change(0x318, 1U << 23, 0) && change(0x300, 1U << 5, 1U << 5);
+        ok = ok && change(0x344, 1U << 5, 1U << 5);
+        if (ok) { IODelay(250); }
+        /* Native FORCE_SUSPENDM pulse, then hand control back to the MAC. */
+        ok = ok && change(0x368, 1U << 18, 1U << 18) && change(0x368, 8, 0) &&
+            change(0x368, 8, 8);
+        if (ok) { IODelay(30); }
+        ok = ok && change(0x368, 1U << 18, 0) && change(0x368, 8, 0) &&
+            change(0x368, dtm0Mask, 0) && change(0x36c, 1U << 16, 0) &&
+            change(0x310, 3U << 8, 0) && change(0x318, (1U << 23) | (1U << 20), 1U << 20) &&
+            change(0x36c, (1U << 5) | (1U << 4) | 4U, (1U << 5) | 4U) &&
+            change(0x300, 7U << 24, 0) &&
+            change(0x318, (3U << 30) | (1U << 25), 1U << 30);
+        if (ok) { IODelay(800); }
+        /* Exact live-DT LPM PLL timings and FS_CR; no efuse/eye overwrite. */
+        ok = ok && change(0x364, 3U << 18, 1U << 18) &&
+            change(0x004, 1U << 16, 1U << 16) && change(0x000, 0xffffff00U, 0x1e1e1900U) &&
+            change(0x310, 7U << 8, 7U << 8) &&
+            change(0x36c, (1U << 9) | 2U, 1U << 9);
+        u2Log("DALI PHY: power/mode ready=%u dtm=%08x/%08x acr=%08x/%08x pll=%08x\n",
+            ok, phy.read(0x368), phy.read(0x36c), phy.read(0x300), phy.read(0x318), phy.read(0x364));
+        return ok;
+    }
+    bool restore() {
+        if (!saved) { return true; } /* Snapshot failed before any write. */
+        bool ok = true;
+        for (unsigned i = 9; i-- > 0;) {
+            auto &field = fields[i];
+            if (!field.dirty) { continue; }
+            uint32_t before = phy.read(field.offset);
+            if (before == ~0U) { ok = false; continue; }
+            phy.write(field.offset, (before & ~field.mask) | (field.saved & field.mask));
+            uint32_t after = phy.read(field.offset);
+            bool matched = after != ~0U && (after & field.mask) == (field.saved & field.mask);
+            if (!matched) { u2Log("DALI PHY: restore failed reg=%03x read=%08x\n", field.offset, after); }
+            ok = ok && matched;
+        }
+        u2Log("DALI PHY: owned controls restored=%u\n", ok);
+        return ok;
+    }
+};

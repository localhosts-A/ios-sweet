+#ifndef DALI_XHCI_H
+#define DALI_XHCI_H
+#include <stdint.h>
+#include <stddef.h>
+class IOBufferMemoryDescriptor;
+class IOMemoryMap;
+
+/* Single directly attached USB2 BOT device; serialized by the platform owner.
+ * The owner must validate physical DMA, clocks/PHY/VBUS and retain them until
+ * stop() succeeds. No IRQ, UAS, hubs, write commands or automatic bus retry.
+ */
+struct DaliXHCIOps {
+    void *cookie;
+    uint32_t (*read)(void *, unsigned);
+    void (*write)(void *, unsigned, uint32_t);
+    bool (*alive)(void *); /* source/clock/removal guard, must not reenter */
+    void (*log)(const char *, ...);
+};
+
+class DaliXHCI {
+    struct TRB { uint32_t lo, hi, status, control; };
+    struct Ring { unsigned offset, index, cycle; };
+    DaliXHCIOps ops{};
+    IOBufferMemoryDescriptor *memory = nullptr;
+    IOMemoryMap *arenaMap = nullptr;
+    uint8_t *bytes = nullptr;
+    uint64_t physical = 0, blockCount = 0;
+    uint32_t blockBytes = 0, tag = 0;
+    unsigned op = 0, runtime = 0, doors = 0, slot = 0, port = 0;
+    unsigned contextBytes = 0, eventIndex = 0, eventCycle = 1;
+    unsigned epIn = 0, epOut = 0, inPacket = 0, outPacket = 0, interface = 0;
+    unsigned operationBudgetMs = 0;
+    uint64_t startedMs = 0;
+    bool dmaPublished = false, running = false, faulted = false, configured = false;
+    bool prepared = false;
+    void fail() { __atomic_store_n(&faulted, true, __ATOMIC_RELEASE); }
+    Ring commandRing{0x1000, 0, 1}, controlRing{0x5000, 0, 1};
+    Ring inRing{0x6000, 0, 1}, outRing{0x7000, 0, 1};
+    uint32_t rd(unsigned) const;
+    void wr(unsigned, uint32_t) const;
+    void wr64(unsigned, uint64_t) const;
+    bool live();
+    bool wait(unsigned, uint32_t, uint32_t, unsigned);
+    bool nextEvent(TRB *, unsigned);
+    uint64_t submitTRB(Ring &, uint64_t, uint32_t, uint32_t, bool = true);
+    bool command(unsigned, uint64_t, uint32_t, uint32_t, unsigned * = nullptr);
+    bool completion(uint64_t, unsigned, bool, unsigned *, unsigned, uint64_t = 0);
+    bool control(uint8_t, uint8_t, uint16_t, uint16_t, void *, unsigned, unsigned * = nullptr);
+    bool bulk(bool, void *, unsigned, unsigned * = nullptr);
+    bool scsi(const uint8_t *, unsigned, void *, unsigned, bool * = nullptr);
+    bool allocate();
+    bool initialize(unsigned);
+    bool enumerate();
+    bool configureEndpoints(unsigned);
+    bool usb2Port(unsigned *);
+    bool readBlocks(uint64_t, unsigned, void *);
+public:
+    DaliXHCI() = default;
+    ~DaliXHCI();
+    DaliXHCI(const DaliXHCI &) = delete;
+    DaliXHCI &operator=(const DaliXHCI &) = delete;
+    bool start(const DaliXHCIOps &, unsigned maxMilliseconds = 10000);
+    bool stop(); /* False => pin DMA allocations/resources until reboot. */
+    bool read(uint64_t byteOffset, size_t length, void *destination);
+    bool findHFS(uint64_t *firstByte, uint64_t *length);
+    bool ready() const { return configured && !__atomic_load_n(&faulted, __ATOMIC_ACQUIRE); }
+    bool sourceHealthy() const { return ready() && ops.alive(ops.cookie); }
+    uint64_t capacity() const { return blockCount * blockBytes; }
+    uint32_t sectorSize() const { return blockBytes; }
+};
+#endif

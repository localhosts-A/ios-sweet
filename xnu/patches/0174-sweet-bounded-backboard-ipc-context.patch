 /* A scalar token, not an object/frame pointer, crosses the possibly blocking VM call. */
 uint32_t
 sweet_bbvm_enter(struct arm_saved_state *state, uint32_t esr, uint64_t far,
     uint64_t address, uint32_t prot)
 {
     if (!OSCompareAndSwap(1, 1, &sweet_bbvm_admit) || state == NULL ||
         !is_saved_state64(state) || !PSR64_IS_USER64(get_saved_state_cpsr(state)))
         return 0;
     proc_t p = current_proc();
     if (p == PROC_NULL || !sweet_ff_target(3, p->p_comm))
         return 0;
     if (!OSCompareAndSwap(0, 1, &sweet_bbvm_guard)) {
         (void)OSCompareAndSwap(0, 1, &sweet_bbvm_begin_busy);
         return 0;
     }
     uint32_t token = 0;
     if (OSCompareAndSwap(1, 1, &sweet_bbvm_open) &&
         OSCompareAndSwap(1, 1, &sweet_bbvm_admit)) {
         struct sweet_bbvm_event event = {
             .pid = proc_pid(p), .tid = thread_tid(current_thread()),
             .pc = get_saved_state_pc(state), .lr = get_saved_state_lr(state),
             .sp = get_saved_state_sp(state), .cpsr = get_saved_state_cpsr(state),
             .esr = esr, .far = far, .address = address, .prot = prot,
             .start = mach_absolute_time(),
         };
         token = sweet_bbvm_enter_record(&sweet_bbvm_events, sweet_bbvm_interval, &event);
         if (sweet_bbvm_events.clock_stopped || sweet_bbvm_events.total >= SWEET_BBVM_LIMIT)
             (void)OSCompareAndSwap(1, 0, &sweet_bbvm_admit);
     }
     (void)OSCompareAndSwap(1, 0, &sweet_bbvm_guard);
     return token;
 }
 
 void
 sweet_bbvm_leave(uint32_t token, int32_t result)
 {
     if (token == 0 || token > SWEET_BBVM_LIMIT || !OSCompareAndSwap(1, 1, &sweet_bbvm_open))
         return;
     if (!OSCompareAndSwap(0, 1, &sweet_bbvm_guard)) {
         (void)OSCompareAndSwap(0, 1, &sweet_bbvm_end_busy);
         return;
     }
     if (OSCompareAndSwap(1, 1, &sweet_bbvm_open)) {
         (void)sweet_bbvm_leave_record(&sweet_bbvm_events, token,
             thread_tid(current_thread()), mach_absolute_time(), result);
         if (sweet_bbvm_events.clock_stopped)
             (void)OSCompareAndSwap(1, 0, &sweet_bbvm_admit);
     }
     (void)OSCompareAndSwap(1, 0, &sweet_bbvm_guard);
 }
 

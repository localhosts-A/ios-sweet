+// ---- Apple's texture layout object ----
+// The `MTLTextureLayout` protocol; Apple's own is MTLIOAccelTextureLayout
+// (`-[MTLIOAccelTextureLayout initWithDevice:descriptor:]`, Metal.dis 0x181abbc0c).
+// QuartzCore asks for it in `CA::Render::new_mtl_texture_layout` (QuartzCore.dis
+// 0x1884ccc68), called from `CA::Render::CompressedImage::new_image_with_texture_data`
+// (0x18835864c) and `CA::Render::CompressedImage::decode` (0x18849d954): a compressed
+// image is decoded into host memory of `[layout size]` bytes aligned to
+// `[layout alignment]` (aligned_malloc at 0x188358b10), written level by level through
+// `copyFromLinearBytes:...` (0x188358b88, textureLevel advanced each turn), and handed
+// on. Both callers test the answer with `cbz x0` (0x188358c90, 0x18849db78): a nil
+// layout loses the whole decoded image.
+//
+// Every shape here is the runtime's own answer, never a guess: the row pitch and the
+// texel size come from `nmb_device_linear_bytes_per_row` (the device's format
+// description and linear alignment, `pixel_format_info.rs`), and the alignment is the
+// runtime's `LINEAR_ALIGNMENT` (16; `private_properties.rs`,
+// `deviceLinearTextureAlignmentBytes`). A format no linear image backs answers 0 there
+// and the layout is nil: the caller sees a failed decode, not a wrong image.
+@interface NBTextureLayout : NSObject
+@property(nonatomic) NSUInteger width,height,levels,rowPitch,texelBytes,byteSize,byteAlignment;
+@end
+@implementation NBTextureLayout
+- (NSUInteger)size {return _byteSize;}
+- (NSUInteger)alignment {return _byteAlignment;}
+// The decoded image is written through copyFromLinearBytes and the memory is the
+// caller's (aligned_malloc), so these two have nothing to do here.
+- (void)initializeTextureMemory:(void *)memory {(void)memory;}
+- (void)finalizeTextureMemory:(void *)memory {(void)memory;}
+- (void)copyFromLinearBytes:(const void *)bytes linearOffset:(NSUInteger)offset linearBytesPerRow:(NSUInteger)linearRow
+ linearBytesPerImage:(NSUInteger)linearImage toTextureMemory:(void *)memory textureSlice:(NSUInteger)slice
+ textureLevel:(NSUInteger)level textureRegion:(MTLRegion)region {
+ (void)linearImage;(void)slice;
+ if(!bytes||!memory||level>=_levels)return;
+ const uint8_t *src=(const uint8_t *)bytes+offset;
+ const NSUInteger lw=_width>>level?:(NSUInteger)1,lh=_height>>level?:(NSUInteger)1;
+ // The levels are packed inside the one allocation in order, each level's rows at the
+ // layout's row pitch; the copy lands at the level's start plus the region's origin.
+ uint64_t levelOffset=0;
+ for(NSUInteger i=0;i<level;i++)levelOffset+=(uint64_t)_rowPitch*((_height>>i)?(_height>>i):1);
+ const NSUInteger ox=region.origin.x,oy=region.origin.y;
+ // A zero-sized region means the whole level (the caller's own reads use this shape).
+ const NSUInteger tw=region.size.width?region.size.width:lw-(ox<lw?ox:0);
+ const NSUInteger th=region.size.height?region.size.height:lh-(oy<lh?oy:0);
+ if(ox>=lw||oy>=lh||!tw||!th)return;
+ const NSUInteger cols=MIN(tw,lw-ox),rows=MIN(th,lh-oy);
+ uint8_t *dst=(uint8_t *)memory+levelOffset+(uint64_t)oy*_rowPitch+(uint64_t)ox*_texelBytes;
+ const size_t span=(size_t)cols*_texelBytes;
+ for(NSUInteger y=0;y<rows;y++){memcpy(dst,src+(size_t)ox*_texelBytes,span);dst+=_rowPitch;src+=linearRow;}
+}
+@end
+// The layout for `d`: the row pitch is `requiredLinearTextureBytesPerRowForDescriptor:`'s
+// (the runtime's own linear row for the format and width); the texel size is that same
+// query at 1024 texels ("1024*texel" is a multiple of the 16-byte linear alignment for
+// every format with a texel size) divided back out; the size is the levels packed at the
+// row pitch. Nil where the format has no linear row: the caller sees a failed decode.
+static id makeTextureLayout(MTLTextureDescriptor *d,BOOL backed) {
+ if(!d)return nil;
+ const NSUInteger rows=d.height?d.height:1,cols=d.width?d.width:1;
+ const uint64_t pitch=nmb_device_linear_bytes_per_row(gDevice,d.pixelFormat,d.width);
+ if(!pitch){NBLOG(@"native-metal: texture layout refused: %@",lastError());return nil;}
+ const uint64_t wide=nmb_device_linear_bytes_per_row(gDevice,d.pixelFormat,1024);
+ const NSUInteger texel=wide?(NSUInteger)(wide/1024):4;
+ uint64_t size=0;const NSUInteger levels=d.mipmapLevelCount?d.mipmapLevelCount:1;
+ for(NSUInteger i=0;i<levels;i++)size+=(uint64_t)pitch*((rows>>i)?(rows>>i):1);
+ if(!size)size=pitch;
+ NBTextureLayout *layout=[NBTextureLayout new];
+ layout.width=cols;layout.height=rows;layout.levels=levels;layout.rowPitch=(NSUInteger)pitch;
+ layout.texelBytes=texel;layout.byteAlignment=16;layout.byteSize=(NSUInteger)size;
+ NBLOG(@"X9 TEXTURE layout: %lux%lu fmt=%lu levels=%lu row=%lu texel=%lu align=%lu size=%lu backed=%d",
+  (unsigned long)cols,(unsigned long)rows,(unsigned long)d.pixelFormat,(unsigned long)levels,
+  (unsigned long)layout.rowPitch,(unsigned long)texel,(unsigned long)layout.byteAlignment,
+  (unsigned long)layout.byteSize,(int)backed);
+ return layout;
+}

+bool waitBits(const WriteMapping &m, uint32_t offset, uint32_t mask,
+    uint32_t expected, unsigned tries, unsigned delayUs) {
+    for (unsigned i = 0; i < tries; ++i) {
+        if ((m.read(offset) & mask) == expected) { return true; }
+        IODelay(delayUs);
+    }
+    return false;

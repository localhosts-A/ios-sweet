--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -3096,6 +3096,52 @@
 #endif
 
 int print_vmpage_stat = 0;
+
+#if DEVELOPMENT && defined(ARM64_BOARD_CONFIG_SWEET)
+struct sweet_root_sync_pass {
+	int error;
+	unsigned int selected, attempted;
+};
+
+/* vfs_iterate owns an iterref; busy prevents unmount during the sync pass.
+ * This is not a freeze: writers can dirty buffers again, and HFS may skip a
+ * vnode internally. A returned zero is only the VFS operation's result.
+ */
+static int
+sweet_root_sync_callback(mount_t mp, void *context)
+{
+	struct sweet_root_sync_pass *pass = context;
+	if (!(vfs_flags(mp) & MNT_ROOTFS)) return VFS_RETURNED;
+	pass->selected++;
+	pass->error = vfs_busy(mp, LK_NOWAIT);
+	if (pass->error) return VFS_RETURNED_DONE;
+	char name[MFSNAMELEN] = {0};
+	vfs_name(mp, name);
+	if (strcmp(name, "hfs") != 0 ||
+	    (vfs_flags(mp) & (MNT_RDONLY | MNT_ASYNC))) {
+		pass->error = ENOTSUP;
+	} else {
+		pass->attempted++;
+		pass->error = VFS_SYNC(mp, MNT_WAIT, vfs_context_kernel());
+	}
+	vfs_unbusy(mp);
+	return VFS_RETURNED_DONE;
+}
+
+/* Called only by opted-in Dali return polling/drain in ordinary thread context,
+ * before logger drain and outside every project/UFS lock. No mount is retained.
+ */
+int
+sweet_fastboot_sync_root(void)
+{
+	struct sweet_root_sync_pass pass = {.error = ENOENT};
+	int error = vfs_iterate(0, sweet_root_sync_callback, &pass);
+	if (error) pass.error = error;
+	printf("SWEET ROOTSYNC: v=1 selected=%u attempted=%u result=%d scope=sync-pass-not-quiesced\n",
+	    pass.selected, pass.attempted, pass.error);
+	return pass.error;
+}
+#endif
 

+/* Mode 4 owns a separate retained lsd incarnation; never repurpose the GUI slots. */
+static uint32_t sweet_lsd_state; /* 0=unclaimed, 1=claiming, 2=ready */
+static struct sweet_load_slot sweet_lsd_slot;
+
+static void
+sweet_lsd_register(unsigned int phase, struct arm_saved_state *state)
+{
+    if (sweet_ff_enabled != 4 || !sweet_load_configured || phase != 0 ||
+        os_atomic_load(&sweet_lsd_state, acquire) != 0 ||
+        !sweet_load_admitting(os_atomic_load(&sweet_load_control, acquire)) ||
+        state == NULL || !is_saved_state64(state) ||
+        !PSR64_IS_USER64(get_saved_state_cpsr(state))) return;
+    proc_t p = current_proc();
+    if (p == PROC_NULL || !sweet_ff_target(4, p->p_comm)) return;
+    task_t task = current_task();
+    if (task == TASK_NULL || !os_atomic_cmpxchg(&sweet_lsd_state, 0u, 1u, acq_rel)) return;
+    task_reference(task);
+    struct proc_ident ident = proc_ident(p);
+    sweet_lsd_slot = (struct sweet_load_slot){
+        .task = task, .pid = ident.p_pid, .version = ident.p_idversion,
+        .uniqueid = ident.p_uniqueid, .registered = mach_absolute_time(),
+    };
+    os_atomic_store(&sweet_lsd_state, 2u, release);
+}
+
 #include "SweetBBContextRuntime.h"
 
+bool
+sweet_lsd_identity_read(struct sweet_lsd_identity_view *out)
+{
+    if (out == NULL || os_atomic_load(&sweet_lsd_state, acquire) != 2) return false;
+    *out = (struct sweet_lsd_identity_view){
+        .task = sweet_lsd_slot.task, .pid = sweet_lsd_slot.pid,
+        .version = sweet_lsd_slot.version, .uniqueid = sweet_lsd_slot.uniqueid,
+        .registered = sweet_lsd_slot.registered,
+    };
+    return true;
+}

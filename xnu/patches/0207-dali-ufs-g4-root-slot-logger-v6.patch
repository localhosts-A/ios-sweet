+	uint64_t total, seq;
+	if (memcmp(b, "SWEETLOG", 8) != 0) return false;
+	memcpy(&version, b + 8, 4); memcpy(&size, b + 12, 4);
+	memcpy(&total, b + 16, 8); memcpy(&seq, b + 24, 8);
+	if (version != 1 || size != SWEET_LOG_SIZE || total == 0 || seq == 0) return false;

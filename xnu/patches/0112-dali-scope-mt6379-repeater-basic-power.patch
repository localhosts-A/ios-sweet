+/* MT6379 chip74 normal-mode basic power controls. This is deliberately not
+ * the efuse/default/host-eye calibration path. Keep all trims untouched.
+ * Each PMIF write is limited to a saved control field, including rollback.
+ */
+class ScopedRepeater {
+    struct Field { uint16_t reg; uint8_t mask, saved; bool dirty; };
+    Field fields[8] = {
+        {0xd00, 1, 0, false}, {0xd03, 3, 0, false},
+        {0xd12, 0x20, 0, false}, {0xd34, 1, 0, false},
+        {0xd89, 0x80, 0, false}, {0xd8b, 0x20, 0, false},
+        {0xd92, 7, 0, false}, {0xd94, 2, 0, false}
+    };
+    bool saved = false;
+    uint32_t status = 0;
+    bool read(uint16_t reg, uint8_t *v) {
+        bool ok = dali_pmif_transfer(14, reg, v, false, &status);
+        if (!ok) { u2Log("DALI RPTR: control read failed reg=%03x pmif=%x\n", reg, status); }
+        return ok;
+    }
+    bool change(uint16_t reg, uint8_t mask, uint8_t value) {
+        if (!saved) { return false; }
+        for (auto &field : fields) {
+            if (reg != field.reg) { continue; }
+            if (mask & ~field.mask) { return false; }
+            uint8_t before = 0, after = 0;
+            if (!read(reg, &before)) { return false; }
+            uint8_t wanted = (before & ~mask) | (value & mask);
+            field.dirty = true; /* Transfer can partly succeed before timeout. */
+            bool wrote = dali_pmif_transfer(14, reg, &wanted, true, &status);
+            bool got = read(reg, &after);
+            bool ok = wrote && got && after == wanted;
+            if (!ok) { u2Log("DALI RPTR: control write failed reg=%03x wrote=%u read=%u value=%02x\n",
+                reg, wrote, got, after); }
+            return ok;
+        }
+        return false;
+    }
+    bool off() {
+        /* Native power-off order; attempt all safe shutdown fields. */
+        bool ok = change(0xd8b, 0x20, 0x20);
+        ok = change(0xd03, 1, 1) && ok;
+        ok = change(0xd00, 1, 0) && ok;
+        ok = change(0xd03, 2, 0) && ok;
+        ok = change(0xd12, 0x20, 0) && ok;
+        IODelay(300);
+        return ok;
+    }
+public:
+    bool powerOn() {
+        uint8_t chip = 0, reset = 0;
+        if (!read(0, &chip) || chip != 0x74 || !read(0xd91, &reset) || reset != 0) {
+            u2Log("DALI RPTR: chip/reset guard rejected chip=%02x reset=%02x; untouched\n", chip, reset);
+            return false;
+        }
+        for (auto &field : fields) {
+            if (!read(field.reg, &field.saved) || field.saved == 0xff) { return false; }
+        }
+        /* Only the photographed firmware-off handoff, no LP or active owner. */
+        if (fields[0].saved != 4 || fields[1].saved != 1 || fields[2].saved != 0x78 ||
+            fields[4].saved != 0 || fields[5].saved != 0x46) {
+            u2Log("DALI RPTR: entry guard rejected; controls untouched\n"); return false;
+        }
+        for (auto &field : fields) {
+            uint8_t current = 0;
+            if (!read(field.reg, &current) || current != field.saved) { return false; }
+        }
+        if (!read(0, &chip) || chip != 0x74 || !read(0xd91, &reset) || reset != 0) { return false; }
+        saved = true;
+        bool ok = change(0xd92, 7, 7) && change(0xd94, 2, 2);
+        ok = ok && off();
+        /* Normal power-on in vendor >=E3 path; retain calibration registers. */
+        ok = ok && change(0xd12, 0x20, 0x20) && change(0xd89, 0x80, 0x80) &&
+            change(0xd8b, 0x20, 0) && change(0xd00, 1, 1);
+        if (ok) { IODelay(100); }
+        ok = ok && change(0xd03, 1, 0);
+        if (ok) { IODelay(50); }
+        ok = ok && change(0xd34, 1, 1) && change(0xd03, 2, 2);
+        if (ok) { IODelay(10); }
+        ok = ok && change(0xd03, 2, 0);
+        if (ok) { IODelay(30); }
+        ok = ok && change(0xd34, 1, 0) && change(0xd03, 2, 2);
+        if (ok) { IODelay(100); }
+        ok = ok && change(0xd89, 0x80, 0);
+        uint8_t bg = 0, osc = 0;
+        bool got = read(0xd00, &bg) && read(0xd03, &osc);
+        ok = ok && got && (bg & 1) && (osc & 3) == 2;
+        u2Log("DALI RPTR: basic power ready=%u chip=%02x d00=%02x d03=%02x trims preserved\n",
+            ok, chip, bg, osc);
+        return ok;
+    }
+    bool restore() {
+        if (!saved) { return true; }
+        bool ok = off();
+        for (unsigned i = sizeof(fields) / sizeof(fields[0]); i-- > 0;) {
+            auto &field = fields[i];
+            if (!field.dirty) { continue; }
+            bool matched = change(field.reg, field.mask, field.saved);
+            ok = matched && ok;
+        }
+        u2Log("DALI RPTR: owned controls restored=%u\n", ok);
+        return ok;
+    }
+};

 static void
 sweet_bbvm_prepare(unsigned int requested)
 {
     if (requested != 1 || sweet_ff_enabled != 3)
         return;
     uint64_t ticks = 0, ns = 0;
     nanoseconds_to_absolutetime(SWEET_BBVM_INTERVAL_NS, &ticks);

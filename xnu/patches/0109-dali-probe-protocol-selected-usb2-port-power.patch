+/* Identify the sole USB2 port from Supported Protocol capabilities. Never
+ * infer xHCI port order from the physical IPPC U2/U3 numbering.
+ */
+unsigned usb2ProtocolPort(const ReadMapping &xhci, unsigned ports) {
+    uint32_t hcc = xhci.read(0x10);
+    unsigned offset = (hcc >> 16) * 4U, seen = 0, u2 = 0, u3 = 0;
+    bool ended = false;
+    if (ports != 2 || hcc == ~0U || !(hcc & (1U << 3))) { return 0; }
+    for (unsigned i = 0; i < 16; ++i) {
+        if (offset < 0x500 || offset > 0xff0 || (offset & 3)) { return 0; }
+        uint32_t header = xhci.read(offset);
+        if (!header || header == ~0U) { return 0; }
+        unsigned id = header & 0xff, next = (header >> 8) & 0xff;
+        /* No BIOS/OS legacy owner may be present. Do not alter ownership. */
+        if (id == 1 && (header & 0x01010000U)) {
+            u2Log("DALI PP: legacy owner present raw=%08x; skipped\n", header); return 0;
+        }
+        if (id == 2) {
+            uint32_t name = xhci.read(offset + 4), info = xhci.read(offset + 8);
+            unsigned major = header >> 24, minor = (header >> 16) & 0xff;
+            unsigned first = info & 0xff, count = (info >> 8) & 0xff;
+            u2Log("DALI PP: protocol rev=%u.%u first=%u count=%u raw=%08x\n",
+                major, minor, first, count, info);
+            if (name != 0x20425355U || !first || count != 1 || first > ports ||
+                (seen & (1U << (first - 1)))) { return 0; }
+            seen |= 1U << (first - 1);
+            if (major == 2 && !u2) { u2 = first; }
+            else if (major == 3 && !u3) { u3 = first; }
+            else { return 0; }
+        }
+        if (!next) { ended = true; break; }
+        offset += next * 4U;
+    }
+    return ended && seen == 3 && u2 && u3 ? u2 : 0;
+}
+
+bool hostStillHalted(const WriteMapping &ip, const ReadMapping &xhci, unsigned op) {
+    uint32_t s1 = ip.read(0x10), s2 = ip.read(0x14), status = xhci.read(op + 4);
+    return s1 != ~0U && s2 != ~0U && (s1 & 0xd01U) == 0xd01U && (s2 & 1U) &&
+        xhci.read(op) == 0 && status != ~0U && (status & 0x801U) == 1U;
+}
+
+/* Linux6.6 xhci_port_state_to_neutral / xhci_set_port_power: preserve RO
+ * and ordinary RW bits, zero RW1C/reset/strobe bits. Only change PP; never
+ * issue a port reset or start the engine. Return ownership restoration.
+ */
+bool observePortPower(const WriteMapping &ip, const ReadMapping &xhci,
+    unsigned op, unsigned ports) {
+    unsigned port = usb2ProtocolPort(xhci, ports);
+    if (!port || !hostStillHalted(ip, xhci, op)) {
+        u2Log("DALI PP: protocol/clock/halted guard rejected; untouched\n"); return true;
+    }
+    unsigned offset = op + 0x400U + (port - 1) * 0x10U;
+    uint32_t saved = xhci.read(offset);
+    constexpr uint32_t power = 1U << 9;
+    constexpr uint32_t neutral = (1U << 0) | (1U << 3) | (0xfU << 10) | (1U << 30) |
+        (0xfU << 5) | power | (3U << 14) | (7U << 25);
+    constexpr uint32_t controls = power | (3U << 14) | (7U << 25);
+    if (saved == ~0U || (saved & (power | 2U | 8U | 16U | (1U << 31)))) {
+        u2Log("DALI PP: entry rejected port=%u raw=%08x; untouched\n", port, saved); return true;
+    }
+    /* Writable mapping exposes only this one PORTSC register. */
+    WriteMapping portsc;
+    if (!portsc.open(0x16700000ULL + offset, 4)) {
+        u2Log("DALI PP: PORTSC mapping failed; untouched\n"); return true;
+    }
+    uint32_t wanted = (saved & neutral) | power;
+    portsc.write(0, wanted);
+    uint32_t after = portsc.read(0);
+    bool enabled = after != ~0U && (after & controls) == ((saved & controls) | power);
+    u2Log("DALI PP: enable port=%u saved=%08x want=%08x read=%08x match=%u\n",
+        port, saved, wanted, after, enabled);
+    for (unsigned sample = 0; enabled && sample < 3; ++sample) {
+        IOSleep(100); /* USB2 root-hub power-good minimum is20ms. */
+        if (!hostStillHalted(ip, xhci, op)) {
+            u2Log("DALI PP: observation stopped clock/engine changed\n"); break;
+        }
+        uint32_t sc = portsc.read(0);
+        if (sc == ~0U || !(sc & power) || (sc & 8U)) {
+            u2Log("DALI PP: observation stopped port=%u raw=%08x\n", port, sc); break;
+        }
+        u2Log("DALI PP: sample=%u port=%u raw=%08x pp=%u ccs=%u ped=%u speed=%u pls=%u\n",
+            sample, port, sc, (sc >> 9) & 1, sc & 1, (sc >> 1) & 1,
+            (sc >> 10) & 15, (sc >> 5) & 15);
+    }
+    uint32_t current = portsc.read(0);
+    if (current == ~0U || !hostStillHalted(ip, xhci, op)) {
+        u2Log("DALI PP: restore guard failed; reboot required\n"); return false;
+    }
+    /* Preserve live RO/RW state while restoring the PP bit we own. */
+    portsc.write(0, (current & neutral & ~power) | (saved & power));
+    uint32_t restored = portsc.read(0);
+    bool matched = restored != ~0U && (restored & controls) == (saved & controls);
+    u2Log("DALI PP: restore port=%u saved=%08x read=%08x match=%u\n",
+        port, saved, restored, matched);
+    return matched;
+}

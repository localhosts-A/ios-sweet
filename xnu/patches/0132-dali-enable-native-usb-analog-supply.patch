+/* ssusb_rscs_init enables the live-DT MT6373 VUSB rail, not just its
+ * regulator-always-on policy. Native attached-host capture has SID5 IDs73/73,
+ * 1b95=01 and 1e0d/1e0c=0b/00 (3.0V). Never program voltage or mode. If this
+ * exact rail was disabled at handoff, own only its enable bit until USB sleeps.
+ */
+class ScopedUsbAnalogSupply {
+    uint8_t saved = 0;
+    bool dirty = false;
+    bool read(uint16_t reg, uint8_t *value) {
+        uint32_t status = 0;
+        bool ok = dali_pmif_transfer(5, reg, value, false, &status);
+        if (!ok) { u2Log("DALI VUSB33: read failed reg=%04x pmif=%08x\n", reg, status); }
+        return ok;
+    }
+public:
+    bool enable() {
+        uint8_t id = 0, swid = 0, control = 0, voltage = 0, trim = 0;
+        bool got = read(9, &id) && read(0xb, &swid) && read(0x1b95, &control) &&
+            read(0x1e0d, &voltage) && read(0x1e0c, &trim);
+        if (!got || id != 0x73 || swid != 0x73 || (control & 2U) ||
+            (voltage & 15U) != 0xb || (trim & 15U) != 0) {
+            u2Log("DALI VUSB33: profile rejected got=%u id=%02x/%02x ctrl=%02x voltage=%02x trim=%02x\n",
+                got, id, swid, control, voltage, trim);
+            return false;
+        }
+        saved = control;
+        if (!(control & 1U)) {
+            uint8_t before = 0;
+            if (!read(0x1b95, &before) || before != saved) { return false; }
+            uint8_t wanted = saved | 1U;
+            uint32_t status = 0;
+            dirty = true; /* A timed-out transfer can still have changed the bit. */
+            bool wrote = dali_pmif_transfer(5, 0x1b95, &wanted, true, &status);
+            bool gotAfter = read(0x1b95, &control);
+            if (!wrote || !gotAfter || control != wanted) {
+                u2Log("DALI VUSB33: enable failed wrote=%u read=%u ctrl=%02x pmif=%08x\n",
+                    wrote, gotAfter, control, status);
+                return false;
+            }
+            IODelay(720); /* Live-DT regulator-enable-ramp-delay. */
+        }
+        u2Log("DALI VUSB33: ready=1 before=%02x read=%02x changed=%u voltage=%02x trim=%02x\n",
+            saved, control, dirty, voltage, trim);
+        return true;
+    }
+    bool changed() const { return dirty; }
+    bool restore() {
+        if (!dirty) { u2Log("DALI VUSB33: restore=1 changed=0\n"); return true; }
+        uint8_t before = 0, after = 0;
+        if (!read(0x1b95, &before)) { return false; }
+        uint8_t wanted = (before & ~1U) | (saved & 1U);
+        uint32_t status = 0;
+        bool wrote = dali_pmif_transfer(5, 0x1b95, &wanted, true, &status);
+        bool got = read(0x1b95, &after);
+        bool ok = wrote && got && after == wanted;
+        u2Log("DALI VUSB33: restore=%u changed=1 want=%02x read=%02x\n", ok, wanted, after);
+        if (ok) { dirty = false; }
+        return ok;
+    }
+};

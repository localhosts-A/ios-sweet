+void
+AppleCLCD::presentDali(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+	bool copied = false;
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; ++layer) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || !id)
+			continue;
+		SweetSurface *s = sweet_surface_copy(id);
+		if (s == NULL)
+			continue;
+		if (s == fPanelSurface) {
+			copied = true; /* Direct scanout writes still need command refresh. */
+			s->release();
+			continue;
+		}
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		struct sweet_fb_rect from = {(int32_t)get32(a, 0), (int32_t)get32(a, 4), (int32_t)get32(a, 8), (int32_t)get32(a, 12)};
+		struct sweet_fb_rect to = {(int32_t)get32(b, 0), (int32_t)get32(b, 4), (int32_t)get32(b, 8), (int32_t)get32(b, 12)};
+		if (from.width <= 0 || from.height <= 0) {
+			from.width = (int32_t)s->width;
+			from.height = (int32_t)s->height;
+		}
+		if (to.width <= 0 || to.height <= 0) {
+			to.width = from.width;
+			to.height = from.height;
+		}
+		uintptr_t address = s->kernelAddress();
+		bool valid = false;
+		if (address && s->memory && s->offset <= s->memory->getLength() &&
+		    s->pixelFormat == SWEET_FB_FORMAT_BGRA && s->bytesPerElement == 4 &&
+		    s->elementWidth == 1 && s->elementHeight == 1) {
+			struct sweet_fb_plane source = {(uint8_t *)(address + s->offset), s->memory->getLength() - s->offset,
+			    s->width, s->height, s->bytesPerRow};
+			struct sweet_fb_plane target = {(uint8_t *)fPixels, fPanelSurface->memory->getLength(),
+			    fWidth, fHeight, fRowBytes};
+			valid = sweet_fb_blit_scaled(target, source, fLogicalW, fLogicalH, from, to, fPanelFormat);
+		}
+		if (!valid && fGuiRejects++ < 8)
+			IOLog("DALI GUI: rejected/empty layer=%u surface=%u fmt=0x%x bpr=%u\n", layer, id, s->pixelFormat, s->bytesPerRow);
+		copied |= valid;
+		s->release();
+	}
+	if (copied) {
+		fRefreshPending = true;
+		if (++fGuiFrames <= 4)
+			IOLog("DALI GUI: present n=%u layer-mask=0x%x\n", fGuiFrames, mask);
+	}
+}

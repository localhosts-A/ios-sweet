+bool DaliUSBPower::wakeDetection()
+{
+    /* mt6379_tcpc_init sets SYSCTRL1.SHIPPING_OFF; its exit-low-power path
+     * sets SYSCTRL2 BMCIOOSC_EN|VBUSDET_EN and clears LPWR_EN. PD base=400.
+     * Preserve all other fields, no protocol/DRP/PHY/protection programming.
+     * Caller already verified absent VBUS and opened both CC terminations.
+     */
+    if (!read8(0x48f, &savedSys1) || !read8(0x490, &savedSys2)) { return false; }
+    kprintf("DALI OTG: TCPC handoff sys1=%02x sys2=%02x\n", savedSys1, savedSys2);
+    if ((savedSys1 & 0x20) != 0x20 || (savedSys2 & 0x0b) != 3) {
+        tcpcTouched = true; /* Dirty before any possible write. */
+        if (!(savedSys1 & 0x20) && !update(0x48f, 0x20, 0x20)) { return false; }
+        IOSleep(1); /* Vendor shipping-off settle is1ms. */
+        if ((savedSys2 & 0x0b) != 3 && !update(0x490, 0x0b, 3)) { return false; }
+        IOSleep(1);
+    }
+    uint8_t sys1 = 0, sys2 = 0;
+    bool ok = read8(0x48f, &sys1) && read8(0x490, &sys2) &&
+        (sys1 & 0x20) && (sys2 & 0x0b) == 3;
+    kprintf("DALI OTG: TCPC detection wake %s sys1=%02x sys2=%02x\n",
+        ok ? "confirmed" : "FAILED", sys1, sys2);
+    return ok;
+}

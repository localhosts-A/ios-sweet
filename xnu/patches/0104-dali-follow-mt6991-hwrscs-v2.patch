+bool setRequestGates(WriteMapping &gate, const uint32_t *saved, bool enable) {
+    bool ok = true;
+    for (unsigned i = 0; i < 8; ++i) {
+        const uint32_t offset = kRequestGateOffsets[i];
+        uint32_t current = gate.read(offset);
+        if (current == ~0U) { ok = false; continue; }
+        uint32_t value = (current & ~0xfU) | (enable ? 0xfU : (saved[i] & 0xfU));
+        gate.write(offset, value);
+        uint32_t after = gate.read(offset);

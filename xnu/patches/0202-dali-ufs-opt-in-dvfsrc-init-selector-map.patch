+     * calibration and actual AP request/completion before any HS attribute. */
+out:
+    printf("SWEET UFS HSFW: allowed=%u attempted=%u action=%s result=%d "
+        "before-valid=%u basic-before=0x%x count-before=0x%x "
+        "after-valid=%u basic-after=0x%x count-after=0x%x "
+        "status=0x%llx dram-type=0x%llx start-called=0 scope=vendor-init-not-adc\n",

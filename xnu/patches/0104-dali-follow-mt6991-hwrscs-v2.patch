+
+bool releaseResourcesAndRestore(WriteMapping &ip, WriteMapping &gate,
+    uint32_t oldRequest, uint32_t oldAck, const uint32_t *savedGates) {
+    uint32_t current = ip.read(0xe0);
+    if (current == ~0U) { return false; }
+    uint32_t off = current & ~(kHwrscsForceMask | kHwrscsRequestMask);

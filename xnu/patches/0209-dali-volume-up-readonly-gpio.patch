+UInt32
+SweetHIDButtons::daliVolumeRead(IOMemoryMap *map, UInt32 offset)
+{
+	UInt32 value = *reinterpret_cast<volatile UInt32 *>(map->getVirtualAddress() + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+bool
+SweetHIDButtons::daliVolumePinValid()
+{
+	return dali_volume_pin_valid(daliVolumeRead(fDaliGpioMap, 0x370),
+	    daliVolumeRead(fDaliGpioMap, 0x10), daliVolumeRead(fDaliIesMap, 0x70));
+}
+
+bool
+SweetHIDButtons::daliVolumeHasClient()
+{
+	IOLockLock(_clientLock);
+	bool ready = _clients && _clients->getCount() != 0;
+	IOLockUnlock(_clientLock);
+	return ready;
+}
+
+void
+SweetHIDButtons::startDaliVolume()
+{
+	int optIn = 0;
+	if (!PE_parse_boot_argn("dalivolup", &optIn, sizeof(optIn)) || optIn != 1) return;
+	auto root = IORegistryEntry::fromPath("IODeviceTree:/");
+	OSData *compatible = root ? OSDynamicCast(OSData, root->getProperty("compatible")) : NULL;
+	if (!compatible || !dali_volume_board_enabled(optIn, compatible->getBytesNoCopy(),
+	    compatible->getLength())) {
+		IOLog("DALI VOLUP: board identity unavailable; input disabled\n");
+		return;
+	}
+	/* GPIO60 input/dir/mux and IOCFG_LM1 input-enable only. No register writes. */
+	fDaliGpioMemory = IOMemoryDescriptor::withPhysicalAddress(0x1002d000ULL, 0x1000, kIODirectionIn);
+	fDaliIesMemory = IOMemoryDescriptor::withPhysicalAddress(0x13020000ULL, 0x1000, kIODirectionIn);
+	if (fDaliGpioMemory)
+		fDaliGpioMap = fDaliGpioMemory->map(kIOMapInhibitCache | kIOMapReadOnly);
+	if (fDaliIesMemory)
+		fDaliIesMap = fDaliIesMemory->map(kIOMapInhibitCache | kIOMapReadOnly);
+	if (!fDaliGpioMap || !fDaliIesMap || !fDaliGpioMap->getVirtualAddress() ||
+	    !fDaliIesMap->getVirtualAddress() || !daliVolumePinValid()) {
+		IOLog("DALI VOLUP: mapping or firmware pin configuration rejected\n");
+		stopDaliVolume();
+		return;
+	}
+	fDaliVolumeState = {};
+	fDaliVolumeTimer = IOTimerEventSource::timerEventSource(this, &SweetHIDButtons::daliVolumeFired);
+	if (!fDaliVolumeTimer || _hidWorkLoop->addEventSource(fDaliVolumeTimer) != kIOReturnSuccess) {
+		IOLog("DALI VOLUP: timer unavailable\n");
+		stopDaliVolume();
+		return;
+	}
+	fDaliVolumeTimerAdded = fDaliVolumeRunning = true;
+	IOLog("DALI VOLUP: GPIO60 read-only polling enabled; physical behavior unverified\n");
+	fDaliVolumeTimer->setTimeoutMS(16);
+}
+
+void
+SweetHIDButtons::daliVolumeFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDButtons *self = OSDynamicCast(SweetHIDButtons, owner);
+	if (!self || !self->fDaliVolumeRunning) return;
+	bool client = self->daliVolumeHasClient();
+	if (!self->daliVolumePinValid()) {
+		/* Cancellation only, not a sampled physical release. */
+		if (client && self->fDaliVolumeState.armed && self->fDaliVolumeState.down) {
+			bool cancelled = self->key(kHIDUsage_Csmr_VolumeIncrement, false);
+			IOLog("DALI VOLUP: invalid pin cancellation allocated=%d\n", cancelled);
+		}
+		self->fDaliVolumeState = {};
+		self->fDaliVolumeRunning = false;
+		IOLog("DALI VOLUP: firmware pin configuration changed; polling stopped\n");
+		return;
+	}
+	UInt32 data = daliVolumeRead(self->fDaliGpioMap, 0x210);
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	int event = dali_volume_sample(&self->fDaliVolumeState, client, data, ns);
+	if (event >= 0 && !self->key(kHIDUsage_Csmr_VolumeIncrement, event != 0)) {
+		/* The HID event was not allocated; retry this stable state next tick. */
+		self->fDaliVolumeState.down = (event == 0);
+	}
+	if (self->fDaliVolumeRunning) sender->setTimeoutMS(16);
+}
+
+IOReturn
+SweetHIDButtons::daliVolumeStopAction(OSObject *owner, void *, void *, void *, void *)
+{
+	SweetHIDButtons *self = OSDynamicCast(SweetHIDButtons, owner);
+	if (!self) return kIOReturnBadArgument;
+	self->fDaliVolumeRunning = false;
+	self->fDaliVolumeTimer->cancelTimeout();
+	self->fDaliVolumeTimer->disable();
+	if (self->fDaliVolumeState.armed && self->fDaliVolumeState.down && self->daliVolumeHasClient()) {
+		/* Balance our prior down on service teardown, not a physical sample. */
+		bool cancelled = self->key(kHIDUsage_Csmr_VolumeIncrement, false);
+		IOLog("DALI VOLUP: teardown cancellation allocated=%d\n", cancelled);
+	}
+	self->fDaliVolumeState = {};
+	return kIOReturnSuccess;
+}
+
+void
+SweetHIDButtons::stopDaliVolume()
+{
+	if (_hidWorkLoop && fDaliVolumeTimerAdded) {
+		(void)_hidWorkLoop->runAction(&SweetHIDButtons::daliVolumeStopAction, this);
+		_hidWorkLoop->removeEventSource(fDaliVolumeTimer);
+		fDaliVolumeTimerAdded = false;
+	}
+	OSSafeReleaseNULL(fDaliVolumeTimer);
+	OSSafeReleaseNULL(fDaliIesMap);
+	OSSafeReleaseNULL(fDaliGpioMap);
+	OSSafeReleaseNULL(fDaliIesMemory);
+	OSSafeReleaseNULL(fDaliGpioMemory);
+}
+
+void
+SweetHIDButtons::stop(IOService *provider)
+{
+	stopDaliVolume();
+	IOHIDEventService::stop(provider);
+}
+
+void
+SweetHIDButtons::free(void)
+{
+	stopDaliVolume();
+	IOHIDEventService::free();
+}

diff --git a/pexpert/arm/DaliWatchdogPolicy.h b/pexpert/arm/DaliWatchdogPolicy.h
--- a/pexpert/arm/DaliWatchdogPolicy.h
+++ b/pexpert/arm/DaliWatchdogPolicy.h
@@ -1,28 +1,28 @@
 /* Finite boot keepalive policy; never disables or rearms a watchdog. */
 #ifndef DALI_WATCHDOG_POLICY_H
 #define DALI_WATCHDOG_POLICY_H
 
 #define DALI_WDT_DEFAULT_SECONDS 120u
-#define DALI_WDT_MAX_SECONDS 600u
+#define DALI_WDT_MAX_SECONDS 1200u
 
 static inline unsigned int
 dali_wdt_select_lease(unsigned int requested)
 {
     return requested >= DALI_WDT_DEFAULT_SECONDS && requested <= DALI_WDT_MAX_SECONDS ?
            requested : DALI_WDT_DEFAULT_SECONDS;
 }
 
 static inline bool
 dali_wdt_reload_due(uint64_t started, uint64_t last, uint64_t now,
     uint64_t hz, unsigned int seconds)
 {
     if (hz == 0 || seconds < DALI_WDT_DEFAULT_SECONDS || seconds > DALI_WDT_MAX_SECONDS ||
         hz > UINT64_MAX / seconds || now < started)
         return false;
     if (now - started >= hz * seconds)
         return false;
     if (last != 0 && (now < last || now - last < hz))
         return false;
     return true;
 }
 #endif

diff --git a/iokit/Kernel/arm/DaliUSBPower.cpp b/iokit/Kernel/arm/DaliUSBPower.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/DaliUSBPower.cpp
@@ -0,0 +1,263 @@
+/* MT6379 TCPCI + SC8585 source routing. Vendor MiCode e45c319:
+ * tcpc_mt6379.c, std_tcpci_v10.h, extcon-mtk-usb.c, mt6379-charger.{c,h},
+ * sc8585_charger.c. Dali live FDT has no boost GPIO/usb-killer-detect.
+ * A source diagnostic lease, not a USB host or PD policy implementation.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+#include "DaliUSBPower.h"
+#include "DaliPMIF.h"
+#include "DaliI2C5.h"
+#include <machine/machine_routines.h>
+
+static uint64_t physicalMs()
+{
+    uint64_t count;
+    __asm__ volatile("isb\n\tmrs %0, cntpct_el0" : "=r"(count) :: "memory");
+    return count / 13000U; /* Dali verified physical timebase13MHz. */
+}
+
+bool DaliUSBPower::read8(uint16_t reg, uint8_t *v)
+{
+    return dali_pmif_transfer(14, reg, v, false, &status);
+}
+
+bool DaliUSBPower::write8(uint16_t reg, uint8_t v)
+{
+    /* Whitelist only the audited role/polarity/power and charger registers. */
+    if (reg != 0x41a && reg != 0x419 && reg != 0x41c && reg != 0x108 &&
+        reg != 0x11c && reg != 0x11d && reg != 0x11e && reg != 0x135 &&
+        (reg < 7 || reg > 10)) { return false; }
+    uint8_t verify = 0;
+    if (!dali_pmif_transfer(14, reg, &v, true, &status)) { return false; }
+    /* TM passcode registers are write-only/unlock sequence, not readback. */
+    return (reg >= 7 && reg <= 10) || (read8(reg, &verify) && verify == v);
+}
+
+bool DaliUSBPower::update(uint16_t reg, uint8_t mask, uint8_t v)
+{
+    uint8_t before = 0;
+    return read8(reg, &before) && write8(reg, (before & ~mask) | (v & mask));
+}
+
+bool DaliUSBPower::snapshot(uint8_t *cc, uint8_t *power, uint8_t *otg, unsigned *mv)
+{
+    uint16_t raw = 0;
+    uint8_t fault = 0;
+    if (!read8(0x41d, cc) || !read8(0x41e, power) || !read8(0x108, otg) ||
+        !read8(0x41f, &fault) ||
+        !dali_pmif_read16(14, 0x470, &raw, &status)) { return false; }
+    /* Vendor reads low10bits *25mV. Refuse unhandled scaling/reserved bits. */
+    if (fault || (raw & ~0x3ffU) || (*power & 0x40)) { return false; }
+    *mv = (raw & 0x3ffU) * 25U;
+    return true;
+}
+
+bool DaliUSBPower::protectedIdle(bool idle)
+{
+    /* Only this service owns MT6379 test mode; shared PMIF still locks every
+     * bus transaction, so RTC SID9 can safely interleave without touching TM.
+     * Mark all state dirty before writes; always attempt to relock on failure.
+     */
+    static const uint8_t passcode[] = {0x69, 0x96, 0x63, 0x79};
+    bool unlocked = true;
+    for (unsigned i = 0; i < 4 && unlocked; ++i) { unlocked = write8(7 + i, passcode[i]); }
+    bool changed = unlocked && update(0x135, 0x20, idle ? 0x20 : 0);
+    bool relocked = write8(7, 0);
+    return changed && relocked;
+}
+
+bool DaliUSBPower::sourceOn()
+{
+    uint8_t cc = 0, power = 0, otg = 0;
+    unsigned mv = 0;
+    if (!snapshot(&cc, &power, &otg, &mv) || (power & 0x37) || (otg & 1) ||
+        mv > 800 || (cc & 0x30) || (cc & 0xf) != attachedCC) { return false; }
+    /* Do not adopt or shut down another source: all these must start off. */
+    if (!read8(0x11c, &savedCVHi) || !read8(0x11d, &savedCVLo) ||
+        !read8(0x11e, &savedCurrent)) { return false; }
+    cpAttempted = true;
+    if (!dali_cp_prepare_source()) { return false; }
+    chargerTouched = true;
+    /* min4850mV + (selector26 - minselector20)*25mV =5000mV.
+     * Big-endian selector, current table index0=500mA, default Rp advertisement.
+     */
+    if (!write8(0x11c, 0) || !write8(0x11d, 26) || !update(0x11e, 7, 0) ||
+        !protectedIdle(false)) { return false; }
+    /* Recheck after CP configuration and before enabling physical source. */
+    if (!snapshot(&cc, &power, &otg, &mv) || (power & 0x37) || (otg & 1) ||
+        mv > 800 || (cc & 0x30) || (cc & 0xf) != attachedCC) { return false; }
+    if (!update(0x108, 1, 1)) { return false; }
+    kprintf("DALI OTG: 5V/500mA source enabled; waiting for VBUS measurement\n");
+    return true;
+}
+
+void DaliUSBPower::finishLocked(const char *reason)
+{
+    if (state == Finished) { return; }
+    state = Finished; /* Never rearm automatically after detach/error. */
+    bool chargerOK = true, cpOK = true, roleOK = true;
+    bool sourceOffConfirmed = !chargerTouched;
+    if (chargerTouched) {
+        /* Vendor off path enables PP_CV_FLOW_IDLE before regulator-disable.
+         * Attempt physical disable even when protected operation failed.
+         */
+        bool idleOK = protectedIdle(true);
+        bool offOK = update(0x108, 1, 0);
+        uint8_t otg = 1;
+        offOK = read8(0x108, &otg) && !(otg & 1) && offOK;
+        sourceOffConfirmed = offOK;
+        chargerOK = idleOK && offOK;
+        if (offOK) {
+            bool a = write8(0x11c, savedCVHi);
+            bool b = write8(0x11d, savedCVLo);
+            bool c = update(0x11e, 7, savedCurrent);
+            chargerOK = a && b && c && chargerOK;
+            if (cpAttempted) { cpOK = dali_cp_restore_source(); }
+        } else {
+            cpOK = false; /* Keep routing stable until reboot if source-off unconfirmed. */
+        }
+    } else if (cpAttempted) {
+        cpOK = dali_cp_restore_source();
+    }
+    if (roleTouched) {
+        /* Stop advertising before restoring original sink configuration. */
+        bool a = write8(0x41a, 0x0f);
+        bool b = update(0x419, 1, savedPolarity);
+        bool c = update(0x41c, 0x40, savedPowerCtrl);
+        /* Never restore a sink termination when our source-off is unknown. */
+        bool d = sourceOffConfirmed && write8(0x41a, savedRole);
+        roleOK = a && b && c && d;
+    }
+    uint8_t cc = 0, power = 0, otg = 0;
+    unsigned mv = 0;
+    bool measured = snapshot(&cc, &power, &otg, &mv);
+    if (chargerTouched && chargerOK) {
+        /* Observe passive voltage decay, no forced-discharge programming. */
+        for (unsigned i = 0; i < 20 && measured && mv > 800; ++i) {
+            IOSleep(25);
+            measured = snapshot(&cc, &power, &otg, &mv);
+        }
+    }
+    kprintf("DALI OTG: end=%s charger=%s cp=%s role=%s VBUS=%umV valid=%u otg=%02x\n",
+        reason, chargerOK ? "restored" : "FAILED", cpOK ? "restored" : "FAILED",
+        roleOK ? "restored" : "FAILED", mv, measured, otg);
+    if (!chargerOK || !cpOK || !roleOK) { kprintf("DALI OTG: cleanup incomplete; reboot required\n"); }
+}
+
+bool DaliUSBPower::tickLocked()
+{
+    if (state == Finished) { return false; }
+    ++ticks; ++stateTicks;
+    uint64_t now = physicalMs();
+    if (!startedMs) { startedMs = stateStartedMs = now; }
+    if (now - startedMs >= 60000) { finishLocked("total60s lease"); return false; }
+    uint8_t cc = 0, power = 0, otg = 0;
+    unsigned mv = 0;
+    if (!snapshot(&cc, &power, &otg, &mv)) { finishLocked("status/fault error"); return false; }
+    if (state == Initial) {
+        if (!read8(0x41a, &savedRole) || !read8(0x419, &savedPolarity) ||
+            !read8(0x41c, &savedPowerCtrl) || savedRole != 0x0a ||
+            !(power & 8) || (otg & 1)) {
+            finishLocked("handoff not idle sink"); return false;
+        }
+        /* The trial starts on the PC cable. Stay Rd and do not touch power
+         * until it is removed and VBUS is absent for >=200ms. Never advertise
+         * Rp against the PC/charger. This is an explicit handoff window.
+         */
+        if ((power & 0x37) || mv > 800) {
+            stable = 0;
+            if (ticks % 10 == 0) {
+                kprintf("DALI OTG: unplug PC cable; staying sink VBUS=%umV power=%02x\n", mv, power);
+            }
+            if (now - stateStartedMs >= 40000) { finishLocked("PC cable handoff timeout"); return false; }
+            return true;
+        }
+        if (++stable < 3) { return true; }
+        stable = 0;
+        roleTouched = true;
+        if (!write8(0x41a, 0x0f) || !update(0x41c, 0x40, 0) ||
+            !write8(0x41a, 0x05)) { finishLocked("Rp programming failed"); return false; }
+        /* Fixed Rp/default current on both CC pins; no DRP/PD/VCONN. */
+        IODelay(30);
+        state = Waiting; stateTicks = 0; stateStartedMs = physicalMs();
+        kprintf("DALI OTG: default Rp armed; attach window40s, source lease15s\n");
+        return true;
+    }
+    if (ticks % 10 == 0) {
+        kprintf("DALI OTG: tick=%u state=%u cc=%02x power=%02x VBUS=%umV otg=%02x\n",
+            ticks, state, cc, power, mv, otg);
+    }
+    unsigned c1 = cc & 3, c2 = (cc >> 2) & 3;
+    /* Exactly one Rd, the unused contact open or Ra. Reject audio/debug
+     * accessories, source/sink-result ambiguity or active DRP toggling.
+     */
+    bool attached = !(cc & 0x30) && ((c1 == 2 && c2 <= 1) || (c2 == 2 && c1 <= 1));
+    if (state == Waiting) {
+        if ((power & 0x37) || (otg & 1) || mv > 800) {
+            finishLocked("external VBUS while waiting"); return false;
+        }
+        if (attached) {
+            if (attachedCC == (cc & 15)) { ++stable; }
+            else { attachedCC = cc & 15; stable = 1; }
+        } else { stable = 0; attachedCC = 0; }
+        if (stable >= 3) { /* >=200ms between first and third 100ms sample. */
+            if (!update(0x419, 1, c2 == 2 ? 1 : 0) || !sourceOn()) {
+                finishLocked("source prepare failed"); return false;
+            }
+            state = Rising; stateTicks = 0; stateStartedMs = physicalMs();
+        } else if (now - stateStartedMs >= 40000) {
+            finishLocked("attach timeout"); return false;
+        }
+        return true;
+    }
+    if (!attached || (cc & 15) != attachedCC) {
+        finishLocked("detached"); return false;
+    }
+    if (!(otg & 1) || (power & 0x23) || mv > 5500) {
+        finishLocked("source status invalid"); return false;
+    }
+    if (state == Rising) {
+        if ((power & 4) && mv >= 4400 && mv <= 5500) {
+            state = Powered; stateTicks = 0; stateStartedMs = physicalMs();
+            kprintf("DALI OTG: VBUS valid %umV; connector source confirmed, USB host not started\n", mv);
+        } else if (now - stateStartedMs >= 1000) {
+            finishLocked("VBUS rise timeout"); return false;
+        }
+    } else if (mv < 4400 || !(power & 4)) {
+        finishLocked("VBUS dropped"); return false;
+    } else if (now - stateStartedMs >= 15000) {
+        finishLocked("15s source lease expired"); return false;
+    }
+    return true;
+}
+
+bool DaliUSBPower::init()
+{
+    uint64_t frequency;
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+    if (frequency != 13000000) { return false; }
+    lock = IOLockAlloc();
+    return lock != nullptr;
+}
+
+bool DaliUSBPower::tick()
+{
+    if (!lock || !ml_get_interrupts_enabled() || ml_at_interrupt_context()) { return false; }
+    IOLockLock(lock);
+    bool active = tickLocked();
+    IOLockUnlock(lock);
+    return active;
+}
+
+void DaliUSBPower::finish(const char *reason)
+{
+    if (!lock) { return; }
+    IOLockLock(lock); finishLocked(reason); IOLockUnlock(lock);
+}
+
+void DaliUSBPower::release()
+{
+    if (lock) { finish("service release"); IOLockFree(lock); lock = nullptr; }
+}
+#endif

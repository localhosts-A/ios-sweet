--- /dev/null
+++ b/bsd/kern/SweetUlockTrace.h
@@ -0,0 +1,108 @@
+#ifndef SWEET_ULOCK_TRACE_H
+#define SWEET_ULOCK_TRACE_H
+
+#include <stdint.h>
+
+/* Active, not historical, waits: slots are reusable after the continuation. */
+#define SWEET_ULOCK_SLOTS 16u
+#define SWEET_ULOCK_INDEX_BITS 4u
+
+#ifndef SWEET_ULOCK_CAS
+#define SWEET_ULOCK_CAS(p, old, newval) os_atomic_cmpxchg((p), (old), (newval), acq_rel)
+#define SWEET_ULOCK_LOAD(p) os_atomic_load((p), acquire)
+#define SWEET_ULOCK_STORE(p, v) os_atomic_store((p), (v), release)
+#define SWEET_ULOCK_INC(p) os_atomic_inc((p), relaxed)
+#endif
+
+struct sweet_ulock_record {
+    uint64_t token, tid, owner_tid, address, value, timeout_ns, begin, pc, lr;
+    uint32_t opcode, flags;
+};
+struct sweet_ulock_slot {
+    uint64_t token; /* atomic; generation-tagged to prevent a stale finish clearing a reuse */
+    struct sweet_ulock_record record; /* guarded against producer and sampler */
+};
+struct sweet_ulock_trace {
+    uint32_t guard, closed, busy_drop, full_drop, exhausted;
+    uint64_t generation;
+    struct sweet_ulock_slot slots[SWEET_ULOCK_SLOTS];
+};
+struct sweet_ulock_snapshot {
+    uint32_t count, busy_drop, full_drop, exhausted;
+    struct sweet_ulock_record records[SWEET_ULOCK_SLOTS];
+};
+
+_Static_assert(SWEET_ULOCK_SLOTS == (1u << SWEET_ULOCK_INDEX_BITS), "token index");
+_Static_assert(sizeof(struct sweet_ulock_trace) + sizeof(struct sweet_ulock_snapshot) <= 4096,
+    "bounded ulock records");
+
+/* Producer is called with ull locked: never wait, print, allocate or retain pointers. */
+static inline uint64_t
+sweet_ulock_record_begin(struct sweet_ulock_trace *trace, const struct sweet_ulock_record *record)
+{
+    if (!trace || !record || !record->tid || SWEET_ULOCK_LOAD(&trace->closed)) return 0;
+    if (!SWEET_ULOCK_CAS(&trace->guard, 0u, 1u)) {
+        SWEET_ULOCK_INC(&trace->busy_drop);
+        return 0;
+    }
+    uint64_t token = 0;
+    if (!SWEET_ULOCK_LOAD(&trace->closed)) {
+        unsigned int i;
+        for (i = 0; i < SWEET_ULOCK_SLOTS; ++i) {
+            if (SWEET_ULOCK_LOAD(&trace->slots[i].token) == 0) break;
+        }
+        if (i == SWEET_ULOCK_SLOTS) {
+            ++trace->full_drop;
+        } else if (trace->generation == (UINT64_MAX >> SWEET_ULOCK_INDEX_BITS)) {
+            trace->exhausted = 1;
+        } else {
+            token = (++trace->generation << SWEET_ULOCK_INDEX_BITS) | i;
+            trace->slots[i].record = *record;
+            trace->slots[i].record.token = token;
+            SWEET_ULOCK_STORE(&trace->slots[i].token, token);
+        }
+    }
+    SWEET_ULOCK_STORE(&trace->guard, 0u);
+    return token;
+}
+
+/* Same wait's continuation, without guard: cannot erase a slot reused meanwhile. */
+static inline void
+sweet_ulock_record_end(struct sweet_ulock_trace *trace, uint64_t token)
+{
+    if (!trace || !token) return;
+    unsigned int i = (unsigned int)(token & (SWEET_ULOCK_SLOTS - 1u));
+    (void)SWEET_ULOCK_CAS(&trace->slots[i].token, token, 0ull);
+}
+
+static inline void
+sweet_ulock_record_close(struct sweet_ulock_trace *trace)
+{
+    if (trace) SWEET_ULOCK_STORE(&trace->closed, 1u);
+}
+
+/* Snapshot holds the producer guard; an exit may still retire its atomic token. */
+static inline int
+sweet_ulock_record_snapshot(struct sweet_ulock_trace *trace, struct sweet_ulock_snapshot *snapshot)
+{
+    if (!trace || !snapshot) return -1;
+    unsigned int tries;
+    for (tries = 0; tries < 128; ++tries) {
+        if (SWEET_ULOCK_CAS(&trace->guard, 0u, 1u)) break;
+    }
+    if (tries == 128) return -1;
+    snapshot->count = 0;
+    for (unsigned int i = 0; i < SWEET_ULOCK_SLOTS; ++i) {
+        uint64_t token = SWEET_ULOCK_LOAD(&trace->slots[i].token);
+        if (!token) continue;
+        struct sweet_ulock_record record = trace->slots[i].record;
+        if (SWEET_ULOCK_LOAD(&trace->slots[i].token) != token) continue;
+        snapshot->records[snapshot->count++] = record;
+    }
+    snapshot->busy_drop = SWEET_ULOCK_LOAD(&trace->busy_drop);
+    snapshot->full_drop = trace->full_drop;
+    snapshot->exhausted = trace->exhausted;
+    SWEET_ULOCK_STORE(&trace->guard, 0u);
+    return 0;
+}
+#endif

--- /dev/null
+++ b/bsd/sweet_hfs/core/sweet_hfs_diag.h
@@ -0,0 +1,56 @@
+/* Opt-in HFS diagnostics; budgets are independent in each translation unit. */
+#ifndef SWEET_HFS_DIAG_H
+#define SWEET_HFS_DIAG_H
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <stdbool.h>
+#include <sys/types.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+#define SWEET_HFS_DIAG_EVENTS 64u
+#define SWEET_HFS_DIAG_ERRORS 16u
+
+static volatile UInt32 sweet_hfs_diag_events;
+static volatile UInt32 sweet_hfs_diag_errors;
+
+static inline bool
+sweet_hfs_diag_enabled(void)
+{
+	unsigned int enabled = 0;
+	return PE_parse_boot_argn("sweethfsdiag", &enabled, sizeof(enabled)) && enabled == 1;
+}
+
+static inline bool
+sweet_hfs_diag_contains(uint32_t first, uint32_t count, uint32_t target)
+{
+	return count != 0 && first <= target && target - first < count;
+}
+
+static inline bool
+sweet_hfs_diag_range(uint32_t first, uint32_t count)
+{
+	uint32_t target = 3059250u;
+	if (!sweet_hfs_diag_enabled())
+		return false;
+	(void)PE_parse_boot_argn("sweethfsblock", &target, sizeof(target));
+	return sweet_hfs_diag_contains(first, count, target);
+}
+
+static inline uint32_t
+sweet_hfs_diag_take(bool error)
+{
+	if (!sweet_hfs_diag_enabled())
+		return 0;
+	volatile UInt32 *counter = error ? &sweet_hfs_diag_errors : &sweet_hfs_diag_events;
+	uint32_t limit = error ? SWEET_HFS_DIAG_ERRORS : SWEET_HFS_DIAG_EVENTS;
+	uint32_t value = (uint32_t)OSAddAtomic(0, counter);
+	while (value < limit) {
+		if (OSCompareAndSwap(value, value + 1, counter))
+			return value + 1;
+		value = (uint32_t)OSAddAtomic(0, counter);
+	}
+	return 0;
+}
+#endif
+#endif

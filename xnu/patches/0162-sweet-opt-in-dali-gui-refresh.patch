+/* Bounded BGRA logical-canvas copy into an adopted 32-bit scanout surface. */
+#ifndef SWEET_FB_BLIT_H
+#define SWEET_FB_BLIT_H
+#include <stdbool.h>
+#include <stdint.h>
+
+struct sweet_fb_plane {
+	uint8_t *pixels;
+	uint64_t bytes;
+	uint32_t width, height, row_bytes;
+};
+struct sweet_fb_rect { int32_t x, y, width, height; };
+
+static inline bool
+sweet_fb_format_supported(uint32_t format)
+{
+	uint32_t code = format & 15u;
+	return (code == 2 || code == 3) && !(format & ((1u << 4) | (3u << 8)));
+}
+
+static inline uint32_t
+sweet_fb_pack_pixel(uint32_t pixel, uint32_t format)
+{
+	pixel |= 0xff000000u;
+	if (format & (1u << 17))
+		pixel = (pixel & 0xff00ff00u) | ((pixel & 0xffu) << 16) | ((pixel >> 16) & 0xffu);
+	if ((format & 15u) == 3)
+		pixel = (pixel << 8) | 255u;
+	if (format & (1u << 16))
+		pixel = __builtin_bswap32(pixel);
+	return pixel;
+}
+
+static inline uint32_t
+sweet_fb_unpack_pixel(uint32_t pixel, uint32_t format)
+{
+	if (format & (1u << 16))
+		pixel = __builtin_bswap32(pixel);
+	if ((format & 15u) == 3)
+		pixel = (pixel >> 8) | 0xff000000u;
+	if (format & (1u << 17))
+		pixel = (pixel & 0xff00ff00u) | ((pixel & 0xffu) << 16) | ((pixel >> 16) & 0xffu);
+	return pixel | 0xff000000u;
+}
+
+static inline bool
+sweet_fb_plane_valid(const struct sweet_fb_plane *p)
+{
+	return p->pixels && p->width && p->height && p->width <= 16384 && p->height <= 16384 &&
+	    p->row_bytes >= (uint64_t)p->width * 4 &&
+	    (uint64_t)(p->height - 1) * p->row_bytes + (uint64_t)p->width * 4 <= p->bytes;
+}
+
+static inline bool
+sweet_fb_blit_scaled(struct sweet_fb_plane dst, struct sweet_fb_plane src,
+    uint32_t canvas_width, uint32_t canvas_height, struct sweet_fb_rect source,
+    struct sweet_fb_rect target, uint32_t format)
+{
+	if (!sweet_fb_plane_valid(&src) || !sweet_fb_plane_valid(&dst) ||
+	    !sweet_fb_format_supported(format) || !canvas_width || !canvas_height ||
+	    canvas_width > 16384 || canvas_height > 16384 || source.width <= 0 ||
+	    source.height <= 0 || target.width <= 0 || target.height <= 0)
+		return false;
+	int64_t left = target.x < 0 ? 0 : target.x;
+	int64_t top = target.y < 0 ? 0 : target.y;
+	int64_t right = (int64_t)target.x + target.width;
+	int64_t bottom = (int64_t)target.y + target.height;
+	if (right > canvas_width) right = canvas_width;
+	if (bottom > canvas_height) bottom = canvas_height;
+	if (left >= right || top >= bottom)
+		return false;
+	uint32_t x0 = (uint32_t)((left * dst.width + canvas_width - 1) / canvas_width);
+	uint32_t y0 = (uint32_t)((top * dst.height + canvas_height - 1) / canvas_height);
+	uint32_t x1 = (uint32_t)((right * dst.width + canvas_width - 1) / canvas_width);
+	uint32_t y1 = (uint32_t)((bottom * dst.height + canvas_height - 1) / canvas_height);
+	bool copied = false;
+	for (uint32_t y = y0; y < y1; ++y) {
+		int64_t logical = (uint64_t)y * canvas_height / dst.height;
+		int64_t sy = (int64_t)source.y + (logical - target.y) * source.height / target.height;
+		if (sy < 0 || sy >= src.height) continue;
+		for (uint32_t x = x0; x < x1; ++x) {
+			logical = (uint64_t)x * canvas_width / dst.width;
+			int64_t sx = (int64_t)source.x + (logical - target.x) * source.width / target.width;
+			if (sx < 0 || sx >= src.width) continue;
+			uint32_t pixel;
+			__builtin_memcpy(&pixel, src.pixels + (uint64_t)sy * src.row_bytes + (uint64_t)sx * 4, 4);
+			pixel = sweet_fb_pack_pixel(pixel, format);
+			__builtin_memcpy(dst.pixels + (uint64_t)y * dst.row_bytes + (uint64_t)x * 4, &pixel, 4);
+			copied = true;
+		}
+	}
+	return copied;
+}

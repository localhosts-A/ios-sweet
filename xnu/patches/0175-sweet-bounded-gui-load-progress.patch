 }
 
 static inline void
 ufs_wr(uint32_t off, uint32_t v)
 {
 	*(volatile uint32_t *)(su.regs + off) = v;
 	__builtin_arm_dsb(0xf);
 }
 
 static inline void
 ufs_ao_wr(uint32_t off, uint32_t v)
 {
 	*(volatile uint32_t *)(su.ao_regs + off) = v;

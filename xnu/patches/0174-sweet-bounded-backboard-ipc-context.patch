 };
 static inline uint64_t
 sweet_bbvm_ceil_ticks(uint64_t ticks, uint64_t ns)
 {
     if (ticks == 0 || ticks == UINT64_MAX)
         return 0;
     return ns < SWEET_BBVM_INTERVAL_NS ? ticks + 1 : ticks;
 }
 /* All policy operations require the recorder's independent nonblocking guard. */
 static inline uint32_t
 sweet_bbvm_enter_record(struct sweet_bbvm_buffer *buffer, uint64_t interval,
     const struct sweet_bbvm_event *event)
 {
     if (interval == 0 || buffer->clock_stopped || buffer->total >= SWEET_BBVM_LIMIT)
         return 0;
     if (buffer->has_last) {
         if (event->start < buffer->last) {
             buffer->clock_stopped = true;
             return 0;
         }
         if (event->start - buffer->last < interval)
             return 0;
     }
     uint32_t token = buffer->total + 1;
     struct sweet_bbvm_slot *slot = &buffer->slots[buffer->total];
     slot->event = *event;
     slot->event.token = token;
     slot->event.version = 1;
     slot->event.result = -1;
     slot->event.end = slot->event.duration = 0;
     slot->event.duration_valid = false;
     slot->exported = 0;
     buffer->total = token;
     buffer->last = event->start;
     buffer->has_last = true;
     return token;
 }
 static inline bool
 sweet_bbvm_leave_record(struct sweet_bbvm_buffer *buffer, uint32_t token,
     uint64_t tid, uint64_t end, int32_t result)
 {
     if (token == 0 || token > buffer->total || token > SWEET_BBVM_LIMIT)
         return false;
     struct sweet_bbvm_event *event = &buffer->slots[token - 1].event;
     if (event->token != token || event->version != 1 || event->tid != tid)
         return false;
     event->end = end;
     event->result = result;
     event->duration_valid = end >= event->start;
     event->duration = event->duration_valid ? end - event->start : 0;
     if (!event->duration_valid)
         buffer->clock_stopped = true;
     event->version = 2;
     ++buffer->completed;
     return true;
 }
 /* A mutable slot needs separate entry/return export state, not a total cursor. */
 static inline uint32_t
 sweet_bbvm_snapshot(struct sweet_bbvm_buffer *buffer, struct sweet_bbvm_event *out)
 {
     uint32_t count = 0;
     for (uint32_t i = 0; i < buffer->total; ++i) {
         struct sweet_bbvm_slot *slot = &buffer->slots[i];
         if (slot->exported == 0) {
             out[count] = slot->event;
             out[count].version = 1;
             out[count].result = -1;
             out[count].end = out[count].duration = 0;
             out[count].duration_valid = false;
             ++count;
             ++buffer->exported_entry;
             slot->exported = 1;
         }
         if (slot->event.version == 2 && slot->exported == 1) {
             out[count++] = slot->event;
             ++buffer->exported_return;
             slot->exported = 2;
         }
     }
     return count;
 }

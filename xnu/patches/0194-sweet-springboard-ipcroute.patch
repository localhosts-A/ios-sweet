+/* Caller holds port lock; kmsg keeps the destination port alive. Scalars only. */
+static void
+sweet_ipcroute_prequeue(ipc_mqueue_t mqueue, ipc_kmsg_t kmsg,
+    ipc_port_t port, mach_msg_option_t option)
+{
+    if (SWEET_IPCSEND_CLOSED(&sweet_ipcroute_book.closed) ||
+        sweet_load_rw_target(current_task()) != 2) return;
+    thread_t thread = current_thread();
+    arm_saved_state_t *state = find_user_regs(thread);
+    struct sweet_ipcroute_record event = {
+        .tid = thread_tid(thread), .at = mach_absolute_time(),
+        .receiver_pid = ipc_port_get_receiver_task_locked(port, NULL),
+        .receiver_port = port->ip_receiver_name,
+        .msg_id = ikm_header(kmsg)->msgh_id, .option = option,
+        .count = mqueue->imq_msgcount, .limit = mqueue->imq_qlimit,
+    };
+    if (state != NULL && is_saved_state64(state) &&
+        PSR64_IS_USER64(get_saved_state_cpsr(state))) {
+        event.pc = get_saved_state_pc(state);
+        event.lr = get_saved_state_lr(state);
+        event.user_context_valid = 1;
+    }
+    sweet_ipcroute_record(&sweet_ipcroute_book, &event);
+}
+
+/* Called by the ordinary sampler only, with no port or producer guard held. */
+static void
+sweet_ipcroute_dump(unsigned int sample, unsigned int final)
+{
+    static struct sweet_ipcroute_snapshot snapshot;
+    if (sweet_ipcroute_snapshot(&sweet_ipcroute_book, &snapshot) != 0) {
+        printf("SWEET IPCROUTE: v=1 s=%u busy=1 final=%u\n", sample, final);
+        return;
+    }
+    printf("SWEET IPCROUTE: v=1 s=%u n=%u seq=0x%llx dropped=%u evicted=%u exhausted=%u final=%u stage=prequeue\n",
+        sample, snapshot.count, (unsigned long long)snapshot.next_seq,
+        snapshot.dropped, snapshot.evictions, snapshot.exhausted, final);
+    for (uint32_t i = 0; i < snapshot.count; ++i) {
+        const struct sweet_ipcroute_record *r = &snapshot.records[i];
+        char receiver_name[32];
+        sweet_ipcsend_receiver_name(r->receiver_pid, receiver_name, (int)sizeof(receiver_name));
+        /* PID/name are unverified dump-time identities; keep output single-token. */
+        for (unsigned int j = 0; j < sizeof(receiver_name) && receiver_name[j]; ++j)
+            if ((unsigned char)receiver_name[j] <= 0x20 || (unsigned char)receiver_name[j] >= 0x7f)
+                receiver_name[j] = '_';
+        printf("SWEET IPCROUTER: v=1 s=%u q=0x%llx th=0x%llx at=0x%llx "
+            "pid=%d port=0x%x name_at_dump=%s id=%d opt=0x%x count=%u limit=%u\n",
+            sample, (unsigned long long)r->seq, (unsigned long long)r->tid,
+            (unsigned long long)r->at, r->receiver_pid, r->receiver_port, receiver_name,
+            r->msg_id, r->option, r->count, r->limit);
+        printf("SWEET IPCROUTEC: v=1 s=%u q=0x%llx pc=0x%llx lr=0x%llx saved=%u\n",
+            sample, (unsigned long long)r->seq, (unsigned long long)r->pc,
+            (unsigned long long)r->lr, r->user_context_valid);
+    }
+}
 

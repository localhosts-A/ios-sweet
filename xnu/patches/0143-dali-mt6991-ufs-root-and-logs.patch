+{
+	uint32_t gate0 = ufs_ao_rd(DALI_UFS_AO_GATE0);
+	uint32_t gate1 = ufs_ao_rd(DALI_UFS_AO_GATE1);
+	if (gate0 == UINT32_MAX || gate1 == UINT32_MAX) {
+		printf("SWEET UFS: invalid MT6991 AO MMIO gate0=0x%x gate1=0x%x\n", gate0, gate1);
+		return ENXIO;

 static void
 sweet_load_register(unsigned int phase, struct arm_saved_state *state)
 {
     if (!sweet_load_configured || phase != 0) return;
     uint32_t control = os_atomic_load(&sweet_load_control, acquire);
     if (!sweet_load_admitting(control) || (control & SWEET_LOAD_CLAIMS) == SWEET_LOAD_CLAIMS ||
         state == NULL || !is_saved_state64(state) || !PSR64_IS_USER64(get_saved_state_cpsr(state))) return;
     proc_t p = current_proc();
     if (p == PROC_NULL) return;
     unsigned int kind = sweet_load_kind(p->p_comm);
     if (kind == SWEET_LOAD_TARGETS || (control & (1u << kind))) return;
     task_t task = current_task();
     if (task == TASK_NULL) return;
     if (!os_atomic_cmpxchg(&sweet_load_control, control, control | (1u << kind), acq_rel)) {
         os_atomic_store(&sweet_load_missed, 1u, relaxed);
         return;
     }
     /* One reference per claimed slot, deliberately retained until reboot. */
     task_reference(task);
     struct proc_ident ident = proc_ident(p);
     sweet_load_slots[kind] = (struct sweet_load_slot){
         .task = task, .pid = ident.p_pid, .version = ident.p_idversion,
         .uniqueid = ident.p_uniqueid, .registered = mach_absolute_time(),
     };
     os_atomic_or(&sweet_load_ready, 1u << kind, release);
 }
 
 static void
 sweet_load_dump(unsigned int sample)
 {
     if (!sweet_load_configured || sample >= SWEET_LOAD_SAMPLES || sample != sweet_load_dumped ||
         !(os_atomic_load(&sweet_load_control, acquire) & SWEET_LOAD_OPEN)) return;
     ++sweet_load_dumped;
     if (sample == SWEET_LOAD_SAMPLES - 1) {
         os_atomic_or(&sweet_load_control, SWEET_LOAD_CLOSED, acq_rel);
         sweet_ufs_load_close();
     }
     uint32_t ready = os_atomic_load(&sweet_load_ready, acquire);
     uint32_t claims = os_atomic_load(&sweet_load_control, acquire) & SWEET_LOAD_CLAIMS;
     printf("SWEET LOAD: v=1 s=%u at=0x%llx claims=0x%x ready=0x%x miss=%u final=%u\n",
         sample, (unsigned long long)mach_absolute_time(), claims, ready,
         os_atomic_load(&sweet_load_missed, relaxed), sample == SWEET_LOAD_SAMPLES - 1);
     for (unsigned int i = 0; i < SWEET_LOAD_TARGETS; ++i) {
         if (!(ready & (1u << i))) continue;
         const struct sweet_load_slot *slot = &sweet_load_slots[i];
         sweet_load_collect(slot->task, &sweet_load_copy);
         char line[SWEET_LOAD_LINE_BYTES];
         if (sweet_load_process_format(line, sizeof(line), sample, i, slot->pid,
             slot->uniqueid, slot->version, slot->registered, &sweet_load_copy)) printf("%s", line);
         for (unsigned int j = 0; j < sweet_load_copy.captured; ++j) {
             if (sweet_load_thread_format(line, sizeof(line), sample, i, j,
                 &sweet_load_copy.threads[j])) printf("%s", line);
+            if (os_atomic_load(&sweet_load_rw_configured, acquire)) {
+                if (sweet_load_rw_format(line, sizeof(line), sample, i, j, &sweet_load_copy.threads[j])) {
+                    printf("%s", line);
+                } else {
+                    printf("SWEET LOADRW: v=1 s=%u g=%u j=%u th=0x%llx q=8 gn=0x0\n",
+                        sample, i, j, (unsigned long long)sweet_load_copy.threads[j].tid);
+                }
+            }
         }
     }
     sweet_ufs_load_dump(sample);
 }
 
 void sweet_ff_trace(unsigned int, int, struct arm_saved_state *);
 
 /* Current-thread state only: no user-memory reads or process iteration. */
 void
 sweet_ff_trace(unsigned int phase, int call, struct arm_saved_state *state)
 {
     sweet_load_register(phase, state);
     if (!sweet_ff_svc_mode(sweet_ff_enabled))
         return;
     proc_t p = current_proc();
     if (p == PROC_NULL || !sweet_ff_target(sweet_ff_enabled, p->p_comm) ||
         !is_saved_state64(state))
         return;
     if (!OSCompareAndSwap(0, 1, &sweet_ff_guard)) {
         (void)OSCompareAndSwap(0, 1, &sweet_ff_dropped);
         return;
     }
     struct sweet_ff_event event = {
         .phase = phase, .pid = proc_pid(p), .call = call,
         .tid = thread_tid(current_thread()),
         .pc = get_saved_state_pc(state), .lr = get_saved_state_lr(state),
         .sp = get_saved_state_sp(state), .x0 = get_saved_state_reg(state, 0),
         .cpsr = get_saved_state_cpsr(state),
     };
     bool accepted = sweet_ff_record(&sweet_ff_events, &event);
     if (accepted && phase == 0 && call == -47 &&
         OSCompareAndSwap(1, 1, &sweet_bbipc_open) &&
         PSR64_IS_USER64(get_saved_state_cpsr(state))) {
         struct sweet_bbipc_event context = {
             .seq = sweet_ff_events.total, .pid = event.pid, .tid = event.tid,
             .abstime = mach_absolute_time(),
         };
         for (unsigned int i = 0; i < 7; ++i)
             context.words[i] = get_saved_state_reg(state, i + 1);
         sweet_bbipc_record(&sweet_bbipc_events, &context);
     }
     (void)OSCompareAndSwap(1, 0, &sweet_ff_guard);
 }
 
 

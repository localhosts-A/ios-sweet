+
+bool DaliUSBPower::readADC(unsigned channel, unsigned *mv)
+{
+    /* MiCode e45c319 mt6379-adc.c and mediatek,mt6379_adc.h:
+     * SID14 CONFG2=14f low5 oneshot/channel; report mux155, BE16 at156/157.
+     * PDVBUS=11, CHGVIN=1; raw unit1mV (IIO processed scale1000 to uV).
+     * This power client's lock owns the whole conversion/mux interval; no
+     * other native ADC client exists. RTC SID9 may interleave PMIF transfers.
+     * Never change ADC_CONFG1/VBATMON/ZCV, calibrations or protections.
+     */
+    if (adcFault || !mv || (channel != 1 && channel != 11)) { return false; }
+    uint8_t config = 0, savedReport = 0;
+    if (!read8(0x14f, &config) || !read8(0x155, &savedReport) || config != 0) {
+        adcFault = true;
+        kprintf("DALI ADC: idle guard failed channel=%u cfg=%02x pmif=%08x\n",
+            channel, config, status);
+        return false;
+    }
+    const char *phase = "trigger";
+    uint8_t request = (uint8_t)channel;
+    bool ok = dali_pmif_transfer(14, 0x14f, &request, true, &status);
+    bool reportTouched = false, restored = true;
+    uint16_t wire = 0;
+    if (ok) {
+        IOSleep(5); /* Vendor conversion minimum4.4ms. */
+        phase = "conversion";
+        bool idle = false;
+        for (unsigned i = 0; i < 10; ++i) {
+            if (!read8(0x14f, &config)) { break; }
+            if (config == 0) { idle = true; break; }
+            IODelay(100);
+        }
+        ok = idle; /* No cancel/reset/retry on an uncertain conversion. */
+    }
+    if (ok) {
+        phase = "report select";
+        reportTouched = true; /* Dirty before any possible mux write. */
+        ok = update(0x155, 0x1f, (uint8_t)channel);
+    }
+    if (ok) {
+        IOSleep(1);
+        phase = "report data";
+        ok = dali_pmif_read16(14, 0x156, &wire, &status);
+    }
+    if (reportTouched) {
+        restored = update(0x155, 0x1f, savedReport);
+    }
+    unsigned value = ((wire & 0xffU) << 8) | (wire >> 8);
+    if (!ok || !restored || value > 30000) {
+        adcFault = true; /* Permanent refusal for this diagnostic boot. */
+        kprintf("DALI ADC: failed channel=%u phase=%s cfg=%02x raw=%u mux=%s pmif=%08x\n",
+            channel, phase, config, value,
+            !reportTouched ? "untouched" : restored ? "restored" : "FAILED", status);
+        return false;
+    }
+    *mv = value;
+    return true;
 }
 

+/* Bind an extended result to a fresh host-supplied nonce, even with auto-return
+ * disabled. All three boot arguments must be explicitly zero. The run-id is
+ * 32 lowercase ASCII hex bytes without a terminator in the device tree.
+ */
+static bool
+ufs_dali_extended_configuration(char run_id[33])
+{
+	uint32_t auto_return = 1, rw = 1, logger = 1;
+	DTEntry node;
+	const void *prop = NULL;
+	unsigned int size = 0;
+	if (!PE_parse_boot_argn("dalifastboot", &auto_return, sizeof(auto_return)) || auto_return ||
+	    !PE_parse_boot_argn("ufsrw", &rw, sizeof(rw)) || rw ||
+	    !PE_parse_boot_argn("sweetlog", &logger, sizeof(logger)) || logger ||
+	    SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "dali-ufs-run-id", &prop, &size) != kSuccess ||
+	    prop == NULL || size != 32) return false;
+	const uint8_t *bytes = prop;
+	for (unsigned int i = 0; i < 32; ++i)
+		if (!((bytes[i] >= '0' && bytes[i] <= '9') ||
+		    (bytes[i] >= 'a' && bytes[i] <= 'f'))) return false;
+	memcpy(run_id, bytes, 32);
+	run_id[32] = '\0';
+	return true;
+}

+		goto failed;
+	}
+	su.failure_stage = "uic-prelink-hibern8";
+	value = 0;
+	if ((error = ufs_mtk_uic("uic-prelink-hibern8", 2, 0x155e, &value)) != 0) {
+		goto failed;
+	}

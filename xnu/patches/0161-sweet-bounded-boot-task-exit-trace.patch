--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1448,6 +1448,40 @@
  * to zombie, and unlink proc from allproc and parent's lists.  Save exit
  * status and rusage for wait().  Check for child processes and orphan them.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+static void
+sweet_boot_task_exit(proc_t p, const char *phase, int status)
+{
+	unsigned int enabled = 0;
+	if (!PE_parse_boot_argn("sweettasktrace", &enabled, sizeof(enabled)) || enabled != 1)
+		return;
+	static const char *const names[] = {
+		"launchd", "usermanagerd", "dirs_cleaner", "xpcroleaccountd",
+		"init_featureflag", "notifyd", "backboardd", "SpringBoard"
+	};
+	bool wanted = false;
+	for (unsigned int i = 0; i < sizeof(names) / sizeof(names[0]); ++i)
+		if (strcmp(p->p_comm, names[i]) == 0)
+			wanted = true;
+	if (!wanted)
+		return;
+	static volatile UInt32 lines;
+	UInt32 value = (UInt32)OSAddAtomic(0, &lines);
+	for (;;) {
+		if (value >= 64)
+			return;
+		if (OSCompareAndSwap(value, value + 1, &lines))
+			break;
+		value = (UInt32)OSAddAtomic(0, &lines);
+	}
+	printf("SWEET BOOTTASK: %s name=%s pid=%d waitstatus=0x%x event=%u\n",
+	    phase, p->p_comm, proc_getpid(p), (unsigned int)status, value + 1);
+}
+#endif
+
 int
 exit1(proc_t p, int rv, int *retval)
 {
@@ -1473,6 +1507,9 @@
 	struct uthread *ut;
 	int error = 0;
 	bool proc_exiting = false;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_boot_task_exit(p, "exit-request", rv);
+#endif
 
 #if DEVELOPMENT || DEBUG
 	/*
@@ -2152,6 +2189,9 @@
 	proc_unlock(p);
 	pid = proc_getpid(p);
 	exitval = p->p_xstat;
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_boot_task_exit(p, "exit-final", exitval);
+#endif
 	KERNEL_DEBUG_CONSTANT_IST(KDEBUG_COMMON,
 	    BSDDBG_CODE(DBG_BSD_PROC, BSD_PROC_EXIT) | DBG_FUNC_START,
 	    pid, exitval, 0, 0, 0);

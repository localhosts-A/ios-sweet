new file mode 100644
--- /dev/null
+++ b/bsd/kern/SweetGUIExecPolicy.h
@@ -0,0 +1,32 @@
+/* Fixed GUI exec targets and independent bounded observation budgets. */
+#ifndef SWEET_GUI_EXEC_POLICY_H
+#define SWEET_GUI_EXEC_POLICY_H
+
+#define SWEET_GUI_EXEC_TARGETS 5u
+#define SWEET_GUI_EXEC_LIMIT 32u
+
+static const char *const sweet_gui_exec_names[SWEET_GUI_EXEC_TARGETS] = {
+    "SpringBoard", "backboardd", "xpcproxy", "notifyd", "runningboardd"
+};
+
+static inline unsigned int
+sweet_gui_exec_kind(const char *name)
+{
+    if (name == NULL)
+        return SWEET_GUI_EXEC_TARGETS;
+    for (unsigned int i = 0; i < SWEET_GUI_EXEC_TARGETS; ++i)
+        if (strncmp(name, sweet_gui_exec_names[i], strlen(sweet_gui_exec_names[i]) + 1) == 0)
+            return i;
+    return SWEET_GUI_EXEC_TARGETS;
+}
+
+static inline unsigned int
+sweet_gui_exec_ticket(volatile UInt32 *counter)
+{
+    UInt32 value = (UInt32)OSAddAtomic(0, counter);
+    if (value >= SWEET_GUI_EXEC_LIMIT)
+        return 0;
+    /* One attempt only: a contending observation is dropped, never waited for. */
+    return OSCompareAndSwap(value, value + 1, counter) ? value + 1 : 0;
+}
+#endif

+/* Last successfully observed prequeue send per SpringBoard thread. This is a
+ * lossy route hint, not evidence of send success or of the current receive peer. */
+#define SWEET_IPCROUTE_CAPACITY 16u
+struct sweet_ipcroute_record {
+    uint64_t seq, tid, at, pc, lr;
+    int32_t receiver_pid, msg_id;
+    uint32_t receiver_port, option, count, limit, user_context_valid;
+};
+struct sweet_ipcroute_book {
+    volatile uint32_t guard, closed, dropped;
+    uint32_t count, evictions, exhausted;
+    uint64_t next_seq;
+    struct sweet_ipcroute_record records[SWEET_IPCROUTE_CAPACITY];
+};
+struct sweet_ipcroute_snapshot {
+    uint32_t count, evictions, dropped, exhausted;
+    uint64_t next_seq;
+    struct sweet_ipcroute_record records[SWEET_IPCROUTE_CAPACITY];
+};
+_Static_assert(sizeof(struct sweet_ipcroute_book) + sizeof(struct sweet_ipcroute_snapshot) <= 4096,
+    "bounded per-thread send routes");
+
+/* The port is locked by the caller. No locks taken apart from this one try-CAS. */
+static inline void
+sweet_ipcroute_record(struct sweet_ipcroute_book *book, const struct sweet_ipcroute_record *record)
+{
+    if (!book || !record || !record->tid || SWEET_IPCSEND_CLOSED(&book->closed)) return;
+    if (!SWEET_IPCSEND_CAS(0, 1, &book->guard)) {
+        SWEET_IPCSEND_INC(&book->dropped);
+        return;
+    }
+    if (!SWEET_IPCSEND_CLOSED(&book->closed)) {
+        unsigned int i, selected = SWEET_IPCROUTE_CAPACITY;
+        uint64_t oldest = UINT64_MAX;
+        for (i = 0; i < book->count; ++i) {
+            if (book->records[i].tid == record->tid) {
+                selected = i;
+                break;
+            }
+            if (book->records[i].seq < oldest) {
+                oldest = book->records[i].seq;
+                selected = i;
+            }
+        }
+        if (book->next_seq == UINT64_MAX) {
+            book->exhausted = 1;
+        } else {
+            if (i == book->count) {
+                if (book->count < SWEET_IPCROUTE_CAPACITY) selected = book->count++;
+                else if (book->evictions != UINT32_MAX) ++book->evictions;
+            }
+            book->records[selected] = *record;
+            book->records[selected].seq = ++book->next_seq;
+        }
+    }
+    (void)SWEET_IPCSEND_CAS(1, 0, &book->guard);
+}
+
+static inline void
+sweet_ipcroute_close(struct sweet_ipcroute_book *book)
+{
+    if (book) SWEET_IPCSEND_CLOSE(&book->closed);
+}
+
+/* Called by the one ordinary sampler, never from a locked IPC path. */
+static inline int
+sweet_ipcroute_snapshot(struct sweet_ipcroute_book *book, struct sweet_ipcroute_snapshot *out)
+{
+    if (!book || !out) return -1;
+    unsigned int tries;
+    for (tries = 0; tries < 128; ++tries) {
+        if (SWEET_IPCSEND_CAS(0, 1, &book->guard)) break;
+    }
+    if (tries == 128) return -1;
+    out->count = book->count;
+    out->evictions = book->evictions;
+    out->dropped = SWEET_IPCSEND_LOAD(&book->dropped);
+    out->exhausted = book->exhausted;
+    out->next_seq = book->next_seq;
+    for (uint32_t i = 0; i < book->count; ++i) out->records[i] = book->records[i];
+    (void)SWEET_IPCSEND_CAS(1, 0, &book->guard);
+    return 0;
+}
+
 void sweet_ipcsend_close(void);
 void sweet_ipcsend_dump(unsigned int sample, unsigned int final);

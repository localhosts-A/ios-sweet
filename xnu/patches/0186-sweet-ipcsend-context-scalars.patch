index 113b4ba..3d8be8a 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -312,6 +312,19 @@ extern void sweet_ufs_load_close(void);
 extern void sweet_ufs_load_dump(unsigned int);
 extern void sweet_load_collect(task_t, struct sweet_load_snapshot *);
 
+#if DEVELOPMENT && defined(ARM64_BOARD_CONFIG_SWEET)
+/* Called from the ordinary ring dump after dropping IPC locks; dump-time only. */
+void
+sweet_ipcsend_receiver_name(int pid, char *name, int size)
+{
+    if (name == NULL || size <= 0) return;
+    strlcpy(name, "unknown", (size_t)size);
+    if (pid <= 0) return;
+    proc_name(pid, name, size);
+    if (name[0] == '\0') strlcpy(name, "unknown", (size_t)size);
+}
+#endif
+
 static bool sweet_load_configured;
 static uint32_t sweet_load_control, sweet_load_ready, sweet_load_missed;
 static unsigned int sweet_load_dumped;

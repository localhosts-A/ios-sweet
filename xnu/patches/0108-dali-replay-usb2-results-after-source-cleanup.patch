+/* Called and reported under the caller's existing DaliUSBPower lock.
+ * Keep only diagnostic text in fixed memory; replay never touches MMIO.
+ */
+struct U2Report {
+    char text[2048];
+    unsigned size;
+    bool called, requested, reached, truncated;
+};
+U2Report u2Report = {};
+
+void u2Log(const char *format, ...) {
+    char line[256];
+    va_list args;
+    va_start(args, format);
+    int length = vsnprintf(line, sizeof(line), format, args);
+    va_end(args);
+    if (length < 0) { u2Report.truncated = true; return; }
+    kprintf("%s", line);
+    if ((unsigned)length >= sizeof(line) ||
+        (unsigned)length >= sizeof(u2Report.text) - u2Report.size) {
+        u2Report.truncated = true; return;
+    }
+    memcpy(u2Report.text + u2Report.size, line, (unsigned)length);
+    u2Report.size += (unsigned)length;
+    u2Report.text[u2Report.size] = 0;
+}

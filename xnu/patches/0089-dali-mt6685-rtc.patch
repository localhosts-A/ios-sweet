+
+void
+SweetPlatformExpert::getUTCTimeOfDay(clock_sec_t *secs, clock_nsec_t *nsecs)
+{
+	if (!dali_rtc_get_utc(secs, nsecs)) {
+		IODTPlatformExpert::getUTCTimeOfDay(secs, nsecs);
+	}
+}
+
+void
+SweetPlatformExpert::setUTCTimeOfDay(clock_sec_t secs, clock_nsec_t nsecs)
+{
+	if (!dali_rtc_set_utc(secs, nsecs)) {
+		IODTPlatformExpert::setUTCTimeOfDay(secs, nsecs);
+	}
+}
 

     if (!snapshotStable) {
         kprintf("DALI HOST: SPM/gate snapshot changed; controller untouched\n"); return;
     }
+    /* Match vendor ssusb_reset(): MTK gates the USB MAC/PHY clock for 1 ms and
+     * releases it before requesting host power. The fastboot handoff leaves the
+     * USB2 MAC/PHY state machines in device mode; XNU never pulsed this gate.
+     */
+    uint32_t aoClkBefore = requestGates.read(0);
+    daliScanDigest.aoClkBefore = aoClkBefore;
+    if (aoClkBefore == ~0U || (aoClkBefore & 0x13U)) {
+        kprintf("DALI HOST: USB clkgate pulse rejected read=%08x\n", aoClkBefore);
+        return;
+    }
+    requestGates.write(0, aoClkBefore | 0x13U);
+    IODelay(1000); /* Native ssusb_reset() gates USB clocks for 1 ms. */
+    requestGates.write(0, aoClkBefore & ~0x13U);
+    uint32_t aoClkAfter = requestGates.read(0);
+    daliScanDigest.aoClkAfter = aoClkAfter;
+    if (aoClkAfter != aoClkBefore) {
+        kprintf("DALI HOST: USB clkgate pulse restore failed read=%08x\n", aoClkAfter);
+        return;
+    }
+    kprintf("DALI HOST: USB clkgate pulse before=%08x after=%08x\n", aoClkBefore, aoClkAfter);

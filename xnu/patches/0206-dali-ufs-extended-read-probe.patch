+/* The whole experiment range is checked before every pass. The 1MiB bounce
+ * buffer and READ(10) are unchanged. Copies/comparisons are in the reported
+ * wall time; command timeout may extend the experiment deadline by up to 5s.
+ */
+static int
+ufs_dali_extended_read_pass(void *reference, size_t reference_bytes,
+    unsigned int window, bool compare, uint64_t until, struct dali_speed_sample *sample)
+{
+    if (sample == NULL) return EINVAL;
+    bzero(sample, sizeof(*sample));
+    if (!su.dali || su.ready || !su.hsg1_active || su.command_poisoned ||
+        !su.capacity_valid || reference == NULL || reference_bytes != DALI_EXT_WINDOW_BYTES ||
+        window >= DALI_EXT_WINDOWS || su.nblocks < DALI_EXT_TOTAL_BLOCKS ||
+        su.nblocks > DALI_ROOT_MAX_BLOCKS || su.first_block > UINT32_MAX ||
+        DALI_EXT_TOTAL_BLOCKS - 1 > UINT32_MAX - su.first_block ||
+        su.first_block >= su.capacity_blocks ||
+        DALI_EXT_TOTAL_BLOCKS > su.capacity_blocks - su.first_block) {
+        sample->error = EINVAL;
+        return sample->error;
+    }
+    uint64_t first = su.first_block + DALI_SPEED_BLOCKS +
+        (uint64_t)window * DALI_EXT_WINDOW_BLOCKS;
+    uint64_t last = sample->begin = mach_absolute_time();
+    if (last >= until) {
+        sample->end = last;
+        sample->error = ETIMEDOUT;
+        return sample->error;
+    }
+    for (unsigned int offset = 0; offset < DALI_EXT_WINDOW_BYTES; offset += BOUNCE_SIZE) {
+        uint64_t now = mach_absolute_time();
+        if (now < last || now >= until) {
+            sample->error = ETIMEDOUT;
+            break;
+        }
+        last = now;
+        int error = ufs_read_blocks(first + offset / UFS_BLOCK, BOUNCE_SIZE / UFS_BLOCK);
+        sample->commands++;
+        if (error) {
+            sample->error = error;
+            break;
+        }
+        const void *bounce = (const void *)(su.dma + DMA_BOUNCE);
+        uint8_t *saved = (uint8_t *)reference + offset;
+        if (compare) {
+            if (memcmp(saved, bounce, BOUNCE_SIZE) != 0) {
+                sample->error = EIO;
+                break;
+            }
+        } else {
+            memcpy(saved, bounce, BOUNCE_SIZE);
+        }
+        sample->bytes += BOUNCE_SIZE;
+    }
+    sample->end = mach_absolute_time();
+    if ((sample->end < last || sample->end >= until) && !sample->error)
+        sample->error = ETIMEDOUT;
+    return sample->error;
+}

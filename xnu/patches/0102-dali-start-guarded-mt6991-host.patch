+class WriteMapping {
+    IOMemoryDescriptor *memory = nullptr;
+    IOMemoryMap *map = nullptr;
+    vm_offset_t io = 0;
+    uint32_t length = 0;
+public:
+    bool open(uint64_t address, uint32_t size) {
+        length = size;
+        memory = IOMemoryDescriptor::withPhysicalAddress(address, size, kIODirectionInOut);
+        map = memory ? memory->map(kIOMapInhibitCache) : nullptr;
+        if (map) { io = map->getVirtualAddress(); }
+        return io != 0;
+    }
+    uint32_t read(uint32_t offset) const {
+        if (!io || (offset & 3) || length < 4 || offset > length - 4) { return ~0U; }
+        uint32_t value = *(volatile const uint32_t *)(io + offset);
+        __asm__ volatile("dmb oshld" ::: "memory");
+        return value;
+    }
+    void write(uint32_t offset, uint32_t value) const {
+        if (!io || (offset & 3) || length < 4 || offset > length - 4) { return; }
+        __asm__ volatile("dmb oshst" ::: "memory");
+        *(volatile uint32_t *)(io + offset) = value;
+        __asm__ volatile("dsb sy" ::: "memory");
+    }
+    ~WriteMapping() { OSSafeReleaseNULL(map); OSSafeReleaseNULL(memory); }
+};

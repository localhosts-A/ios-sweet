 boolean_t
 lck_rw_lock_exclusive_b(
 	lck_rw_t        *lock,
 	bool            (^lock_pause)(void))
 {
 	assert(!lock->lck_rw_can_sleep);
 
 	return lck_rw_lock_exclusive_internal_inline(lock, __builtin_return_address(0), lock_pause);

+
+/* Native MTU3 checks these clock/reset bits after enabling the U3 host port. */
+constexpr uint32_t kMtu3U3ClockMask = 0x10501U; /* U3 MAC, SYS125, REF, SYSPLL */
+
+/* Apply only the Dali MTU3 host fields declared in the live USB0 device tree.
+ * Preserve unrelated register bits, verify every write, and restore the owned
+ * saved tuning masks after xHCI has stopped. MTU3 leaves its internal forced-VBUS
+ * bits disabled in host mode; external source power remains with DaliUSBPower.
+ */
+class ScopedMtu3HostMac {
+    struct Field { uint32_t offset, mask, value, saved; bool dirty, leaveDisabled; };
+    WriteMapping mac;
+    bool opened = false;
+    Field fields[6] = {
+        {0x1420, 0x3ffffU, 1U, 0, false, false},       /* gen1-txdeemph */
+        {0x1428, 0x3ffffU, 1U, 0, false, false},       /* CP5/CP7 txdeemph */
+        {0x2450, 0x00000fffU, 0x474U, 0, false, false},/* eusb2-cm-l1 */
+        {0x0c84, 0x00000003U, 0U, 0, false, true},     /* force-vbus=false */
+        {0x2420, 1U << 26, 1U << 26, 0, false, false},/* SOF_KEEP */
+        {0x1680, 0x3fffU << 16, 1U << 16, 0, false, false}, /* ldm-resp-delay=1 */
+    };
+public:
+    bool apply() {
+        if (!mac.open(0x16701000ULL, 0x2e00U)) {
+            u2Log("DALI MTU3: MAC map failed; host tuning untouched\n");
+            return false;
+        }
+        opened = true;
+        for (unsigned i = 0; i < 6; ++i) {
+            uint32_t value = mac.read(fields[i].offset);
+            if (value == ~0U) {
+                u2Log("DALI MTU3: snapshot failed offset=%04x\n", fields[i].offset);
+                return false;
+            }
+            fields[i].saved = value & fields[i].mask;
+        }
+        for (unsigned i = 0; i < 6; ++i) {
+            Field &field = fields[i];
+            uint32_t current = mac.read(field.offset);
+            if (current == ~0U || (current & field.mask) != field.saved) {
+                u2Log("DALI MTU3: snapshot changed offset=%04x read=%08x\n",
+                    field.offset, current);
+                return false;
+            }
+            if ((current & field.mask) == field.value) { continue; }
+            field.dirty = true;
+            mac.write(field.offset, (current & ~field.mask) | field.value);
+            uint32_t after = mac.read(field.offset);
+            if (after == ~0U || (after & field.mask) != field.value) {
+                u2Log("DALI MTU3: field write rejected offset=%04x read=%08x\n",
+                    field.offset, after);
+                return false;
+            }
+        }
+        u2Log("DALI MTU3: host init tuning ready fields=6\n");
+        return true;
+    }
+
+    bool restore() {
+        if (!opened) { return true; }
+        bool ok = true;
+        for (unsigned i = 6; i-- > 0;) {
+            Field &field = fields[i];
+            if (!field.dirty) { continue; }
+            uint32_t current = mac.read(field.offset);
+            if (current == ~0U) { ok = false; continue; }
+            uint32_t restoreValue = field.leaveDisabled ? field.value : field.saved;
+            mac.write(field.offset, (current & ~field.mask) | restoreValue);
+            uint32_t after = mac.read(field.offset);
+            bool matched = after != ~0U && (after & field.mask) == restoreValue;
+            field.dirty = !matched;
+            ok = matched && ok;
+            u2Log("DALI MTU3: restore offset=%04x read=%08x match=%u\n",
+                field.offset, after, matched);
+        }
+        u2Log("DALI MTU3: owned host fields restored=%u\n", ok);
+        return ok;
+    }
 };
 

+/* Shared physical-to-logical HID normalization; no hardware access. */
+#ifndef SWEET_HID_GEOMETRY_H
+#define SWEET_HID_GEOMETRY_H
+#include <stdbool.h>
+#include <stdint.h>
+
+static inline bool
+sweet_hid_normalize(int32_t x, int32_t y, int32_t physical_width, int32_t physical_height,
+    int32_t logical_width, int32_t logical_height, bool scaled, int32_t *nx, int32_t *ny)
+{
+	if (!nx || !ny || physical_width <= 0 || physical_height <= 0 ||
+	    logical_width <= 0 || logical_height <= 0 || physical_width > 16384 ||
+	    physical_height > 16384 || logical_width > 16384 || logical_height > 16384)
+		return false;
+	if (!scaled && (logical_width < physical_width || logical_height < physical_height))
+		return false;
+	x = x < 0 ? 0 : (x >= physical_width ? physical_width - 1 : x);
+	y = y < 0 ? 0 : (y >= physical_height ? physical_height - 1 : y);
+	int32_t dx = scaled ? 0 : (logical_width - physical_width) / 2;
+	int32_t dy = scaled ? 0 : (logical_height - physical_height) / 2;
+	*nx = (int32_t)(((int64_t)(x + dx) * 65536) / (scaled ? physical_width : logical_width));
+	*ny = (int32_t)(((int64_t)(y + dy) * 65536) / (scaled ? physical_height : logical_height));
+	return true;
+}
+#endif

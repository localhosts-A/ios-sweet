+/* Return whether the original U2 port state is intact, including skips.
+ * This is the MTU3 host-enable port RMW followed by its inverse. The xHCI
+ * engine stays halted; PORTSC and PHY accesses below are reads only.
+ */
+bool observeU2Port(WriteMapping &ip, const ReadMapping &xhci,
+    unsigned op, unsigned ports) {
+    uint32_t saved = ip.read(0x50), u3 = ip.read(0x30);
+    uint32_t cmd = xhci.read(op), sts = xhci.read(op + 4);
+    if (saved == ~0U || u3 == ~0U || (saved & 3U) != 3U ||
+        (u3 & 3U) != 3U || !(ip.read(8) & 1U) || cmd != 0U ||
+        sts == ~0U || !(sts & 1U) || ip.read(0x24) != 0x101U) {
+        kprintf("DALI U2: entry rejected port=%08x U3=%08x cmd=%08x sts=%08x\n",
+            saved, u3, cmd, sts);
+        return true; /* No port was changed. */
+    }
+    /* SSUSB_U2_PORT_HOST_SEL is HOST(bit2) | VBUSVALID(bit9),
+     * not just bit2. Preserve OTG/IDDIG/other firmware fields.
+     */
+    uint32_t wanted = (saved & ~3U) | 0x204U;
+    ip.write(0x50, wanted);
+    uint32_t enabled = ip.read(0x50);
+    bool control = enabled == wanted;
+    bool ready = control && waitBits(ip, 0x14, 1U, 1U, 100, 100);
+    kprintf("DALI U2: enable saved=%08x want=%08x read=%08x ctrl=%u\n",
+        saved, wanted, enabled, control);
+    kprintf("DALI U2: MAC ready=%u sts=%08x/%08x\n",
+        ready, ip.read(0x10), ip.read(0x14));
+    if (ready) {
+        ReadMapping phy;
+        if (phy.open(0x16730000, 0x400)) {
+            kprintf("DALI U2: PHY acr0=%08x acr4=%08x acr6=%08x dcr1=%08x\n",
+                phy.read(0x300), phy.read(0x310), phy.read(0x318), phy.read(0x364));
+            kprintf("DALI U2: PHY dtm0=%08x dtm1=%08x reserve=%08x/%08x ref=%08x\n",
+                phy.read(0x368), phy.read(0x36c), phy.read(0x330), phy.read(0x334),
+                phy.read(0x344));
+        } else { kprintf("DALI U2: PHY mapping failed\n"); }
+        for (unsigned sample = 0; sample < 3; ++sample) {
+            if (sample) { IOSleep(100); }
+            if ((ip.read(0x10) & 0xd01U) != 0xd01U || !(ip.read(0x14) & 1U) ||
+                xhci.read(op) != 0U || !(xhci.read(op + 4) & 1U)) {
+                kprintf("DALI U2: observation stopped clock/engine state changed\n"); break;
+            }
+            for (unsigned port = 0; port < ports; ++port) {
+                uint32_t sc = xhci.read(op + 0x400U + port * 0x10U);
+                if (sc == ~0U) {
+                    kprintf("DALI U2: PORTSC read invalid port=%u\n", port + 1); break;
+                }
+                kprintf("DALI U2: PORTSC sample=%u port=%u raw=%08x ccs=%u ped=%u speed=%u\n",
+                    sample, port + 1, sc, sc & 1U, (sc >> 1) & 1U, (sc >> 10) & 0xfU);
+            }
+        }
+    }
+    /* Disable/power down the port before the existing host-PDN handshake.
+     * Never release the SPM request if this exact restoration fails.
+     */
+    ip.write(0x50, saved);
+    uint32_t after = ip.read(0x50);
+    bool restored = after == saved;
+    kprintf("DALI U2: restore want=%08x read=%08x match=%u\n", saved, after, restored);
+    return restored;
+}
 }
 

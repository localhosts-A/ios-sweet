diff --git a/osfmk/kern/SweetLoadProgress.h b/osfmk/kern/SweetLoadProgress.h
new file mode 100644
--- /dev/null
+++ b/osfmk/kern/SweetLoadProgress.h
@@ -0,0 +1,83 @@
+/* Fixed first-SVC identities and scalar-only GUI scheduling observations. */
+#ifndef SWEET_LOAD_PROGRESS_H
+#define SWEET_LOAD_PROGRESS_H
+#define SWEET_LOAD_TARGETS 2u
+#define SWEET_LOAD_THREADS 8u
+#define SWEET_LOAD_SAMPLES 40u
+#define SWEET_LOAD_OPEN 4u
+#define SWEET_LOAD_CLOSED 8u
+#define SWEET_LOAD_CLAIMS 3u
+#define SWEET_LOAD_LINE_BYTES 256u
+#define SWEET_LOAD_OK 0u
+#define SWEET_LOAD_BUSY 1u
+#define SWEET_LOAD_INACTIVE 2u
+
+struct sweet_load_thread {
+    uint64_t tid, begin, end, user, system;
+    uint32_t status, state, hint;
+    int32_t priority, base_priority, wait_result;
+};
+struct sweet_load_snapshot {
+    uint64_t begin, end, user, system;
+    uint32_t status, thread_count, captured;
+    struct sweet_load_thread threads[SWEET_LOAD_THREADS];
+};
+
+static inline unsigned int
+sweet_load_kind(const char *name)
+{
+    if (strcmp(name, "backboardd") == 0) return 0;
+    if (strcmp(name, "SpringBoard") == 0) return 1;
+    return SWEET_LOAD_TARGETS;
+}
+
+static inline bool
+sweet_load_admitting(uint32_t control)
+{
+    return (control & (SWEET_LOAD_OPEN | SWEET_LOAD_CLOSED)) == SWEET_LOAD_OPEN;
+}
+
+static inline int
+sweet_load_process_format(char *line, unsigned int bytes, unsigned int sample,
+    unsigned int slot, int32_t pid, uint64_t uniqueid, uint32_t version,
+    uint64_t registered, const struct sweet_load_snapshot *p)
+{
+    int n;
+    if (p->status != SWEET_LOAD_OK) {
+        n = snprintf(line, bytes,
+            "SWEET LOADP: v=1 s=%u g=%u p=%d id=0x%llx iv=0x%x rg=0x%llx q=%u\n",
+            sample, slot, pid, (unsigned long long)uniqueid, version,
+            (unsigned long long)registered, p->status);
+    } else {
+        n = snprintf(line, bytes,
+            "SWEET LOADP: v=1 s=%u g=%u p=%d id=0x%llx iv=0x%x rg=0x%llx q=0 n=0x%x c=%u "
+            "b=0x%llx z=0x%llx u=0x%llx k=0x%llx\n",
+            sample, slot, pid, (unsigned long long)uniqueid, version,
+            (unsigned long long)registered, p->thread_count, p->captured,
+            (unsigned long long)p->begin, (unsigned long long)p->end,
+            (unsigned long long)p->user, (unsigned long long)p->system);
+    }
+    return n > 0 && n <= 255 && (unsigned int)n < bytes ? n : 0;
+}
+
+static inline int
+sweet_load_thread_format(char *line, unsigned int bytes, unsigned int sample,
+    unsigned int slot, unsigned int index, const struct sweet_load_thread *t)
+{
+    int n;
+    if (t->status != SWEET_LOAD_OK) {
+        n = snprintf(line, bytes,
+            "SWEET LOADT: v=1 s=%u g=%u j=%u th=0x%llx q=%u\n",
+            sample, slot, index, (unsigned long long)t->tid, t->status);
+    } else {
+        n = snprintf(line, bytes,
+            "SWEET LOADT: v=1 s=%u g=%u j=%u th=0x%llx q=0 st=0x%x h=0x%x "
+            "pr=%d bp=%d wr=%d b=0x%llx z=0x%llx u=0x%llx k=0x%llx\n",
+            sample, slot, index, (unsigned long long)t->tid, t->state, t->hint,
+            t->priority, t->base_priority, t->wait_result,
+            (unsigned long long)t->begin, (unsigned long long)t->end,
+            (unsigned long long)t->user, (unsigned long long)t->system);
+    }
+    return n > 0 && n <= 255 && (unsigned int)n < bytes ? n : 0;
+}
+#endif
diff --git a/bsd/dev/SweetUFSLoadPolicy.h b/bsd/dev/SweetUFSLoadPolicy.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/SweetUFSLoadPolicy.h
@@ -0,0 +1,77 @@
+/* Returned calls only; overlapping elapsed envelopes are not CPU/device time. */
+#ifndef SWEET_UFS_LOAD_POLICY_H
+#define SWEET_UFS_LOAD_POLICY_H
+#define SWEET_UFS_LOAD_GROUPS 5u
+#define SWEET_UFS_LOAD_LINE_BYTES 256u
+struct sweet_ufs_load_group {
+    uint64_t count, bytes, errors, valid, elapsed, maximum, bad_clock;
+    uint64_t wait, wait_maximum;
+};
+struct sweet_ufs_load_counters {
+    struct sweet_ufs_load_group groups[SWEET_UFS_LOAD_GROUPS];
+    uint32_t overflow;
+};
+
+static inline void
+sweet_ufs_load_add(uint64_t *value, uint64_t add, uint32_t *overflow)
+{
+    if (UINT64_MAX - *value < add) {
+        *value = UINT64_MAX;
+        *overflow = 1;
+    } else {
+        *value += add;
+    }
+}
+
+static inline unsigned int
+sweet_ufs_load_kind(uint8_t opcode)
+{
+    return opcode == 0x28 ? 0 : opcode == 0x2a ? 1 : opcode == 0x35 ? 2 : SWEET_UFS_LOAD_GROUPS;
+}
+
+static inline void
+sweet_ufs_load_record(struct sweet_ufs_load_counters *c, unsigned int kind,
+    uint64_t bytes, int error, uint64_t begin, uint64_t acquired, uint64_t end)
+{
+    if (kind >= SWEET_UFS_LOAD_GROUPS) return;
+    struct sweet_ufs_load_group *g = &c->groups[kind];
+    sweet_ufs_load_add(&g->count, 1, &c->overflow);
+    sweet_ufs_load_add(&g->bytes, bytes, &c->overflow);
+    if (error) sweet_ufs_load_add(&g->errors, 1, &c->overflow);
+    if (acquired < begin || end < acquired) {
+        sweet_ufs_load_add(&g->bad_clock, 1, &c->overflow);
+        return;
+    }
+    uint64_t elapsed = end - acquired, wait = acquired - begin;
+    sweet_ufs_load_add(&g->valid, 1, &c->overflow);
+    sweet_ufs_load_add(&g->elapsed, elapsed, &c->overflow);
+    sweet_ufs_load_add(&g->wait, wait, &c->overflow);
+    if (elapsed > g->maximum) g->maximum = elapsed;
+    if (wait > g->wait_maximum) g->wait_maximum = wait;
+}
+
+static inline int
+sweet_ufs_load_format(char *line, unsigned int bytes, unsigned int sample,
+    unsigned int kind, const struct sweet_ufs_load_group *g)
+{
+    int n;
+    if (kind < 3) {
+        n = snprintf(line, bytes,
+            "SWEET LOADIO: v=1 s=%u g=%u n=0x%llx b=0x%llx e=0x%llx vld=0x%llx "
+            "d=0x%llx m=0x%llx x=0x%llx\n", sample, kind,
+            (unsigned long long)g->count, (unsigned long long)g->bytes,
+            (unsigned long long)g->errors, (unsigned long long)g->valid,
+            (unsigned long long)g->elapsed, (unsigned long long)g->maximum,
+            (unsigned long long)g->bad_clock);
+    } else {
+        n = snprintf(line, bytes,
+            "SWEET LOADIO: v=1 s=%u g=%u n=0x%llx vld=0x%llx w=0x%llx wm=0x%llx "
+            "d=0x%llx m=0x%llx x=0x%llx\n", sample, kind,
+            (unsigned long long)g->count, (unsigned long long)g->valid,
+            (unsigned long long)g->wait, (unsigned long long)g->wait_maximum,
+            (unsigned long long)g->elapsed, (unsigned long long)g->maximum,
+            (unsigned long long)g->bad_clock);
+    }
+    return n > 0 && n <= 255 && (unsigned int)n < bytes ? n : 0;
+}
+#endif

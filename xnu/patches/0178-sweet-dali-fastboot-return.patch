+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * Adapted from HackIOS UniXNU-Dali DaliPsci.h, commit
+ * d5120d8305c00ff8fccffb6990c1435d9974e95a. Cold only; no RESET2/AEE fallback.
+ */
+#ifndef DALI_FASTBOOT_RETURN_SMC_H
+#define DALI_FASTBOOT_RETURN_SMC_H
+#include <stdint.h>
+static __attribute__((noinline)) uint32_t
+dali_fb_psci_cold(void)
+{
+    register uint64_t x0 __asm__("x0") = 0x84000009;
+    register uint64_t x1 __asm__("x1") = 0;
+    register uint64_t x2 __asm__("x2") = 0;
+    register uint64_t x3 __asm__("x3") = 0;
+    register uint64_t x4 __asm__("x4") = 0;
+    register uint64_t x5 __asm__("x5") = 0;
+    register uint64_t x6 __asm__("x6") = 0;
+    register uint64_t x7 __asm__("x7") = 0;
+    uint64_t daif;
+    __asm__ volatile("mrs %0, daif\n\tmsr daifset, #3\n\tdsb sy" : "=r"(daif) :: "memory");
+    __asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+        "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) : :
+        "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+    __asm__ volatile("msr daif, %0" :: "r"(daif) : "memory");
+    return (uint32_t)x0;
+}
+#endif

 /* A scalar token, not an object/frame pointer, crosses the possibly blocking VM call. */
 uint32_t
 sweet_bbvm_enter(struct arm_saved_state *state, uint32_t esr, uint64_t far,
     uint64_t address, uint32_t prot)
 {
     if (!OSCompareAndSwap(1, 1, &sweet_bbvm_admit) || state == NULL ||
         !is_saved_state64(state) || !PSR64_IS_USER64(get_saved_state_cpsr(state)))
         return 0;
     proc_t p = current_proc();
     if (p == PROC_NULL || !sweet_ff_target(3, p->p_comm))
         return 0;
     if (!OSCompareAndSwap(0, 1, &sweet_bbvm_guard)) {
         (void)OSCompareAndSwap(0, 1, &sweet_bbvm_begin_busy);
         return 0;
     }
     uint32_t token = 0;
     if (OSCompareAndSwap(1, 1, &sweet_bbvm_open) &&
         OSCompareAndSwap(1, 1, &sweet_bbvm_admit)) {
         struct sweet_bbvm_event event = {
             .pid = proc_pid(p), .tid = thread_tid(current_thread()),
             .pc = get_saved_state_pc(state), .lr = get_saved_state_lr(state),
             .sp = get_saved_state_sp(state), .cpsr = get_saved_state_cpsr(state),
             .esr = esr, .far = far, .address = address, .prot = prot,
             .start = mach_absolute_time(),
         };
         token = sweet_bbvm_enter_record(&sweet_bbvm_events, sweet_bbvm_interval, &event);
         if (sweet_bbvm_events.clock_stopped || sweet_bbvm_events.total >= SWEET_BBVM_LIMIT)
             (void)OSCompareAndSwap(1, 0, &sweet_bbvm_admit);
     }
     (void)OSCompareAndSwap(1, 0, &sweet_bbvm_guard);
     return token;
 }
 
 void
 sweet_bbvm_leave(uint32_t token, int32_t result)
 {
     if (token == 0 || token > SWEET_BBVM_LIMIT || !OSCompareAndSwap(1, 1, &sweet_bbvm_open))
         return;
     if (!OSCompareAndSwap(0, 1, &sweet_bbvm_guard)) {
         (void)OSCompareAndSwap(0, 1, &sweet_bbvm_end_busy);
         return;
     }
     if (OSCompareAndSwap(1, 1, &sweet_bbvm_open)) {
         (void)sweet_bbvm_leave_record(&sweet_bbvm_events, token,
             thread_tid(current_thread()), mach_absolute_time(), result);
         if (sweet_bbvm_events.clock_stopped)
             (void)OSCompareAndSwap(1, 0, &sweet_bbvm_admit);
     }
     (void)OSCompareAndSwap(1, 0, &sweet_bbvm_guard);
 }
 
 /* Only the existing normal sampler consumes/prints; no producer output or waiting. */
 static void
 sweet_bbvm_dump(unsigned int sample)
 {
     static struct sweet_bbvm_event snapshot[SWEET_BBVM_EXPORTS];
     _Static_assert(sizeof(sweet_bbvm_events) + sizeof(snapshot) +
         6 * sizeof(UInt32) + sizeof(sweet_bbvm_interval) <= 32768,
         "bounded BBVM persistent state and snapshot");
     if (!sweet_bbvm_is_configured())
         return;
     if (sample == 39) {
         (void)OSCompareAndSwap(1, 0, &sweet_bbvm_admit);
         (void)OSCompareAndSwap(1, 0, &sweet_bbvm_open);
     }
     if (!OSCompareAndSwap(0, 1, &sweet_bbvm_guard)) {
         printf("SWEET BBVM: sample=%u busy=1 final=%u; snapshot incomplete\n", sample, sample == 39);
         return;
     }
     uint32_t count = sweet_bbvm_snapshot(&sweet_bbvm_events, snapshot);
     uint32_t total = sweet_bbvm_events.total, completed = sweet_bbvm_events.completed;
     uint32_t entries = sweet_bbvm_events.exported_entry, returns = sweet_bbvm_events.exported_return;
     bool stopped = sweet_bbvm_events.clock_stopped;
     bool begin_busy = OSCompareAndSwap(1, 1, &sweet_bbvm_begin_busy);
     bool end_busy = OSCompareAndSwap(1, 1, &sweet_bbvm_end_busy);
     uint64_t snapshot_abs = mach_absolute_time();
     (void)OSCompareAndSwap(1, 0, &sweet_bbvm_guard);
     printf("SWEET BBVM: sample=%u count=%u accepted=%u completed=%u exported_entry=%u "
         "exported_return=%u begin_busy=%u end_busy=%u clock_stop=%u final=%u snapshot_abs=0x%llx\n",
         sample, count, total, completed, entries, returns, begin_busy, end_busy, stopped,
         sample == 39, (unsigned long long)snapshot_abs);
     for (uint32_t i = 0; i < count; ++i) {
         char line[SWEET_BBVM_LINE_BYTES];
         if (sweet_bbvm_format(line, sizeof(line), &snapshot[i]) != 0)
             printf("%s", line);
     }
 }
 

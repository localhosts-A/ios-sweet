 void publish() { __asm__ volatile("dsb oshst" ::: "memory"); }
 void consume() { __asm__ volatile("dmb oshld" ::: "memory"); }
+/* kIOMapInhibitCache may use Device memory on ARM64. Generic bzero uses
+ * DC ZVA and memcpy may issue unaligned/vector accesses: neither is valid
+ * for this mapping. Volatile byte accesses also cover odd USB lengths.
+ * Keep publication/consumption barriers at the ownership handoff sites.
+ */
+__attribute__((noinline)) void dmaZero(volatile void *destination, size_t length) {
+    auto *target = static_cast<volatile uint8_t *>(destination);
+    for (size_t n = 0; n < length; ++n) { target[n] = 0; }
+}
+__attribute__((noinline)) void dmaCopy(volatile void *destination,
+    const volatile void *source, size_t length) {
+    auto *target = static_cast<volatile uint8_t *>(destination);
+    auto *input = static_cast<const volatile uint8_t *>(source);
+    for (size_t n = 0; n < length; ++n) { target[n] = input[n]; }
+}
 uint16_t le16(const uint8_t *p) { return p[0] | (uint16_t(p[1]) << 8); }
 uint32_t le32(const uint8_t *p) { return le16(p) | (uint32_t(le16(p + 2)) << 16); }
 uint64_t le64(const uint8_t *p) { return le32(p) | (uint64_t(le32(p + 4)) << 32); }

+/* Ordinary sampler only; read existing counters, never add IRQ-path work.
+ * Separate processor_info queries are not a coherent scheduler snapshot.
+ * An IPI count includes self-SGI and is not proof of a particular sender.
+ */
+void
+SweetCPU::dumpActivity(unsigned int sample)
+{
+	if (sample >= 40 || sample % 10 != 0) return;
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	if (topology->num_cpus == 0 || topology->num_cpus > SWEET_SMP_MAX_CPUS) return;
+	SweetCPU *boot = __atomic_load_n(&sweet_cpus[0], __ATOMIC_ACQUIRE);
+	if (boot == NULL || !boot->daliCPU) return;
+	for (unsigned int i = 0; i < topology->num_cpus; ++i) {
+		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
+		if (cpu == NULL || !__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE)) {
+			IOLog("DALI CPUACT: v=1 s=%u cpu=%u ready=0\n", sample, i);
+			continue;
+		}
+		host_t host = HOST_NULL;
+		processor_basic_info_data_t basic = {};
+		processor_cpu_load_info_data_t load = {};
+		processor_cpu_stat64_data_t stat = {};
+		mach_msg_type_number_t count = PROCESSOR_BASIC_INFO_COUNT;
+		kern_return_t a = processor_info(cpu->machProcessor, PROCESSOR_BASIC_INFO, &host,
+		    reinterpret_cast<processor_info_t>(&basic), &count);
+		count = PROCESSOR_CPU_LOAD_INFO_COUNT;
+		kern_return_t b = processor_info(cpu->machProcessor, PROCESSOR_CPU_LOAD_INFO, &host,
+		    reinterpret_cast<processor_info_t>(&load), &count);
+		count = PROCESSOR_CPU_STAT64_COUNT;
+		kern_return_t c = processor_info(cpu->machProcessor, PROCESSOR_CPU_STAT64, &host,
+		    reinterpret_cast<processor_info_t>(&stat), &count);
+		if (a != KERN_SUCCESS || b != KERN_SUCCESS || c != KERN_SUCCESS) {
+			IOLog("DALI CPUACT: v=1 s=%u cpu=%u query=%d,%d,%d\n", sample, i, a, b, c);
+			continue;
+		}
+		IOLog("DALI CPUACT: v=1 s=%u cpu=%u run=%u user=%u sys=%u idle=%u irq=%llu ipi=%llu timer=%llu\n",
+		    sample, i, (unsigned int)basic.running, load.cpu_ticks[CPU_STATE_USER],
+		    load.cpu_ticks[CPU_STATE_SYSTEM], load.cpu_ticks[CPU_STATE_IDLE],
+		    (unsigned long long)stat.irq_ex_cnt, (unsigned long long)stat.ipi_cnt,
+		    (unsigned long long)stat.timer_cnt);
+	}
+}
+
+extern "C" void
+sweet_cpu_activity_dump(unsigned int sample)
+{
+	SweetCPU::dumpActivity(sample);
+}

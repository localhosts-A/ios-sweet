@@ -0,0 +1,63 @@
+/* Optional one-shot read-only MT6991 SPI6 handoff observation.
+ * Addresses from live Dali DT; register layout from MiCode MT6991 e45c319.
+ * This does not identify ownership, power state, touch controller or input.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+#include "DaliTouchHandoff.h"
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+
+namespace {
+struct ReadMaps {
+    IOMemoryDescriptor *memory[4] = {};
+    IOMemoryMap *mapping[4] = {};
+    static bool open(void *p, unsigned int index, unsigned long long address) {
+        ReadMaps *self = static_cast<ReadMaps *>(p);
+        self->memory[index] = IOMemoryDescriptor::withPhysicalAddress(address,
+            index == 2 ? 0x3000 : 0x1000, kIODirectionIn);
+        if (self->memory[index])
+            self->mapping[index] = self->memory[index]->map(kIOMapInhibitCache | kIOMapReadOnly);
+        if (self->mapping[index] && self->mapping[index]->getVirtualAddress()) return true;
+        OSSafeReleaseNULL(self->mapping[index]);
+        OSSafeReleaseNULL(self->memory[index]);
+        return false;
+    }
+    static bool read(void *p, unsigned int index, unsigned int offset, unsigned int *value) {
+        ReadMaps *self = static_cast<ReadMaps *>(p);
+        *value = *reinterpret_cast<volatile unsigned int *>(self->mapping[index]->getVirtualAddress() + offset);
+        __asm__ volatile("dmb oshld" ::: "memory");
+        return true;
+    }
+    static void close(void *p, unsigned int index) {
+        ReadMaps *self = static_cast<ReadMaps *>(p);
+        OSSafeReleaseNULL(self->mapping[index]);
+        OSSafeReleaseNULL(self->memory[index]);
+    }
+};
+}
+
+void dali_touch_handoff_observe(IORegistryEntry *root)
+{
+    if (!root) return;
+    OSData *compatible = OSDynamicCast(OSData, root->getProperty("compatible"));
+    OSData *enabled = OSDynamicCast(OSData, root->getProperty("dali-touch-handoff"));
+    if (!compatible || !enabled) return;
+    ReadMaps maps;
+    DaliTouchIO io = {&maps, ReadMaps::open, ReadMaps::read, ReadMaps::close};
+    DaliTouchSnapshot s = {};
+    int rc = dali_touch_handoff(compatible->getBytesNoCopy(), compatible->getLength(),
+        enabled->getBytesNoCopy(), enabled->getLength(), &io, &s);
+    if (rc < 0) {
+        kprintf("DALI TOUCH HANDOFF: mapping/read failed\n");
+    } else if (rc > 0) {
+        kprintf("DALI TOUCH HANDOFF: pin81-84=%x,%x,%x,%x parent=%x vote=%u done=%u fence=%u gate-vote=%u done=%u gated=%u; ownership and touch unknown\n",
+            (s.gpio >> 4) & 15, (s.gpio >> 8) & 15, (s.gpio >> 12) & 15, (s.gpio >> 16) & 15,
+            (s.mux >> 16) & 7, (s.parentVote >> 23) & 1, (s.parentDone >> 23) & 1,
+            (s.fence >> 29) & 1, (s.gateVote >> 7) & 1, (s.gateDone >> 7) & 1,
+            (s.gateStatus >> 7) & 1);
+    }
+}
+#endif

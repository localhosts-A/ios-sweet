 	const uint64_t block_size = ARM_TT_L2_SIZE;
@@ -1862,6 +1926,7 @@
 		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
 	}
+	*dali_io_alias = sweet_early_map_dali_io(args);
 	__asm__ volatile("dsb ishst" ::: "memory");
 	return va + (fb_pa - map_start);
 }
@@ -1881,6 +1946,7 @@
 	vm_map_address_t dynamic_memory_begin;
 #if defined(SWEET)
 	vm_map_address_t sweet_early_fb_alias;
+	vm_map_address_t sweet_early_dali_io_alias;
 #endif
 
 	/*
@@ -2200,7 +2266,7 @@
 
 #if defined(SWEET)
 	/* phystokv() must still refer to the bootstrap aperture here. */
-	sweet_early_fb_alias = sweet_early_map_final(args);
+	sweet_early_fb_alias = sweet_early_map_final(args, &sweet_early_dali_io_alias);
 #endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
@@ -2209,7 +2275,7 @@
 
 #if defined(SWEET)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(sweet_early_fb_alias);
+	sweet_early_relocate(sweet_early_fb_alias, sweet_early_dali_io_alias);
 #endif

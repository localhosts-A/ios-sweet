diff --git a/iokit/Kernel/arm/DaliPMIF.h b/iokit/Kernel/arm/DaliPMIF.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/DaliPMIF.h
@@ -0,0 +1,14 @@
+#ifndef _DALI_PMIF_H
+#define _DALI_PMIF_H
+#include <stdint.h>
+
+/* Built-in platform clients only; process/thread context with IRQs enabled.
+ * Each byte transaction owns AP SW channel2 through completion/valid-clear.
+ * Caller locks still protect multi-register operations on each peripheral.
+ */
+bool dali_pmif_init(uint64_t address, uint64_t size);
+bool dali_pmif_transfer(uint8_t sid, uint16_t address, uint8_t *value,
+    bool write, uint32_t *status);
+bool dali_pmif_read16(uint8_t sid, uint16_t address, uint16_t *value,
+    uint32_t *status);
+#endif
diff --git a/iokit/Kernel/arm/DaliPMIF.cpp b/iokit/Kernel/arm/DaliPMIF.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/DaliPMIF.cpp
@@ -0,0 +1,144 @@
+/* Dali main PMIF/SPMI, AP software channel2. Protocol from vendor
+ * spmi-mtk-pmif-core.c, e45c3199537fbba9aae5fb06c31fc8dbd3c1dcee.
+ * Share the channel between RTC and USB clients. Adopt firmware setup;
+ * never program PMIF arbitration, clocks, reset or error-recovery controls.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+#include "DaliPMIF.h"
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <machine/machine_routines.h>
+
+namespace {
+constexpr uint32_t kAcc = 0x880, kWData = 0x884, kRData = 0x894;
+constexpr uint32_t kValidClear = 0x8a4, kStatus = 0x8a8;
+IOLock *busLock;
+IOMemoryDescriptor *busMemory;
+IOMemoryMap *busMap;
+vm_offset_t busIO;
+bool busFault;
+
+bool threadContext()
+{
+    return ml_get_interrupts_enabled() && !ml_at_interrupt_context();
+}
+
+uint32_t load(uint32_t offset)
+{
+    uint32_t value = *(volatile uint32_t *)(busIO + offset);
+    __asm__ volatile("dmb oshld" ::: "memory");
+    return value;
+}
+
+void store(uint32_t offset, uint32_t value)
+{
+    *(volatile uint32_t *)(busIO + offset) = value;
+    __asm__ volatile("dsb sy" ::: "memory");
+}
+
+bool waitState(unsigned state, uint32_t *status)
+{
+    /* Same 100ms bound as the hardware-proven RTC implementation. */
+    for (unsigned i = 0; i < 10000; ++i) {
+        *status = load(kStatus);
+        if (((*status >> 1) & 7) == state) { return true; }
+        IODelay(10);
+    }
+    busFault = true; /* A stuck channel must not be reused by another client. */
+    return false;
+}
+
+bool transferLocked(uint8_t sid, uint16_t address, uint8_t *value,
+    bool write, uint32_t *status)
+{
+    if (busFault || !waitState(0, status)) { return false; }
+    if (write) { store(kWData, *value); }
+    store(kAcc, (3U << 30) | (write ? 1U << 29 : 0) |
+        ((uint32_t)sid << 24) | address);
+    IODelay(1);
+    if (!waitState(write ? 0 : 6, status)) { return false; }
+    bool ok = !(*status & (1U << 18));
+    if (!write) {
+        if (ok) { *value = load(kRData) & 0xff; }
+        store(kValidClear, 1);
+        ok = waitState(0, status) && ok;
+    }
+    return ok;
+}
+}
+
+bool dali_pmif_init(uint64_t address, uint64_t size)
+{
+    if (address != 0x1c01a000 || size != 0x900 || !threadContext()) {
+        return false;
+    }
+    IOLock *lock = __atomic_load_n(&busLock, __ATOMIC_ACQUIRE);
+    if (!lock) {
+        IOLock *candidate = IOLockAlloc();
+        if (!candidate) { return false; }
+        IOLock *expected = nullptr;
+        if (!__atomic_compare_exchange_n(&busLock, &expected, candidate,
+                false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+            IOLockFree(candidate);
+            lock = expected;
+        } else {
+            lock = candidate;
+        }
+    }
+    IOLockLock(lock);
+    if (!busIO) {
+        IOMemoryDescriptor *memory = IOMemoryDescriptor::withPhysicalAddress(
+            address, size, kIODirectionInOut);
+        IOMemoryMap *mapping = memory ? memory->map(kIOMapInhibitCache) : nullptr;
+        if (mapping) {
+            vm_offset_t io = mapping->getVirtualAddress();
+            if (*(volatile uint32_t *)io & 1U) {
+                busMemory = memory;
+                busMap = mapping;
+                busIO = io;
+                kprintf("DALI PMIF: shared SID9/SID14 channel2 mapped\n");
+            } else {
+                mapping->release();
+                memory->release();
+            }
+        } else if (memory) {
+            memory->release();
+        }
+    }
+    bool ok = busIO != 0 && !busFault;
+    IOLockUnlock(lock);
+    /* The map/lock stay owned by permanent built-in platform clients. */
+    return ok;
+}
+
+bool dali_pmif_transfer(uint8_t sid, uint16_t address, uint8_t *value,
+    bool write, uint32_t *status)
+{
+    if (!value || !status || !threadContext() || (sid != 9 && sid != 14)) {
+        return false;
+    }
+    IOLock *lock = __atomic_load_n(&busLock, __ATOMIC_ACQUIRE);
+    if (!lock) { return false; }
+    IOLockLock(lock);
+    bool ok = busIO && transferLocked(sid, address, value, write, status);
+    IOLockUnlock(lock);
+    return ok;
+}
+
+bool dali_pmif_read16(uint8_t sid, uint16_t address, uint16_t *value,
+    uint32_t *status)
+{
+    if (!value || !status || address == 0xffff || !threadContext() ||
+        (sid != 9 && sid != 14)) { return false; }
+    IOLock *lock = __atomic_load_n(&busLock, __ATOMIC_ACQUIRE);
+    if (!lock) { return false; }
+    IOLockLock(lock);
+    uint8_t lo = 0, hi = 0;
+    bool ok = busIO && transferLocked(sid, address, &lo, false, status) &&
+        transferLocked(sid, address + 1, &hi, false, status);
+    if (ok) { *value = lo | ((uint16_t)hi << 8); }
+    IOLockUnlock(lock);
+    return ok;
+}
+#endif
diff --git a/iokit/Kernel/arm/DaliUSBPMIC.cpp b/iokit/Kernel/arm/DaliUSBPMIC.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/DaliUSBPMIC.cpp
@@ -0,0 +1,122 @@
+/* First Dali native USB platform stage: observe the firmware handoff via
+ * the shared PMIF channel. Opt-in, bounded, peripheral-register read-only.
+ * MT6379 tcpc_mt6379.c maps standard TCPCI00xx registers to PMIC04xx.
+ * This service does NOT switch roles, source VBUS or start an xHCI DMA engine.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(SWEET)
+#include "DaliPMIF.h"
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <libkern/c++/OSData.h>
+#include <pexpert/pexpert.h>
+
+class DaliUSBPMIC : public IOService {
+    OSDeclareDefaultStructors(DaliUSBPMIC);
+    IOWorkLoop *workLoop = nullptr;
+    IOTimerEventSource *timer = nullptr;
+    unsigned samples = 0, failures = 0;
+    uint32_t lastStatus = 0;
+    uint16_t lastAddress = 0;
+    uint8_t previous[6] = {};
+    bool havePrevious = false;
+
+    bool read8(uint16_t address, uint8_t *value) {
+        lastAddress = address;
+        return dali_pmif_transfer(14, address, value, false, &lastStatus);
+    }
+    bool read16(uint16_t address, uint16_t *value) {
+        lastAddress = address;
+        return dali_pmif_read16(14, address, value, &lastStatus);
+    }
+    void poll() {
+        /* ROLE_CTRL, CC_STATUS, POWER_STATUS, charger OTG enable and
+         * repeater VRT/disconnect/squelch configuration. No alert clearing.
+         */
+        static const uint16_t registers[] = {0x41a, 0x41d, 0x41e, 0x108, 0xd10, 0xd18};
+        uint8_t values[6] = {};
+        bool ok = true;
+        for (unsigned i = 0; i < 6 && ok; ++i) { ok = read8(registers[i], &values[i]); }
+        ++samples;
+        if (!ok) {
+            ++failures;
+            kprintf("DALI USB PMIC: read failed reg=0x%x status=0x%x count=%u\n",
+                lastAddress, lastStatus, failures);
+        } else {
+            failures = 0;
+            if (!havePrevious || memcmp(values, previous, sizeof(values)) || samples % 10 == 0) {
+                kprintf("DALI USB PMIC: t=%u role=%02x cc=%02x power=%02x otg=%02x vrt=%02x rx=%02x\n",
+                    samples, values[0], values[1], values[2], values[3], values[4], values[5]);
+                memcpy(previous, values, sizeof(values));
+                havePrevious = true;
+            }
+        }
+        if (samples < 90 && failures < 3) {
+            timer->setTimeoutMS(1000);
+        } else {
+            kprintf("DALI USB PMIC: bounded read-only capture ended\n");
+        }
+    }
+    static void timerAction(OSObject *owner, IOTimerEventSource *) {
+        static_cast<DaliUSBPMIC *>(owner)->poll();
+    }
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+    void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+    void free() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(DaliUSBPMIC, IOService);
+
+bool DaliUSBPMIC::start(IOService *provider)
+{
+    int enabled = 0;
+    PE_parse_boot_argn("daliusb", &enabled, sizeof(enabled));
+    if (enabled != 1) { return false; }
+    OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+    uint64_t range[2] = {};
+    if (!reg || reg->getLength() != sizeof(range)) { return false; }
+    memcpy(range, reg->getBytesNoCopy(), sizeof(range));
+    if (range[0] != 0x1c01a000 || range[1] != 0x900 || !IOService::start(provider) ||
+        !dali_pmif_init(range[0], range[1])) { return false; }
+    uint16_t vid = 0, pid = 0;
+    if (!read16(0x400, &vid) || !read16(0x402, &pid) || vid != 0x29cf || pid != 0x6379) {
+        kprintf("DALI USB PMIC: TCPC identity rejected vid=%04x pid=%04x status=%x\n",
+            vid, pid, lastStatus);
+        return false;
+    }
+    workLoop = IOWorkLoop::workLoop();
+    timer = IOTimerEventSource::timerEventSource(this, timerAction);
+    if (!workLoop || !timer || workLoop->addEventSource(timer) != kIOReturnSuccess) {
+        return false;
+    }
+    kprintf("DALI USB PMIC: MT6379 TCPC verified; bounded read-only mode\n");
+    setProperty("diagnostic-only", true);
+    setProperty("programs-vbus", false);
+    registerService();
+    timer->setTimeoutMS(1000);
+    return true;
+}
+
+void DaliUSBPMIC::stop(IOService *provider)
+{
+    if (timer) { timer->cancelTimeout(); timer->disable(); }
+    if (workLoop && timer && timer->getWorkLoop() == workLoop) {
+        workLoop->removeEventSource(timer);
+    }
+    IOService::stop(provider);
+}
+
+void DaliUSBPMIC::free()
+{
+    if (timer) { timer->cancelTimeout(); timer->disable(); }
+    if (workLoop && timer && timer->getWorkLoop() == workLoop) {
+        workLoop->removeEventSource(timer);
+    }
+    OSSafeReleaseNULL(timer);
+    OSSafeReleaseNULL(workLoop);
+    IOService::free();
+}
+#endif

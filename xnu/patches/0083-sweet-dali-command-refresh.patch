diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1828,9 +1828,73 @@
 #if defined(SWEET)
 /* The reserved low-globals/kernel region is excluded from VM allocation. */
 #define SWEET_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+#define SWEET_EARLY_DALI_IO_VA (VM_MIN_KERNEL_ADDRESS + 3 * ARM_TT_L2_SIZE)
 
 static vm_map_address_t
-sweet_early_map_final(boot_args *args)
+sweet_early_map_dali_io(boot_args *args)
+{
+	/* The command-mode panel and its live pipeline are specific to Dali. */
+	if (args->Video.v_width != 1280 || args->Video.v_height != 2772 ||
+	    args->Video.v_depth != 32 || args->Video.v_baseAddr < 0xfc990000ULL ||
+	    args->Video.v_baseAddr >= 0xff000000ULL) {
+		return 0;
+	}
+	const vm_map_address_t va = SWEET_EARLY_DALI_IO_VA;
+	if ((va & ~ARM_TT_L1_OFFMASK) !=
+	    (SWEET_EARLY_FB_VA & ~ARM_TT_L1_OFFMASK) ||
+	    va < SWEET_EARLY_FB_VA + 2 * ARM_TT_L2_SIZE ||
+	    va + ARM_TT_L2_SIZE < va || va + ARM_TT_L2_SIZE > gVirtBase) {
+		return 0;
+	}
+	tt_entry_t *l2_entry = arm_kva_to_tte(va);
+	if (*l2_entry == ARM_TTE_EMPTY) {
+		pt_entry_t *new_l3 = (pt_entry_t *)alloc_ptpage(TRUE);
+		bzero(new_l3, ARM_PGBYTES);
+		*l2_entry = (kvtophys((vm_offset_t)new_l3) & ARM_TTE_TABLE_MASK) |
+		    ARM_TTE_TYPE_TABLE | ARM_TTE_VALID |
+		    ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN;
+	} else if ((*l2_entry & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) !=
+	    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+		return 0;
+	}
+	pt_entry_t *l3 = (pt_entry_t *)phystokv(*l2_entry & ARM_TTE_TABLE_MASK);
+	uint64_t io_pages[29] = {
+		0x32000000ULL, 0x32020000ULL, 0x32420000ULL, 0x32490000ULL,
+		0x32400000ULL, 0x32800000ULL, 0x32820000ULL, 0x32c00000ULL,
+		0x32c20000ULL,
+	};
+	unsigned int io_page_count = 9;
+	for (unsigned int bank = 0; bank < 2; bank++) {
+		uint64_t config = bank ? 0x32c00000ULL : 0x32800000ULL;
+		for (unsigned int id = 0; id < 10; id++) {
+			io_pages[io_page_count++] = config + 0x30000ULL + id * 0x10000ULL;
+		}
+	}
+	for (unsigned int i = 0; i < io_page_count; i++) {
+		uint64_t pa = io_pages[i];
+		vm_map_address_t page_va = va + (pa - 0x32000000ULL);
+		if (page_va + PAGE_SIZE < page_va || page_va + PAGE_SIZE > gVirtBase ||
+		    (page_va & PAGE_MASK) || (pa & PAGE_MASK)) {
+			return 0;
+		}
+		pt_entry_t *pte = &l3[L3_TABLE_INDEX(page_va)];
+		if (*pte != ARM_PTE_EMPTY) {
+			return 0;
+		}
+	}
+	for (unsigned int i = 0; i < io_page_count; i++) {
+		uint64_t pa = io_pages[i];
+		vm_map_address_t page_va = va + (pa - 0x32000000ULL);
+		l3[L3_TABLE_INDEX(page_va)] = (pa & ARM_PTE_PAGE_MASK) |
+		    ARM_PTE_TYPE_VALID | ARM_PTE_AF | ARM_PTE_AP(AP_RWNA) |
+		    ARM_PTE_SH(SH_NONE) | ARM_PTE_ATTRINDX(CACHE_ATTRINDX_DISABLE) |
+		    ARM_PTE_PNX | ARM_PTE_NX;
+	}
+	return va;
+}
+
+static vm_map_address_t
+sweet_early_map_final(boot_args *args, vm_map_address_t *dali_io_alias)
 {

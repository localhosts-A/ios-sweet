diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1086,21 +1086,33 @@
 	bsd_init_kprintf("done\n");
 }
 
+#if DEVELOPMENT && defined(ARM64_BOARD_CONFIG_SWEET)
+extern uint64_t sweet_boot_counter_ms(void);
+#define SWEET_INIT_LOG(fmt, ...) kprintf("T%llums init: " fmt, sweet_boot_counter_ms(), ## __VA_ARGS__)
+#else
+#define SWEET_INIT_LOG(fmt, ...) do { } while (0)
+#endif
+
 void
 bsdinit_task(void)
 {
 	proc_t p = current_proc();
 
+	SWEET_INIT_LOG("bsdinit_task entry\n");
 	process_name("init", p);
 
 	/* Set up exception-to-signal reflection */
+	SWEET_INIT_LOG("ux_handler_setup begin\n");
 	ux_handler_setup();
+	SWEET_INIT_LOG("ux_handler_setup returned\n");
 
 #if CONFIG_MACF
 	mac_cred_label_associate_user(proc_ucred(p));
 #endif
 
+	SWEET_INIT_LOG("vm_init_before_launchd begin\n");
 	vm_init_before_launchd();
+	SWEET_INIT_LOG("vm_init_before_launchd returned\n");
 
 #if CONFIG_XNUPOST
 	int result = bsd_list_tests();
@@ -1112,7 +1124,9 @@
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+	SWEET_INIT_LOG("load_init_program begin\n");
 	load_init_program(p);
+	SWEET_INIT_LOG("load_init_program returned\n");
 	lock_trace = 1;
 }
 
@@ -1186,7 +1200,9 @@
 	 * Clone the bootstrap process from the kernel process, without
 	 * inheriting either task characteristics or memory from the kernel;
 	 */
+	SWEET_INIT_LOG("cloneproc begin\n");
 	thread = cloneproc(TASK_NULL, NULL, kernproc, CLONEPROC_FLAGS_MEMSTAT_INTERNAL);
+	SWEET_INIT_LOG("cloneproc returned\n");
 
 	/* Hold the reference as it will be dropped during shutdown */
 	initproc = proc_find(1);
@@ -1208,10 +1224,12 @@
 	ut = (struct uthread *)get_bsdthread_info(thread);
 	ut->uu_sigmask = 0;
 	act_set_astbsd(thread);
+	SWEET_INIT_LOG("initproc created; ASTBSD set\n");
 
 	ipc_task_enable(get_threadtask(thread));
 
 	task_clear_return_wait(get_threadtask(thread), TCRW_CLEAR_ALL_WAIT);
+	SWEET_INIT_LOG("initproc return wait cleared\n");
 }
 

+/* Read-only BSD disk bridge for the directly attached Dali USB BOT medium.
+ * The exposed disk is one content-validated HFS/HFSX partition, never the
+ * phone's UFS. Geometry is fixed at512 logical bytes. No write passthrough.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/buf.h>
+#include <sys/disk.h>
+#include <sys/fcntl.h>
+#include <sys/stat.h>
+#include <sys/uio.h>
+#include <sys/malloc.h>
+#include <sys/dali_usb_disk.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/kalloc.h>
+
+static LCK_GRP_DECLARE(du_group, "dali_usb_disk");
+static LCK_MTX_DECLARE(du_lock, &du_group);
+static void *du_context;
+static dali_usb_read_fn du_read;
+static uint64_t du_first, du_bytes;
+static int du_major = -1, du_cmajor = -1;
+static void *du_node, *du_raw;
+
+static int du_open(dev_t dev, int flags, int type, struct proc *p) {
+    (void)type; (void)p;
+    if (minor(dev) || (flags & FWRITE)) { return (flags & FWRITE) ? EROFS : ENXIO; }
+    lck_mtx_lock(&du_lock); int error = du_context && du_read ? 0 : ENXIO;
+    lck_mtx_unlock(&du_lock); return error;
+}
+static int du_close(dev_t dev, int flags, int type, struct proc *p) {
+    (void)dev; (void)flags; (void)type; (void)p; return 0;
+}
+static void du_strategy(struct buf *bp) {
+    uint64_t offset; int error = 0; caddr_t address = NULL;
+    buf_setresid(bp, buf_count(bp));
+    if (minor(buf_device(bp)) || buf_blkno(bp) < 0) { error = ENXIO; goto done; }
+    if (!(buf_flags(bp) & B_READ)) { error = EROFS; goto done; }
+    if ((uint64_t)buf_blkno(bp) > UINT64_MAX / DEV_BSIZE) { error = EINVAL; goto done; }
+    offset = (uint64_t)buf_blkno(bp) * DEV_BSIZE;
+    if (buf_map(bp, &address)) { error = EIO; goto done; }
+    lck_mtx_lock(&du_lock);
+    if (!du_context || !du_read) { error = ENXIO; }
+    else if (offset > du_bytes || buf_count(bp) > du_bytes - offset) { error = EINVAL; }
+    else if (buf_count(bp)) { error = du_read(du_context, du_first + offset, buf_count(bp), address); }
+    lck_mtx_unlock(&du_lock);
+    buf_unmap(bp);
+    if (!error) { buf_setresid(bp, 0); }
+done:
+    if (error) { buf_seterror(bp, error); }
+    buf_biodone(bp);
+}
+static int du_ioctl(dev_t dev, u_long command, caddr_t data, int flag, struct proc *p) {
+    (void)flag; (void)p;
+    if (minor(dev)) { return ENXIO; }
+    int error = 0;
+    lck_mtx_lock(&du_lock);
+    if (!du_context) { error = ENXIO; goto done; }
+    switch (command) {
+    case DKIOCGETBLOCKSIZE: case DKIOCGETPHYSICALBLOCKSIZE:
+        *(uint32_t *)data = DEV_BSIZE; break;
+    case DKIOCSETBLOCKSIZE:
+        error = *(uint32_t *)data == DEV_BSIZE ? 0 : EINVAL; break;
+    case DKIOCGETBLOCKCOUNT: *(uint64_t *)data = du_bytes / DEV_BSIZE; break;
+    case DKIOCGETBASE: *(uint64_t *)data = 0; break;
+    case DKIOCISWRITABLE: case DKIOCGETFEATURES: *(uint32_t *)data = 0; break;
+    case DKIOCISFORMATTED: *(uint32_t *)data = 1; break;
+    case DKIOCGETMAXBYTECOUNTREAD: *(uint64_t *)data = 65536; break;
+    case DKIOCGETMAXBLOCKCOUNTREAD: *(uint64_t *)data = 128; break;
+    case DKIOCGETMAXSEGMENTCOUNTREAD: *(uint64_t *)data = 1; break;
+    case DKIOCSYNCHRONIZECACHE: case DKIOCSYNCHRONIZE: break;
+    default: error = ENOTTY; break;
+    }
+done:
+    lck_mtx_unlock(&du_lock); return error;
+}
+static int du_size(dev_t dev) {
+    if (minor(dev)) { return -1; }
+    lck_mtx_lock(&du_lock);
+    uint64_t count = du_context ? du_bytes / DEV_BSIZE : 0;
+    lck_mtx_unlock(&du_lock);
+    return count > INT_MAX ? INT_MAX : (int)count;
+}
+static int du_raw_read(dev_t dev, struct uio *uio, int flags) {
+    (void)flags;
+    if (minor(dev) || uio_offset(uio) < 0 || uio_resid(uio) < 0) { return EINVAL; }
+    uint8_t *buffer = NULL; int error = 0;
+    buffer = kalloc_data(4096, Z_WAITOK);
+    if (!buffer) { return ENOMEM; }
+    while (uio_resid(uio)) {
+        uint64_t offset = (uint64_t)uio_offset(uio);
+        size_t amount = uio_resid(uio) > 4096 ? 4096 : (size_t)uio_resid(uio);
+        lck_mtx_lock(&du_lock);
+        if (!du_context || !du_read) { error = ENXIO; }
+        else if (offset > du_bytes) { error = EINVAL; }
+        else {
+            if (amount > du_bytes - offset) { amount = (size_t)(du_bytes - offset); }
+            if (amount) { error = du_read(du_context, du_first + offset, amount, buffer); }
+        }
+        lck_mtx_unlock(&du_lock);
+        if (error || !amount) { break; }
+        error = uiomove((caddr_t)buffer, (int)amount, uio);
+        if (error) { break; }
+    }
+    kfree_data(buffer, 4096); return error;
+}
+static int du_raw_write(dev_t dev, struct uio *uio, int flags) {
+    (void)dev; (void)uio; (void)flags; return EROFS;
+}
+static const struct bdevsw du_bdev = {
+    .d_open = du_open, .d_close = du_close, .d_strategy = du_strategy,
+    .d_ioctl = du_ioctl, .d_dump = eno_dump, .d_psize = du_size, .d_type = D_DISK
+};
+static const struct cdevsw du_cdev = {
+    .d_open = du_open, .d_close = du_close, .d_read = du_raw_read, .d_write = du_raw_write,
+    .d_ioctl = du_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL,
+    .d_select = eno_select, .d_mmap = eno_mmap, .d_strategy = eno_strat,
+    .d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = D_DISK
+};
+int dali_usb_disk_supply(void *context, dali_usb_read_fn read, uint64_t first, uint64_t bytes) {
+    if (!context || !read || !bytes || (first % DEV_BSIZE) || (bytes % DEV_BSIZE) || first > UINT64_MAX - bytes) { return EINVAL; }
+    lck_mtx_lock(&du_lock);
+    int error = du_context ? EBUSY : 0;
+    if (!error) { du_context = context; du_read = read; du_first = first; du_bytes = bytes; }
+    lck_mtx_unlock(&du_lock); return error;
+}
+void dali_usb_disk_detach(void *context) {
+    lck_mtx_lock(&du_lock);
+    if (du_context == context) { du_context = NULL; du_read = NULL; }
+    lck_mtx_unlock(&du_lock);
+}
+dev_t dali_usb_disk_root(void) {
+    dev_t result = NODEV;
+    lck_mtx_lock(&du_lock);
+    if (!du_context || !du_read) { goto done; }
+    if (du_major < 0) { du_major = bdevsw_add(-1, &du_bdev); }
+    if (du_major < 0) { goto done; }
+    if (du_cmajor < 0) { du_cmajor = cdevsw_add_with_bdev(-1, &du_cdev, du_major); }
+    if (du_cmajor < 0) { goto done; }
+    if (!du_node) { du_node = devfs_make_node(makedev(du_major, 0), DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0440, "du0"); }
+    if (!du_raw) { du_raw = devfs_make_node(makedev(du_cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0440, "rdu0"); }
+    if (du_node && du_raw) { result = makedev(du_major, 0); }
+done:
+    lck_mtx_unlock(&du_lock); return result;
+}

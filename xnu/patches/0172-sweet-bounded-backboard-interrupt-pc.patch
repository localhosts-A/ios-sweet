diff --git a/bsd/dev/SweetBackboardPCPolicy.h b/bsd/dev/SweetBackboardPCPolicy.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/SweetBackboardPCPolicy.h
@@ -0,0 +1,59 @@
+/* Independent fixed boot-lifetime budget for actual timer-IRQ user PCs. */
+#ifndef SWEET_BACKBOARD_PC_POLICY_H
+#define SWEET_BACKBOARD_PC_POLICY_H
+
+#define SWEET_BBPC_LIMIT 40u
+#define SWEET_BBPC_INTERVAL_NS (30ULL * 1000000000ULL)
+struct sweet_bbpc_event {
+    uint32_t seq, cpu, cpsr;
+    int32_t pid;
+    uint64_t tid, pc, lr, sp, abstime;
+};
+struct sweet_bbpc_buffer {
+    uint32_t total, dumped;
+    bool has_last, clock_stopped;
+    uint64_t last;
+    struct sweet_bbpc_event events[SWEET_BBPC_LIMIT];
+};
+
+static inline uint64_t
+sweet_bbpc_ceil_ticks(uint64_t ticks, uint64_t ns)
+{
+    if (ticks == 0 || ticks == UINT64_MAX)
+        return 0;
+    return ns < SWEET_BBPC_INTERVAL_NS ? ticks + 1 : ticks;
+}
+
+/* Caller holds its independent nonblocking guard; failed admission costs no quota. */
+static inline bool
+sweet_bbpc_record(struct sweet_bbpc_buffer *buffer, uint64_t interval,
+    const struct sweet_bbpc_event *event)
+{
+    if (interval == 0 || buffer->clock_stopped || buffer->total >= SWEET_BBPC_LIMIT)
+        return false;
+    if (buffer->has_last) {
+        if (event->abstime < buffer->last) {
+            buffer->clock_stopped = true;
+            return false;
+        }
+        if (event->abstime - buffer->last < interval)
+            return false;
+    }
+    buffer->events[buffer->total] = *event;
+    buffer->events[buffer->total].seq = buffer->total + 1;
+    ++buffer->total;
+    buffer->last = event->abstime;
+    buffer->has_last = true;
+    return true;
+}
+
+static inline uint32_t
+sweet_bbpc_snapshot(struct sweet_bbpc_buffer *buffer, struct sweet_bbpc_event *out)
+{
+    uint32_t count = buffer->total - buffer->dumped;
+    for (uint32_t i = 0; i < count; ++i)
+        out[i] = buffer->events[buffer->dumped + i];
+    buffer->dumped = buffer->total;
+    return count;
+}
+#endif
